@page "/guest-profiles"
@using LodgeStay.Models
@using LodgeStay.Services
@using LodgeStay.Components.Layout
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject GuestService GuestService

<div class="profiles-container">
    <div class="search-wrapper">
        <span class="search-icon">🔍</span>
        <input type="text"
               class="search-input"
               @bind="searchQuery"
               @bind:event="oninput"
               placeholder="Search by name or email..." />
    </div>

    @if (isLoading)
    {
        <div class="loading-state">Loading guests...</div>
    }
    else if (filteredGuests.Count == 0)
    {
        <div class="empty-state">
            <span class="empty-icon">👤</span>
            <p>No guests found matching your search.</p>
            <button class="btn-primary" @onclick="GoToCreate">Create first guest profile</button>
        </div>
    }
    else
    {
        <div class="guests-grid">
            @foreach (var guest in filteredGuests)
            {
                <div class="guest-card" @onclick="() => ViewGuest(guest.Id)">
                    <div class="card-accent-bar"></div>
                    <div class="guest-card-top">
                        <div class="avatar-circle">
                            @guest.Name.Substring(0,1).ToUpper()
                        </div>
                        <div class="tier-badge @GetTierClass(guest.Tier)">
                            @guest.Tier
                        </div>
                    </div>
                    
                    <div class="guest-info">
                        <h3>@guest.Name</h3>
                        <p class="guest-contact">📧 @guest.Email</p>
                        <p class="guest-contact">📞 @guest.PhoneNo</p>
                        
                        <div class="guest-meta">
                            <span class="points-tag">⭐ @guest.LoyaltyPoints pts</span>
                            @if (!string.IsNullOrEmpty(guest.PreferredRoomType))
                            {
                                <span class="pref-tag">🛏️ @guest.PreferredRoomType</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private string searchQuery = "";
    private List<GuestProfile> allGuests = new();
    private bool isLoading = true;

    private List<GuestProfile> filteredGuests => allGuests
        .Where(g => string.IsNullOrEmpty(searchQuery) ||
                    g.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
                    g.Email.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        allGuests = await GuestService.GetAllGuestsAsync();
        isLoading = false;
    }

    private void GoToCreate() => Navigation.NavigateTo("/guest-profile-create");
    private void ViewGuest(int id) => Navigation.NavigateTo($"/guest-profile-detail/{id}");

    private string GetTierClass(string tier) => tier switch
    {
        "Gold" => "tier-gold",
        "Silver" => "tier-silver",
        _ => "tier-bronze"
    };
}

<style>
    .profiles-container { padding: 2rem; max-width: 1200px; margin: 0 auto; color: #e2e8f0; }
    
    .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; }
    .header-left h2 { margin: 0; color: #fff; font-size: 1.8rem; }
    
    .btn-primary { padding: 10px 20px; border-radius: 8px; cursor: pointer; background: rgba(187, 134, 252, 0.15); color: var(--accent-purple); border: 1px solid rgba(187, 134, 252, 0.3); transition: all 0.2s; font-weight: 600; }
    .btn-primary:hover { background: rgba(187, 134, 252, 0.25); box-shadow: 0 0 15px rgba(187, 134, 252, 0.2); }
    
    .search-wrapper { display: flex; align-items: center; background: #13181f; border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 0.5rem 1rem; gap: 0.75rem; margin-bottom: 2.5rem; transition: border-color 0.2s, box-shadow 0.2s; }
    .search-wrapper:focus-within { border-color: var(--accent-purple); box-shadow: 0 0 0 2px rgba(187, 134, 252, 0.15); }
    .search-icon { font-size: 1.2rem; opacity: 0.7; }
    .search-input { flex: 1; border: none; outline: none; background: transparent; color: #fff; font-size: 1rem; padding: 8px 0; }
    
    .guests-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem; }
    
    .guest-card {
        background: #13181f;
        border-radius: 12px;
        padding: 1.5rem;
        cursor: pointer;
        position: relative;
        overflow: hidden;
        border: 1px solid rgba(255,255,255,0.05);
        transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.3s ease, border-color 0.3s ease;
    }
    
    .card-accent-bar {
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 4px;
        background: var(--accent-purple);
        opacity: 0;
        transition: opacity 0.3s ease;
    }
    
    .guest-card:hover {
        transform: scale(1.03) translateY(-5px);
        box-shadow: 0 15px 30px rgba(0,0,0,0.5), 0 0 15px rgba(187, 134, 252, 0.1);
        border-color: rgba(187, 134, 252, 0.3);
    }
    .guest-card:hover .card-accent-bar { opacity: 1; }
    
    .guest-card-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.2rem; }
    
    .avatar-circle { width: 48px; height: 48px; background: rgba(187, 134, 252, 0.1); color: var(--accent-purple); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; font-weight: 700; border: 1px solid rgba(187, 134, 252, 0.2); }
    
    .tier-badge { padding: 4px 10px; border-radius: 20px; font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; }
    .tier-gold { background: linear-gradient(135deg, rgba(251, 191, 36, 0.15), rgba(217, 119, 6, 0.2)); color: #fbbf24; border: 1px solid rgba(251, 191, 36, 0.3); }
    .tier-silver { background: linear-gradient(135deg, rgba(148, 163, 184, 0.15), rgba(100, 116, 139, 0.2)); color: #cbd5e1; border: 1px solid rgba(148, 163, 184, 0.3); }
    .tier-bronze { background: linear-gradient(135deg, rgba(217, 119, 6, 0.1), rgba(180, 83, 9, 0.15)); color: #d97706; border: 1px solid rgba(217, 119, 6, 0.2); }
    
    .guest-info h3 { margin: 0 0 0.5rem; color: #fff; font-size: 1.2rem; }
    .guest-contact { margin: 0.2rem 0; color: #94a3b8; font-size: 0.85rem; }
    
    .guest-meta { display: flex; gap: 0.75rem; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid rgba(255,255,255,0.05); }
    .points-tag { background: rgba(255,255,255,0.05); padding: 4px 8px; border-radius: 6px; font-size: 0.75rem; color: #cbd5e1; font-weight: 600; }
    .pref-tag { background: rgba(59, 130, 246, 0.1); color: #60a5fa; padding: 4px 8px; border-radius: 6px; font-size: 0.75rem; font-weight: 600; border: 1px solid rgba(59, 130, 246, 0.2); }
    
    .loading-state, .empty-state { text-align: center; padding: 4rem 2rem; color: #64748b; }
    .empty-state { background: #13181f; border-radius: 16px; border: 1px dashed rgba(255,255,255,0.1); }
    .empty-icon { font-size: 3rem; display: block; margin-bottom: 1rem; opacity: 0.5; }
    .empty-state p { margin-bottom: 1.5rem; }
</style>

@page "/reservations"
@using LodgeStay.Models
@using LodgeStay.Services
@using LodgeStay.Components.Layout
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject ReservationService ReservationService

<div class="reservations-container">
    <div class="filters-bar">
        <div class="search-wrapper">
            <span class="search-icon">🔍</span>
            <input type="text" 
                   class="search-input" 
                   @bind="searchQuery" 
                   @bind:event="oninput" 
                   placeholder="Search guest name..." />
        </div>
        <select class="status-filter" @bind="statusFilter">
            <option value="">All Status</option>
            <option value="Confirmed">Confirmed</option>
            <option value="Cancelled">Cancelled</option>
        </select>
    </div>

    @if (isLoading)
    {
        <div class="loading-state">Loading reservations...</div>
    }
    else if (filteredReservations.Count == 0)
    {
        <div class="empty-state">
            <span class="empty-icon">📅</span>
            <p>No reservations found.</p>
        </div>
    }
    else
    {
        <div class="table-wrapper">
            <table class="dark-table">
                <thead>
                    <tr>
                        <th>Booking ID</th>
                        <th>Guest Name</th>
                        <th>Room</th>
                        <th>Check-in</th>
                        <th>Check-out</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Local Deals</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in filteredReservations)
                    {
                        <tr>
                            <td><span class="mono-ref">@r.BookingReference</span></td>
                            <td class="guest-name">@r.GuestName</td>
                            <td>Room @r.Room_ID</td>
                            <td>@r.CheckIn.ToString("dd MMM yyyy")</td>
                            <td>@r.CheckOut.ToString("dd MMM yyyy")</td>
                            <td><span class="price">Rs. @r.TotalPrice.ToString("N0")</span></td>
                            <td><span class="status-badge status-@r.Status.ToLower()">@r.Status</span></td>
                            <td>
                                @if (!string.IsNullOrEmpty(r.AttachedDeals))
                                {
                                    <span class="deal-badge">🎁 @r.AttachedDeals.Split(',', StringSplitOptions.RemoveEmptyEntries).Length Deals</span>
                                }
                                else
                                {
                                    <span class="no-deals">—</span>
                                }
                            </td>
                            <td>
                                <div class="action-buttons">
                                    <button class="btn-view" @onclick="() => ViewConfirmation(r)">View</button>
                                    @if (r.Status == "Confirmed")
                                    {
                                        <button class="btn-checkout" @onclick="() => CheckOut(r)">Check-out</button>
                                        <button class="btn-cancel" @onclick="() => CancelReservation(r)">Cancel</button>
                                    }
                                    @if (r.Status == "Completed")
                                    {
                                        <span class="completed-text">✨ Stay Earned</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@inject LoyaltyService LoyaltyService
@inject GuestService GuestService

@code {
    private string searchQuery = "";
    private string statusFilter = "";
    private List<Reservation> allReservations = new();
    private bool isLoading = true;

    private List<Reservation> filteredReservations => allReservations
        .Where(r =>
            (string.IsNullOrEmpty(searchQuery) || r.GuestName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrEmpty(statusFilter) || r.Status == statusFilter)
        ).ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadReservations();
    }

    private async Task LoadReservations()
    {
        isLoading = true;
        allReservations = await ReservationService.GetReservationsAsync();
        isLoading = false;
    }

    private async Task CheckOut(Reservation reservation)
    {
        // 1. Mark as completed
        reservation.Status = "Completed";
        await ReservationService.UpdateReservationAsync(reservation);

        // 2. Award Loyalty Points
        var guest = await GuestService.GetGuestByEmailAsync(reservation.GuestEmail);
        if (guest != null)
        {
            var nights = (reservation.CheckOut - reservation.CheckIn).Days;
            if (nights <= 0) nights = 1; // Minimum 1 night points
            await LoyaltyService.EarnPointsAsync(guest.Id, nights);
        }

        await LoadReservations();
    }

    private void GoToNewBooking()
    {
        Navigation.NavigateTo("/room-finder");
    }

    private void ViewConfirmation(Reservation reservation)
    {
        Navigation.NavigateTo($"/booking-confirmation/{reservation.BookingReference}" +
            $"?guest={Uri.EscapeDataString(reservation.GuestName)}" +
            $"&room={reservation.Room_ID}" +
            $"&checkin={reservation.CheckIn:yyyy-MM-dd}" +
            $"&checkout={reservation.CheckOut:yyyy-MM-dd}" +
            $"&total={reservation.TotalPrice}");
    }

    private async Task CancelReservation(Reservation reservation)
    {
        await ReservationService.CancelReservationAsync(reservation.BookingReference);
        await LoadReservations();
    }

    private async Task ExportCalendar()
    {
        try
        {
            var confirmed = allReservations.Where(r => r.Status == "Confirmed").ToList();
            if (confirmed.Count == 0)
            {
                await JSRuntime.InvokeVoidAsync("alert", "No confirmed bookings to export.");
                return;
            }

            var sb = new System.Text.StringBuilder();
            sb.AppendLine("BEGIN:VCALENDAR");
            sb.AppendLine("VERSION:2.0");
            sb.AppendLine("PRODID:-//LodgeStay//EN");

            foreach (var r in confirmed)
            {
                sb.AppendLine("BEGIN:VEVENT");
                sb.AppendLine($"UID:{r.BookingReference}@lodgestay.com");
                sb.AppendLine($"DTSTAMP:{DateTime.Now:yyyyMMddTHHmmssZ}");
                sb.AppendLine($"DTSTART:{r.CheckIn:yyyyMMdd}");
                sb.AppendLine($"DTEND:{r.CheckOut:yyyyMMdd}");
                sb.AppendLine($"SUMMARY:Booking: {r.GuestName}");
                sb.AppendLine($"DESCRIPTION:Room {r.Room_ID} | Guests: {r.NumberOfGuests} | Total: Rs.{r.TotalPrice}");
                sb.AppendLine("END:VEVENT");
            }

            sb.AppendLine("END:VCALENDAR");

            var encodedData = Uri.EscapeDataString(sb.ToString());
            await JSRuntime.InvokeVoidAsync("eval", $@"
            const link = document.createElement('a');
            const content = decodeURIComponent('{encodedData}');
            const blob = new Blob([content], {{ type: 'text/calendar' }});
            const url = URL.createObjectURL(blob);
            link.href = url;
            link.download = 'lodgestay_bookings.ics';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            URL.revokeObjectURL(url);
        ");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error exporting calendar: {ex.Message}");
        }
    }
}

<style>
    .reservations-container { padding: 2rem; max-width: 1200px; margin: 0 auto; color: #e2e8f0; }
    
    .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; }
    .header-left h2 { margin: 0; color: #fff; font-size: 1.8rem; }
    
    .header-actions { display: flex; gap: 1rem; }
    .btn-outline { background: transparent; color: #60a5fa; border: 1px solid rgba(96, 165, 250, 0.4); padding: 8px 16px; border-radius: 8px; font-weight: 600; cursor: pointer; transition: all 0.2s; }
    .btn-outline:hover { background: rgba(96, 165, 250, 0.1); }
    .btn-primary { background: rgba(187, 134, 252, 0.15); color: var(--accent-purple); border: 1px solid rgba(187, 134, 252, 0.3); padding: 8px 16px; border-radius: 8px; font-weight: 600; cursor: pointer; transition: all 0.2s; }
    .btn-primary:hover { background: rgba(187, 134, 252, 0.25); box-shadow: 0 0 15px rgba(187, 134, 252, 0.2); }

    .filters-bar { display: flex; gap: 1rem; margin-bottom: 2rem; align-items: stretch; }
    .search-wrapper { flex: 1; display: flex; align-items: center; background: #13181f; border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; padding: 0 1rem; gap: 0.75rem; transition: border-color 0.2s; }
    .search-wrapper:focus-within { border-color: var(--accent-purple); }
    .search-icon { font-size: 1.1rem; opacity: 0.6; }
    .search-input { width: 100%; border: none; background: transparent; color: #fff; padding: 12px 0; outline: none; }
    .status-filter { background: #13181f; color: #fff; border: 1px solid rgba(255,255,255,0.1); padding: 0 1.5rem; border-radius: 8px; outline: none; font-size: 0.95rem; cursor: pointer; }
    .status-filter:focus { border-color: var(--accent-purple); }
    .status-filter option { background: #0d1117; color: #fff; }

    .table-wrapper { background: #13181f; border-radius: 12px; border: 1px solid rgba(255,255,255,0.05); overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.3); }
    .dark-table { width: 100%; border-collapse: collapse; text-align: left; }
    .dark-table th { background: rgba(255,255,255,0.02); padding: 1rem 1.2rem; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px; color: #94a3b8; font-weight: 600; border-bottom: 1px solid rgba(255,255,255,0.05); }
    .dark-table td { padding: 1.2rem; font-size: 0.95rem; color: #cbd5e1; border-bottom: 1px solid rgba(255,255,255,0.05); transition: background 0.2s; }
    .dark-table tbody tr:hover td { background: rgba(255,255,255,0.03); }

    .mono-ref { font-family: 'Courier New', Courier, monospace; background: rgba(255,255,255,0.05); padding: 4px 8px; border-radius: 6px; color: #94a3b8; font-size: 0.85rem; }
    .guest-name { font-weight: 600; color: #fff; }
    .price { font-weight: 600; color: #94a3b8; }

    .status-badge { padding: 4px 12px; border-radius: 20px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; }
    .status-confirmed { background: rgba(16, 185, 129, 0.1); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.2); }
    .status-cancelled { background: rgba(239, 68, 68, 0.1); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.2); }

    .deal-badge { background: rgba(187, 134, 252, 0.15); color: var(--accent-purple); padding: 4px 10px; border-radius: 6px; font-size: 0.75rem; font-weight: 700; border: 1px solid rgba(187, 134, 252, 0.3); white-space: nowrap; }
    .no-deals { color: #64748b; font-size: 0.85rem; }

    .action-buttons { display: flex; gap: 0.5rem; align-items: center; }
    .btn-view, .btn-cancel, .btn-checkout { padding: 6px 12px; border-radius: 6px; font-size: 0.85rem; font-weight: 600; cursor: pointer; transition: all 0.2s; }
    .btn-view { background: rgba(187, 134, 252, 0.1); color: var(--accent-purple); border: 1px solid rgba(187, 134, 252, 0.2); }
    .btn-view:hover { background: rgba(187, 134, 252, 0.2); border-color: rgba(187, 134, 252, 0.4); }
    .btn-checkout { background: rgba(16, 185, 129, 0.1); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.2); }
    .btn-checkout:hover { background: rgba(16, 185, 129, 0.2); border-color: rgba(16, 185, 129, 0.4); }
    .btn-cancel { background: rgba(239, 68, 68, 0.1); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.2); }
    .btn-cancel:hover { background: rgba(239, 68, 68, 0.2); border-color: rgba(239, 68, 68, 0.4); }

    .completed-text { font-size: 0.75rem; color: #10b981; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; }
    .status-completed { background: rgba(59, 130, 246, 0.1); color: #3b82f6; border: 1px solid rgba(59, 130, 246, 0.2); }

    .loading-state, .empty-state { text-align: center; padding: 4rem 2rem; color: #64748b; background: #13181f; border-radius: 12px; border: 1px dashed rgba(255,255,255,0.1); }
    .empty-icon { font-size: 3rem; display: block; margin-bottom: 1rem; opacity: 0.5; }
</style>

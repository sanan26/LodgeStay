@page "/dashboard"
@using LodgeStay.Services
@using LodgeStay.Models
@inject ReservationService ReservationService
@inject RoomService RoomService
@inject NotificationService NotificationService
@inject SessionService SessionService
@inject ReportService ReportService
@inject NavigationManager Navigation
@implements IDisposable

<div class="page-container">

    @if (!isAuthorized)
    {
        <div class="alert alert-warning">You must be logged in as Manager or Owner to view this page.</div>
    }
    else
    {
        <div class="page-header">
            <h2 class="page-title">📊 Occupancy Dashboard</h2>
            <span class="refresh-badge">Auto-refresh in @refreshCountdown s</span>
        </div>

        @if (isLoading)
        {
            <div class="loading-spinner">
                <div class="spinner"></div>
                <p>Loading dashboard...</p>
            </div>
        }
        else
        {
            <div class="summary-grid">
                <div class="summary-card occupancy-card">
                    <div class="card-icon">🏨</div>
                    <div class="card-body">
                        <div class="card-value">@OccupancyPercent%</div>
                        <div class="card-label">Occupancy Rate</div>
                        <div class="card-sub">@occupiedRooms / @totalRooms rooms occupied</div>
                    </div>
                </div>

                <div class="summary-card checkin-card">
                    <div class="card-icon">✅</div>
                    <div class="card-body">
                        <div class="card-value">@todayCheckIns</div>
                        <div class="card-label">Check-ins Today</div>
                    </div>
                </div>

                <div class="summary-card checkout-card">
                    <div class="card-icon">🚪</div>
                    <div class="card-body">
                        <div class="card-value">@todayCheckOuts</div>
                        <div class="card-label">Check-outs Today</div>
                    </div>
                </div>

                <div class="summary-card revenue-card">
                    <div class="card-icon">💰</div>
                    <div class="card-body">
                        <div class="card-value">PKR @monthRevenue.ToString("N0")</div>
                        <div class="card-label">Revenue This Month</div>
                    </div>
                </div>
            </div>

            @if (showLowOccupancyAlert)
            {
                <div class="alert alert-warning alert-dismissible">
                    ⚠️ <strong>Low Occupancy Alert:</strong> Occupancy is below 30%. Consider offering walk-in discounts.
                    <button class="dismiss-btn" @onclick="() => showLowOccupancyAlert = false">✕</button>
                </div>
            }

            <div class="section-header">
                <h3>Room Status</h3>
                <div class="legend">
                    <span class="legend-item available">Available</span>
                    <span class="legend-item reserved">Reserved</span>
                    <span class="legend-item occupied">Occupied</span>
                    <span class="legend-item maintenance">Maintenance</span>
                </div>
            </div>

            <div class="room-grid">
                @foreach (var room in rooms)
                {
                    <div class="room-tile @GetRoomStatusClass(room.Status)">
                        <div class="room-number">@room.RoomNo</div>
                        <div class="room-type">@room.Room_Type</div>
                        <div class="room-status-label">@room.Status</div>
                        <div class="room-price">PKR @room.Price/night</div>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private bool isAuthorized = false;
    private bool isLoading = true;
    private bool showLowOccupancyAlert = false;

    private List<Room> rooms = new();

    private int totalRooms = 0;
    private int occupiedRooms = 0;
    private int OccupancyPercent => totalRooms == 0 ? 0 : (int)Math.Round((double)occupiedRooms / totalRooms * 100);

    // FIX: OccupancyReport has no TodayCheckIns/TodayCheckOuts/MonthRevenue.
    // Derive these directly from the reservations list and revenue report.
    private int todayCheckIns = 0;
    private int todayCheckOuts = 0;
    private double monthRevenue = 0;

    private System.Threading.Timer? refreshTimer;
    private int refreshCountdown = 60;

    protected override async Task OnInitializedAsync()
    {
        var user = SessionService.CurrentUser;
        isAuthorized = user != null && (user.Role == "Manager" || user.Role == "Owner");

        if (!isAuthorized) return;

        await LoadDashboard();

        refreshTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                refreshCountdown--;
                if (refreshCountdown <= 0)
                {
                    await LoadDashboard();
                    refreshCountdown = 60;
                }
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private async Task LoadDashboard()
    {
        isLoading = true;
        StateHasChanged();

        var today = DateTime.Today;
        var monthStart = new DateTime(today.Year, today.Month, 1);

        // Occupancy report for this month — use Reservations list to derive counts
        var occupancyReport = await ReportService.GetOccupancyReportAsync(monthStart, today);
        todayCheckIns  = occupancyReport.Reservations.Count(r => r.CheckIn.Date  == today);
        todayCheckOuts = occupancyReport.Reservations.Count(r => r.CheckOut.Date == today);

        // Revenue report for this month
        var revenueReport = await ReportService.GetRevenueReportAsync(monthStart, today);
        monthRevenue = revenueReport.TotalRevenue;

        rooms = await RoomService.GetAllRoomsAsync();
        totalRooms    = rooms.Count;
        occupiedRooms = rooms.Count(r => r.Status == "Occupied" || r.Status == "Reserved");

        if (OccupancyPercent < 30)
        {
            showLowOccupancyAlert = true;
            await NotificationService.SendOccupancyAlertAsync(OccupancyPercent);
        }

        isLoading = false;
        StateHasChanged();
    }

    private string GetRoomStatusClass(string status) => status switch
    {
        "Available"   => "status-available",
        "Reserved"    => "status-reserved",
        "Occupied"    => "status-occupied",
        "Maintenance" => "status-maintenance",
        _             => ""
    };

    public void Dispose()
    {
        refreshTimer?.Dispose();
    }
}

<style>
    .page-container { padding: 1rem; max-width: 1100px; margin: 0 auto; }

    .page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
    .page-title { font-size: 1.5rem; font-weight: 700; color: #1a1a2e; margin: 0; }
    .refresh-badge { font-size: 0.75rem; background: #e8f4fd; color: #2e75b6; padding: 4px 10px; border-radius: 12px; }

    .summary-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 1.5rem; }
    .summary-card { background: #fff; border-radius: 12px; padding: 1.2rem; display: flex; align-items: center; gap: 1rem; box-shadow: 0 2px 8px rgba(0,0,0,0.08); border-left: 4px solid #2e75b6; }
    .occupancy-card { border-left-color: #2e75b6; }
    .checkin-card   { border-left-color: #28a745; }
    .checkout-card  { border-left-color: #fd7e14; }
    .revenue-card   { border-left-color: #6f42c1; }
    .card-icon  { font-size: 2rem; }
    .card-value { font-size: 1.5rem; font-weight: 700; color: #1a1a2e; }
    .card-label { font-size: 0.8rem; color: #666; }
    .card-sub   { font-size: 0.75rem; color: #999; margin-top: 2px; }

    .alert { padding: 0.85rem 1rem; border-radius: 8px; margin-bottom: 1rem; display: flex; align-items: center; gap: 0.5rem; }
    .alert-warning { background: #fff3cd; color: #856404; border: 1px solid #ffc107; }
    .dismiss-btn { margin-left: auto; background: none; border: none; cursor: pointer; font-size: 1rem; color: #856404; }

    .section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
    .section-header h3 { font-size: 1.1rem; font-weight: 600; color: #1a1a2e; margin: 0; }

    .legend { display: flex; gap: 0.75rem; flex-wrap: wrap; }
    .legend-item { font-size: 0.75rem; padding: 3px 10px; border-radius: 10px; font-weight: 500; }
    .legend-item.available   { background: #d4edda; color: #155724; }
    .legend-item.reserved    { background: #cce5ff; color: #004085; }
    .legend-item.occupied    { background: #f8d7da; color: #721c24; }
    .legend-item.maintenance { background: #fff3cd; color: #856404; }

    .room-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 0.85rem; }
    .room-tile { border-radius: 10px; padding: 0.85rem; text-align: center; transition: transform 0.15s; cursor: default; }
    .room-tile:hover { transform: translateY(-2px); }
    .room-number { font-size: 1.1rem; font-weight: 700; }
    .room-type   { font-size: 0.7rem; color: #555; margin: 2px 0; }
    .room-status-label { font-size: 0.7rem; font-weight: 600; margin-top: 4px; }
    .room-price  { font-size: 0.65rem; color: #888; margin-top: 2px; }

    .status-available   { background: #d4edda; border: 1px solid #c3e6cb; color: #155724; }
    .status-reserved    { background: #cce5ff; border: 1px solid #b8daff; color: #004085; }
    .status-occupied    { background: #f8d7da; border: 1px solid #f5c6cb; color: #721c24; }
    .status-maintenance { background: #fff3cd; border: 1px solid #ffeeba; color: #856404; }

    .loading-spinner { text-align: center; padding: 3rem; color: #666; }
    .spinner { width: 36px; height: 36px; border: 4px solid #e0e0e0; border-top-color: #2e75b6; border-radius: 50%; animation: spin 0.8s linear infinite; margin: 0 auto 1rem; }
    @@keyframes spin { to { transform: rotate(360deg); } }
</style>

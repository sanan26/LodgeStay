@page "/dashboard"
@using LodgeStay.Services
@using LodgeStay.Models
@inject ReservationService ReservationService
@inject RoomService RoomService
@inject NotificationService NotificationService
@inject SessionService SessionService
@inject ReportService ReportService
@inject NavigationManager Navigation
@implements IDisposable

<div class="dashboard-root">
    @if (!isAuthorized)
    {
        <div class="glass-panel alert-box">
            <span class="icon">🔒</span>
            <div class="content">
                <h3>Access Restricted</h3>
                <p>You must be logged in as Manager or Owner to view the occupancy analytics.</p>
            </div>
        </div>
    }
    else
    {
        @if (isLoading)
        {
            <div class="dash-loader">
                <div class="nexus-spinner"></div>
                <p>Synthesizing Data...</p>
            </div>
        }
        else
        {
            <div class="main-stats-layout">
                <!-- HERO GAUGE SECTION -->
                <div class="glass-panel hero-section">
                    <div class="gauge-container">
                        <svg class="occupancy-gauge" viewBox="0 0 100 100">
                            <circle class="gauge-bg" cx="50" cy="50" r="45"></circle>
                            <circle class="gauge-fill" cx="50" cy="50" r="45" 
                                    style="stroke-dasharray: @(OccupancyPercent * 2.827) 282.7"></circle>
                        </svg>
                        <div class="gauge-content">
                            <span class="g-val">@OccupancyPercent%</span>
                            <span class="g-lbl">Full</span>
                        </div>
                    </div>
                    <div class="hero-info">
                        <div class="stat-mini">
                            <span class="s-val">@occupiedRooms</span>
                            <span class="s-lbl">Occupied</span>
                        </div>
                        <div class="stat-divider"></div>
                        <div class="stat-mini">
                            <span class="s-val">@(totalRooms - occupiedRooms)</span>
                            <span class="s-lbl">Available</span>
                        </div>
                    </div>
                </div>

                <!-- QUICK STATS GRID -->
                <div class="stats-grid">
                    <div class="glass-panel stat-card checkin">
                        <div class="sc-top">
                            <span class="sc-icon">📥</span>
                            <span class="sc-trend up">↑</span>
                        </div>
                        <div class="sc-body">
                            <span class="sc-val">@todayCheckIns</span>
                            <span class="sc-lbl">Arrivals Today</span>
                        </div>
                    </div>

                    <div class="glass-panel stat-card checkout">
                        <div class="sc-top">
                            <span class="sc-icon">📤</span>
                            <span class="sc-trend">→</span>
                        </div>
                        <div class="sc-body">
                            <span class="sc-val">@todayCheckOuts</span>
                            <span class="sc-lbl">Departures Today</span>
                        </div>
                    </div>

                    <div class="glass-panel stat-card revenue">
                        <div class="sc-top">
                            <span class="sc-icon">💰</span>
                            <span class="sc-trend up">↑</span>
                        </div>
                        <div class="sc-body">
                            <span class="sc-val">Rs. @monthRevenue.ToString("N0")</span>
                            <span class="sc-lbl">Month-to-Date</span>
                        </div>
                    </div>
                </div>
            </div>

            @if (showLowOccupancyAlert)
            {
                <div class="glass-panel banner-alert">
                    <div class="alert-content">
                        <span class="alert-icon">⚠️</span>
                        <div class="alert-text">
                            <strong>Low Capacity Alert: @OccupancyPercent%</strong>
                            <p>Occupancy has dipped below 30%. Dynamic pricing or local promos suggested.</p>
                        </div>
                    </div>
                    <button class="btn-dismiss" @onclick="() => showLowOccupancyAlert = false">✕</button>
                </div>
            }

            <!-- ROOM GRID SECTION -->
            <div class="rooms-section">
                <div class="section-top">
                    <h3 class="section-title">Floor Layout & Status</h3>
                    <div class="legend-pills">
                        <span class="l-pill av">Available</span>
                        <span class="l-pill re">Reserved</span>
                        <span class="l-pill oc">Occupied</span>
                        <span class="l-pill ma">Maint.</span>
                    </div>
                </div>

                <div class="hex-grid">
                    @foreach (var room in rooms)
                    {
                        <div class="room-hex-card @GetRoomStatusClass(room.Status)">
                            <div class="rh-glow"></div>
                            <div class="rh-content">
                                <span class="rh-no">@room.RoomNo</span>
                                <span class="rh-type">@room.Room_Type</span>
                                <div class="rh-status-tag">@room.Status</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    private bool isAuthorized = false;
    private bool isLoading = true;
    private bool showLowOccupancyAlert = false;

    private List<Room> rooms = new();

    private int totalRooms = 0;
    private int occupiedRooms = 0;
    private int OccupancyPercent => totalRooms == 0 ? 0 : (int)Math.Round((double)occupiedRooms / totalRooms * 100);

    private int todayCheckIns = 0;
    private int todayCheckOuts = 0;
    private double monthRevenue = 0;

    private System.Threading.Timer? refreshTimer;
    private int refreshCountdown = 60;

    protected override async Task OnInitializedAsync()
    {
        var user = SessionService.CurrentUser;
        isAuthorized = user != null && (user.Role == "Manager" || user.Role == "Owner");

        if (!isAuthorized) return;

        await LoadDashboard();

        refreshTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                refreshCountdown--;
                if (refreshCountdown <= 0)
                {
                    await LoadDashboard();
                    refreshCountdown = 60;
                }
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private async Task LoadDashboard()
    {
        isLoading = true;
        StateHasChanged();

        var today = DateTime.Today;
        var monthStart = new DateTime(today.Year, today.Month, 1);

        try {
            var occupancyReport = await ReportService.GetOccupancyReportAsync(monthStart, today);
            todayCheckIns  = occupancyReport.Reservations.Count(r => r.CheckIn.Date  == today);
            todayCheckOuts = occupancyReport.Reservations.Count(r => r.CheckOut.Date == today);

            var revenueReport = await ReportService.GetRevenueReportAsync(monthStart, today);
            monthRevenue = revenueReport.TotalRevenue;

            rooms = await RoomService.GetAllRoomsAsync();
            totalRooms    = rooms.Count;
            occupiedRooms = rooms.Count(r => r.Status == "Occupied" || r.Status == "Reserved");

            if (OccupancyPercent < 30)
            {
                showLowOccupancyAlert = true;
                await NotificationService.SendOccupancyAlertAsync(OccupancyPercent);
            }
        } catch {
            // Silently fail if report service has no data
        }

        isLoading = false;
        StateHasChanged();
    }

    private string GetRoomStatusClass(string status) => status switch
    {
        "Available"   => "s-available",
        "Reserved"    => "s-reserved",
        "Occupied"    => "s-occupied",
        "Maintenance" => "s-maintenance",
        _             => ""
    };

    public void Dispose()
    {
        refreshTimer?.Dispose();
    }
}

<style>
    .dashboard-root { padding: 2rem; max-width: 1300px; margin: 0 auto; color: #e2e8f0; font-family: 'Inter', sans-serif; }

    /* Header */
    .dash-header { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 2.5rem; }
    .dash-title { font-size: 2.2rem; font-weight: 800; color: #fff; margin: 0; letter-spacing: -1px; }
    .header-main { display: flex; align-items: baseline; gap: 1rem; }
    .live-indicator { display: flex; align-items: center; gap: 0.5rem; font-size: 0.75rem; font-weight: 700; color: #10b981; letter-spacing: 1px; }
    .live-indicator .dot { width: 8px; height: 8px; background: #10b981; border-radius: 50%; animation: pulse 1.5s infinite; }
    @@keyframes pulse { 0% { opacity: 0.5; box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.4); } 70% { opacity: 1; box-shadow: 0 0 0 8px rgba(16, 185, 129, 0); } 100% { opacity: 0.5; } }
    
    .refresh-pill { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); padding: 0.6rem 1.2rem; border-radius: 50px; font-size: 0.85rem; color: #94a3b8; }
    .refresh-pill strong { color: #fff; margin: 0 2px; }

    /* Layout */
    .main-stats-layout { display: grid; grid-template-columns: 400px 1fr; gap: 2rem; margin-bottom: 2rem; }

    /* Hero Section */
    .hero-section { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 3rem; background: radial-gradient(circle at center, rgba(187, 134, 252, 0.1) 0%, transparent 80%); }
    .gauge-container { position: relative; width: 220px; height: 220px; margin-bottom: 2rem; }
    .occupancy-gauge { transform: rotate(-90deg); width: 100%; height: 100%; }
    .gauge-bg { fill: none; stroke: rgba(255,255,255,0.05); stroke-width: 8; }
    .gauge-fill { fill: none; stroke: var(--accent-purple); stroke-width: 8; stroke-linecap: round; transition: stroke-dasharray 1.5s ease-out; filter: drop-shadow(0 0 8px var(--accent-purple)); }
    
    .gauge-content { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; }
    .g-val { font-size: 3.2rem; font-weight: 800; color: #fff; line-height: 1; }
    .g-lbl { font-size: 1rem; color: #94a3b8; text-transform: uppercase; letter-spacing: 2px; }

    .hero-info { display: flex; gap: 2.5rem; align-items: center; width: 100%; justify-content: center; }
    .stat-mini { text-align: center; }
    .s-val { display: block; font-size: 1.5rem; font-weight: 700; color: #fff; }
    .s-lbl { font-size: 0.75rem; color: #64748b; text-transform: uppercase; letter-spacing: 1px; }
    .stat-divider { width: 1px; height: 40px; background: rgba(255,255,255,0.1); }

    /* Stats Grid */
    .stats-grid { display: grid; grid-template-rows: repeat(3, 1fr); gap: 1rem; }
    .stat-card { display: flex; flex-direction: column; justify-content: space-between; padding: 1.5rem; border-left: 4px solid transparent; transition: all 0.3s ease; }
    .stat-card:hover { transform: translateX(10px); background: rgba(255,255,255,0.03); }
    
    .checkin { border-left-color: #03dac6; }
    .checkout { border-left-color: #cf6679; }
    .revenue { border-left-color: #fbbf24; }
    
    .sc-top { display: flex; justify-content: space-between; align-items: center; }
    .sc-icon { font-size: 1.8rem; }
    .sc-trend { font-weight: 800; font-size: 1.1rem; }
    .sc-trend.up { color: #10b981; }
    
    .sc-body { margin-top: 1rem; }
    .sc-val { display: block; font-size: 1.8rem; font-weight: 800; color: #fff; }
    .sc-lbl { font-size: 0.85rem; color: #94a3b8; }

    /* Alert Banner */
    .banner-alert { display: flex; justify-content: space-between; align-items: center; padding: 1.2rem 2rem; border-left: 6px solid #fcd34d; background: rgba(252, 211, 77, 0.05); margin-bottom: 2rem; border-radius: 12px; }
    .alert-content { display: flex; align-items: center; gap: 1.5rem; }
    .alert-icon { font-size: 2rem; }
    .alert-text strong { display: block; color: #fcd34d; font-size: 1.1rem; margin-bottom: 2px; }
    .alert-text p { margin: 0; color: #fde68a; font-size: 0.9rem; }
    .btn-dismiss { background: transparent; border: none; color: #fde68a; font-size: 1.2rem; cursor: pointer; padding: 5px; opacity: 0.5; transition: opacity 0.2s; }
    .btn-dismiss:hover { opacity: 1; }

    /* Room Grid Section */
    .section-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
    .section-title { font-size: 1.3rem; font-weight: 700; color: #fff; margin: 0; }
    
    .legend-pills { display: flex; gap: 0.8rem; }
    .l-pill { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; padding: 4px 12px; border-radius: 20px; border: 1px solid rgba(255,255,255,0.1); color: #94a3b8; }
    .l-pill.av { color: #03dac6; border-color: rgba(3, 218, 198, 0.3); }
    .l-pill.re { color: var(--accent-purple); border-color: rgba(187, 134, 252, 0.3); }
    .l-pill.oc { color: #cf6679; border-color: rgba(207, 102, 121, 0.3); }
    .l-pill.ma { color: #fbbf24; border-color: rgba(251, 191, 36, 0.3); }

    /* Hex Grid Layout */
    .hex-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 1.2rem; }
    
    .room-hex-card { position: relative; background: #13181f; border-radius: 20px; padding: 1.5rem; border: 1px solid rgba(255,255,255,0.05); overflow: hidden; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); cursor: default; }
    .room-hex-card:hover { transform: translateY(-5px) scale(1.02); z-index: 10; border-color: rgba(255,255,255,0.2); }
    
    .rh-glow { position: absolute; inset: 0; background: radial-gradient(circle at top, var(--room-color) 0%, transparent 60%); opacity: 0; transition: opacity 0.4s ease; }
    .room-hex-card:hover .rh-glow { opacity: 0.15; }
    
    .s-available { --room-color: #03dac6; border-bottom: 4px solid #03dac6; }
    .s-reserved  { --room-color: var(--accent-purple); border-bottom: 4px solid var(--accent-purple); }
    .s-occupied  { --room-color: #cf6679; border-bottom: 4px solid #cf6679; }
    .s-maintenance { --room-color: #fbbf24; border-bottom: 4px solid #fbbf24; }

    .rh-content { position: relative; z-index: 1; text-align: center; }
    .rh-no { display: block; font-size: 1.8rem; font-weight: 800; color: #fff; line-height: 1; margin-bottom: 0.4rem; }
    .rh-type { display: block; font-size: 0.75rem; color: #94a3b8; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 1rem; }
    .rh-status-tag { display: inline-block; font-size: 0.7rem; font-weight: 800; padding: 3px 8px; border-radius: 6px; background: rgba(0,0,0,0.3); color: var(--room-color); border: 1px solid var(--room-color); }

    /* Loader */
    .dash-loader { text-align: center; padding: 10rem 0; }
    .nexus-spinner { width: 60px; height: 60px; border: 4px solid rgba(187, 134, 252, 0.1); border-top-color: var(--accent-purple); border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto 1.5rem; filter: drop-shadow(0 0 10px var(--accent-purple)); }
    @@keyframes spin { to { transform: rotate(360deg); } }

    @@media (max-width: 1024px) {
        .main-stats-layout { grid-template-columns: 1fr; }
        .stats-grid { grid-template-columns: repeat(3, 1fr); grid-template-rows: auto; }
        .stat-card:hover { transform: translateY(-5px); }
    }
    @@media (max-width: 768px) {
        .stats-grid { grid-template-columns: 1fr; }
    }
</style>

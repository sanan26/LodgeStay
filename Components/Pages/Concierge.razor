@page "/concierge"
@using LodgeStay.Services
@using LodgeStay.Models
@inject ConciergeService ConciergeService
@inject SessionService SessionService
@inject IJSRuntime JS

<div class="page-container">

    <div class="page-header">
        <h2 class="page-title">💬 Staff Concierge</h2>
        <p class="page-sub">Instant answers to common policy questions and guest response templates.</p>
    </div>

    <!-- Search Bar -->
    <div class="search-bar-wrapper">
        <span class="search-icon">🔍</span>
        <input type="text"
               class="search-input"
               placeholder="Type a keyword (e.g. check-in, breakfast, Wi-Fi)..."
               @bind="searchKeyword"
               @bind:event="oninput"
               @bind:after="OnSearchInput" />
        @if (!string.IsNullOrEmpty(searchKeyword))
        {
            <button class="clear-btn" @onclick="ClearSearch">✕</button>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(searchKeyword))
    {
        <div class="results-header">
            <span>Results for "<strong>@searchKeyword</strong>"</span>
            <span class="result-count">@searchResults.Count found</span>
        </div>

        @if (isSearching)
        {
            <div class="loading-row"><div class="spinner-sm"></div> Searching...</div>
        }
        else if (searchResults.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-icon">🤷</div>
                <p>No results found for "<strong>@searchKeyword</strong>".</p>
                <p class="muted-text">Try a different keyword or browse by category below.</p>
            </div>
        }
        else
        {
            <div class="rule-list">
                @foreach (var rule in searchResults)
                {
                    <div class="rule-card">
                        <div class="rule-top">
                            <span class="category-chip @GetCategoryClass(rule.Category)">@rule.Category</span>
                            <button class="copy-btn" @onclick="() => CopyToClipboard(rule.ResponseText)">📋 Copy</button>
                        </div>
                        <div class="rule-response">@rule.ResponseText</div>
                        @if (copiedRuleId == rule.Id)
                        {
                            <div class="copied-toast">✅ Copied to clipboard!</div>
                        }
                    </div>
                }
            </div>
        }
    }
    else
    {
        <div class="category-section">
            <h3 class="section-title">Browse by Category</h3>
            <div class="category-chips-row">
                @foreach (var cat in categories)
                {
                    <button class="cat-chip @(activeCategory == cat ? "active" : "") @GetCategoryClass(cat)"
                            @onclick="() => SelectCategory(cat)">
                        @GetCategoryIcon(cat) @cat
                    </button>
                }
            </div>
        </div>

        @if (!string.IsNullOrEmpty(activeCategory))
        {
            <div class="results-header">
                <span>@GetCategoryIcon(activeCategory) <strong>@activeCategory</strong></span>
                <span class="result-count">@categoryRules.Count responses</span>
            </div>

            @if (categoryRules.Count == 0)
            {
                <div class="empty-state">
                    <p class="muted-text">No responses in this category yet.</p>
                </div>
            }
            else
            {
                <div class="rule-list">
                    @foreach (var rule in categoryRules)
                    {
                        <div class="rule-card">
                            <div class="rule-top">
                                <span class="rule-keywords">🔑 @rule.Keywords</span>
                                <button class="copy-btn" @onclick="() => CopyToClipboard(rule.ResponseText)">📋 Copy</button>
                            </div>
                            <div class="rule-response">@rule.ResponseText</div>
                            @if (copiedRuleId == rule.Id)
                            {
                                <div class="copied-toast">✅ Copied to clipboard!</div>
                            }
                        </div>
                    }
                </div>
            }
        }
        else
        {
            <div class="empty-state subtle">
                <div class="empty-icon">👆</div>
                <p>Select a category above or search by keyword to see responses.</p>
            </div>
        }
    }

    @if (isManager)
    {
        <div class="manager-panel">
            <h3 class="section-title">⚙️ Manage Responses</h3>
            <div class="form-grid">
                <div class="form-group">
                    <label>Keywords (comma-separated)</label>
                    <input type="text" class="form-control" @bind="newRule.Keywords" placeholder="e.g. check-in, arrival time" />
                </div>
                <div class="form-group">
                    <label>Category</label>
                    <select class="form-control" @bind="newRule.Category">
                        @foreach (var cat in categories)
                        {
                            <option value="@cat">@cat</option>
                        }
                    </select>
                </div>
                <div class="form-group full-width">
                    <label>Response Text / Template</label>
                    <textarea class="form-control textarea" @bind="newRule.ResponseText" rows="3"
                              placeholder="Enter the full response or guest message template..."></textarea>
                </div>
            </div>
            <div class="form-actions">
                <button class="btn btn-primary" @onclick="AddRule">+ Add Response</button>
            </div>
            @if (!string.IsNullOrEmpty(managerMessage))
            {
                <div class="alert @(managerSuccess ? "alert-success" : "alert-danger")">@managerMessage</div>
            }
        </div>
    }
</div>

@code {
    private string searchKeyword = "";
    private string activeCategory = "";
    private bool isSearching = false;
    private bool isManager = false;

    private List<ConciergeRule> searchResults = new();
    private List<ConciergeRule> categoryRules = new();
    private int copiedRuleId = -1;

    private string managerMessage = "";
    private bool managerSuccess = false;
    private ConciergeRule newRule = new();

    private readonly List<string> categories = new()
    {
        "Check-In", "Check-Out", "Cancellation", "Room Types",
        "Breakfast", "Wi-Fi", "Amenities", "Payments", "General"
    };

    protected override async Task OnInitializedAsync()
    {
        var user = SessionService.CurrentUser;
        isManager = user != null && (user.Role == "Manager" || user.Role == "Owner");
    }

    private System.Threading.CancellationTokenSource? _searchDebounce;

    private async Task OnSearchInput()
    {
        _searchDebounce?.Cancel();
        _searchDebounce = new System.Threading.CancellationTokenSource();
        var token = _searchDebounce.Token;

        await Task.Delay(300, token).ContinueWith(async t =>
        {
            if (t.IsCanceled) return;
            await InvokeAsync(async () =>
            {
                await RunSearch();
                StateHasChanged();
            });
        });
    }

    private async Task RunSearch()
    {
        if (string.IsNullOrWhiteSpace(searchKeyword)) return;
        isSearching = true;
        StateHasChanged();

        // FIX: SearchByKeywordAsync returns ConciergeResult where Rule is a single
        // ConciergeRule? — not a list. Wrap it in a list for display.
        var result = await ConciergeService.SearchByKeywordAsync(searchKeyword);
        searchResults = (result.Success && result.Rule != null)
            ? new List<ConciergeRule> { result.Rule }
            : new List<ConciergeRule>();

        isSearching = false;
    }

    private async Task SelectCategory(string category)
    {
        activeCategory = category;
        // FIX: GetByCategoryAsync returns List<ConciergeRule> directly — no ConciergeResult wrapper.
        categoryRules = await ConciergeService.GetByCategoryAsync(category);
    }

    private void ClearSearch()
    {
        searchKeyword = "";
        searchResults.Clear();
    }

    private async Task CopyToClipboard(string text)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
        copiedRuleId = text.GetHashCode();
        StateHasChanged();
        await Task.Delay(2000);
        copiedRuleId = -1;
        StateHasChanged();
    }

    private async Task AddRule()
    {
        managerMessage = "";
        if (string.IsNullOrWhiteSpace(newRule.Keywords) || string.IsNullOrWhiteSpace(newRule.ResponseText))
        {
            managerMessage = "Keywords and response text are required.";
            managerSuccess = false;
            return;
        }

        newRule.IsActive = true;
        var (success, message) = await ConciergeService.AddRuleAsync(
            newRule.Keywords,
            newRule.Category,
            newRule.ResponseText,
            newRule.ResponseTemplate ?? "");

        managerMessage = success ? "✅ Response added successfully." : message;
        managerSuccess = success;
        if (success) newRule = new();

        if (!string.IsNullOrEmpty(activeCategory))
            categoryRules = await ConciergeService.GetByCategoryAsync(activeCategory);
    }

    private string GetCategoryClass(string cat) => cat switch
    {
        "Check-In"     => "cat-checkin",
        "Check-Out"    => "cat-checkout",
        "Cancellation" => "cat-cancel",
        "Breakfast"    => "cat-breakfast",
        "Wi-Fi"        => "cat-wifi",
        "Room Types"   => "cat-rooms",
        "Payments"     => "cat-payments",
        "Amenities"    => "cat-amenities",
        _              => "cat-general"
    };

    private string GetCategoryIcon(string cat) => cat switch
    {
        "Check-In"     => "🛎️",
        "Check-Out"    => "🚪",
        "Cancellation" => "❌",
        "Breakfast"    => "🍳",
        "Wi-Fi"        => "📶",
        "Room Types"   => "🏨",
        "Payments"     => "💳",
        "Amenities"    => "🛁",
        _              => "ℹ️"
    };
}

<style>
    .page-container { padding: 1rem; max-width: 860px; margin: 0 auto; }
    .page-header { margin-bottom: 1.2rem; }
    .page-title { font-size: 1.5rem; font-weight: 700; color: #1a1a2e; margin: 0; }
    .page-sub { color: #666; font-size: 0.875rem; margin: 4px 0 0; }

    .search-bar-wrapper { display: flex; align-items: center; background: #fff; border: 2px solid #2e75b6; border-radius: 12px; padding: 0.5rem 1rem; gap: 0.5rem; margin-bottom: 1.2rem; box-shadow: 0 2px 8px rgba(46,117,182,0.1); }
    .search-icon { font-size: 1.1rem; }
    .search-input { flex: 1; border: none; outline: none; font-size: 0.95rem; background: transparent; }
    .clear-btn { background: none; border: none; cursor: pointer; color: #999; font-size: 0.9rem; }

    .results-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.85rem; font-size: 0.9rem; }
    .result-count { background: #e8f0fe; color: #2e75b6; padding: 2px 10px; border-radius: 10px; font-size: 0.8rem; font-weight: 600; }

    .rule-list { display: flex; flex-direction: column; gap: 0.85rem; }
    .rule-card { background: #fff; border-radius: 10px; padding: 1rem 1.1rem; box-shadow: 0 1px 6px rgba(0,0,0,0.07); border-left: 3px solid #2e75b6; position: relative; }
    .rule-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.6rem; }
    .category-chip { font-size: 0.72rem; padding: 3px 10px; border-radius: 10px; font-weight: 600; }
    .rule-keywords { font-size: 0.78rem; color: #888; }
    .rule-response { font-size: 0.9rem; color: #333; line-height: 1.5; white-space: pre-wrap; }
    .copy-btn { background: #f8f9fa; border: 1px solid #ddd; border-radius: 6px; padding: 4px 10px; font-size: 0.78rem; cursor: pointer; transition: background 0.15s; }
    .copy-btn:hover { background: #e2e6ea; }
    .copied-toast { position: absolute; bottom: 0.75rem; right: 1rem; background: #28a745; color: white; font-size: 0.75rem; padding: 3px 10px; border-radius: 8px; }

    .category-section { margin-bottom: 1rem; }
    .section-title { font-size: 1rem; font-weight: 600; color: #1a1a2e; margin-bottom: 0.75rem; }
    .category-chips-row { display: flex; flex-wrap: wrap; gap: 0.5rem; }
    .cat-chip { border: 1px solid #ddd; background: #f8f9fa; border-radius: 20px; padding: 5px 14px; font-size: 0.82rem; cursor: pointer; transition: all 0.2s; }
    .cat-chip.active { font-weight: 600; box-shadow: 0 0 0 2px #2e75b6; }

    .cat-checkin   { border-color: #28a745; color: #155724; }   .cat-checkin.active   { background: #d4edda; }
    .cat-checkout  { border-color: #fd7e14; color: #7d3c00; }   .cat-checkout.active  { background: #ffe5d0; }
    .cat-cancel    { border-color: #dc3545; color: #721c24; }   .cat-cancel.active    { background: #f8d7da; }
    .cat-breakfast { border-color: #ffc107; color: #856404; }   .cat-breakfast.active { background: #fff3cd; }
    .cat-wifi      { border-color: #6f42c1; color: #4a2e80; }   .cat-wifi.active      { background: #e9d8fd; }
    .cat-rooms     { border-color: #2e75b6; color: #003f7a; }   .cat-rooms.active     { background: #cce5ff; }
    .cat-payments  { border-color: #20c997; color: #0d6e50; }   .cat-payments.active  { background: #d1ecf1; }
    .cat-amenities { border-color: #e83e8c; color: #801045; }   .cat-amenities.active { background: #fce4f3; }
    .cat-general   { border-color: #adb5bd; color: #495057; }   .cat-general.active   { background: #f0f0f0; }

    .empty-state { text-align: center; padding: 2.5rem 1rem; color: #666; }
    .empty-state.subtle { padding: 1.5rem; }
    .empty-icon { font-size: 2.5rem; margin-bottom: 0.5rem; }
    .muted-text { color: #aaa; font-size: 0.85rem; }

    .manager-panel { margin-top: 2rem; background: #fff; border-radius: 12px; padding: 1.2rem; box-shadow: 0 2px 8px rgba(0,0,0,0.06); border-top: 3px solid #fd7e14; }
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
    .form-group { display: flex; flex-direction: column; gap: 0.35rem; }
    .form-group.full-width { grid-column: 1 / -1; }
    .form-group label { font-size: 0.82rem; font-weight: 500; color: #555; }
    .form-control { border: 1px solid #ddd; border-radius: 8px; padding: 0.5rem 0.75rem; font-size: 0.875rem; }
    .textarea { resize: vertical; }
    .form-actions { margin-top: 0.75rem; }

    .btn { padding: 0.5rem 1.2rem; border-radius: 8px; border: none; cursor: pointer; font-size: 0.875rem; font-weight: 500; }
    .btn-primary { background: #2e75b6; color: white; }
    .alert { padding: 0.65rem 1rem; border-radius: 8px; margin-top: 0.75rem; font-size: 0.85rem; }
    .alert-success { background: #d4edda; color: #155724; }
    .alert-danger  { background: #f8d7da; color: #721c24; }

    .loading-row { display: flex; align-items: center; gap: 0.5rem; color: #666; font-size: 0.875rem; padding: 1rem 0; }
    .spinner-sm { width: 16px; height: 16px; border: 2px solid #e0e0e0; border-top-color: #2e75b6; border-radius: 50%; animation: spin 0.7s linear infinite; }
    @@keyframes spin { to { transform: rotate(360deg); } }
</style>

@page "/concierge"
@using LodgeStay.Services
@using LodgeStay.Models
@using LodgeStay.Components.Layout
@inject ConciergeService ConciergeService
@inject SessionService SessionService
@inject IJSRuntime JS

<div class="concierge-container">
    <div class="concierge-layout">
        <!-- LEFT COLUMN: Search & Categories -->
        <div class="sidebar-col">
            <div class="search-box">
                <span class="search-icon">🔍</span>
                <input type="text"
                       class="search-input"
                       placeholder="Search keywords..."
                       @bind="searchKeyword"
                       @bind:event="oninput"
                       @bind:after="OnSearchInput" />
                @if (!string.IsNullOrEmpty(searchKeyword))
                {
                    <button class="clear-btn" @onclick="ClearSearch">✕</button>
                }
            </div>

            <div class="categories-section">
                <h3 class="section-title">Categories</h3>
                <div class="category-list">
                    @foreach (var cat in categories)
                    {
                        <button class="cat-pill @(activeCategory == cat && string.IsNullOrEmpty(searchKeyword) ? "active" : "") @GetCategoryClass(cat)"
                                @onclick="() => SelectCategory(cat)">
                            <span class="cat-icon">@GetCategoryIcon(cat)</span>
                            <span class="cat-name">@cat</span>
                        </button>
                    }
                </div>
            </div>

            @if (isManager)
            {
                <div class="manager-btn-wrapper">
                    <button class="btn-outline-brand" @onclick="ToggleManagerPanel">
                        @(showManagerPanel ? "Close Settings" : "⚙️ Manage Responses")
                    </button>
                </div>
            }
        </div>

        <!-- RIGHT COLUMN: Results & Manager Panel -->
        <div class="main-col">
            @if (showManagerPanel && isManager)
            {
                <div class="glass-panel manager-panel">
                    <h3 class="panel-title">⚙️ Add New Response</h3>
                    <div class="form-grid">
                        <div class="form-group">
                            <label>Keywords (comma-separated)</label>
                            <input type="text" @bind="newRule.Keywords" placeholder="e.g. check-in, arrival time" />
                        </div>
                        <div class="form-group">
                            <label>Category</label>
                            <select @bind="newRule.Category">
                                @foreach (var cat in categories)
                                {
                                    <option value="@cat">@cat</option>
                                }
                            </select>
                        </div>
                        <div class="form-group full-width">
                            <label>Response Text / Template</label>
                            <textarea @bind="newRule.ResponseText" rows="4" placeholder="Enter the full response..."></textarea>
                        </div>
                    </div>
                    <div class="form-actions">
                        <button class="btn-primary" @onclick="AddRule">+ Add Response</button>
                    </div>
                    @if (!string.IsNullOrEmpty(managerMessage))
                    {
                        <div class="alert @(managerSuccess ? "alert-success" : "alert-danger")">@managerMessage</div>
                    }
                </div>
            }
            else
            {
                <div class="results-container">
                    @if (!string.IsNullOrWhiteSpace(searchKeyword))
                    {
                        <div class="results-header">
                            <span>Search results for "<strong>@searchKeyword</strong>"</span>
                            <span class="result-count">@searchResults.Count found</span>
                        </div>

                        @if (isSearching)
                        {
                            <div class="loading-state">Searching...</div>
                        }
                        else if (searchResults.Count == 0)
                        {
                            <div class="empty-state">
                                <span class="empty-icon">🤷</span>
                                <p>No results found.</p>
                            </div>
                        }
                        else
                        {
                            <div class="rules-list">
                                @foreach (var rule in searchResults)
                                {
                                    <div class="rule-card">
                                        <div class="rule-top">
                                            <span class="cat-badge @GetCategoryClass(rule.Category)">@rule.Category</span>
                                            <button class="btn-copy" @onclick="() => CopyToClipboard(rule.ResponseText)">📋 Copy</button>
                                        </div>
                                        <div class="rule-text">@rule.ResponseText</div>
                                        @if (copiedRuleId == rule.Id)
                                        {
                                            <div class="toast-success">✅ Copied!</div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                    else if (!string.IsNullOrEmpty(activeCategory))
                    {
                        <div class="results-header">
                            <span>@GetCategoryIcon(activeCategory) <strong>@activeCategory</strong></span>
                            <span class="result-count">@categoryRules.Count responses</span>
                        </div>

                        @if (categoryRules.Count == 0)
                        {
                            <div class="empty-state">
                                <p>No responses in this category yet.</p>
                            </div>
                        }
                        else
                        {
                            <div class="rules-list">
                                @foreach (var rule in categoryRules)
                                {
                                    <div class="rule-card">
                                        <div class="rule-top">
                                            <span class="keywords-label">🔑 @rule.Keywords</span>
                                            <button class="btn-copy" @onclick="() => CopyToClipboard(rule.ResponseText)">📋 Copy</button>
                                        </div>
                                        <div class="rule-text">@rule.ResponseText</div>
                                        @if (copiedRuleId == rule.Id)
                                        {
                                            <div class="toast-success">✅ Copied!</div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-state subtle">
                            <span class="empty-icon">👆</span>
                            <p>Select a category or search to view responses.</p>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    private string searchKeyword = "";
    private string activeCategory = "";
    private bool isSearching = false;
    private bool isManager = false;
    private bool showManagerPanel = false;

    private List<ConciergeRule> searchResults = new();
    private List<ConciergeRule> categoryRules = new();
    private int copiedRuleId = -1;

    private string managerMessage = "";
    private bool managerSuccess = false;
    private ConciergeRule newRule = new();

    private readonly List<string> categories = new()
    {
        "Check-In", "Check-Out", "Cancellation", "Room Types",
        "Breakfast", "Wi-Fi", "Amenities", "Payments", "General"
    };

    protected override async Task OnInitializedAsync()
    {
        var user = SessionService.CurrentUser;
        isManager = user != null && (user.Role == "Manager" || user.Role == "Owner");
        if (categories.Count > 0)
        {
            await SelectCategory(categories[0]);
        }
    }

    private System.Threading.CancellationTokenSource? _searchDebounce;

    private async Task OnSearchInput()
    {
        _searchDebounce?.Cancel();
        _searchDebounce = new System.Threading.CancellationTokenSource();
        var token = _searchDebounce.Token;
        
        showManagerPanel = false; // Hide manager panel on search

        await Task.Delay(300, token).ContinueWith(async t =>
        {
            if (t.IsCanceled) return;
            await InvokeAsync(async () =>
            {
                await RunSearch();
                StateHasChanged();
            });
        });
    }

    private async Task RunSearch()
    {
        if (string.IsNullOrWhiteSpace(searchKeyword)) return;
        isSearching = true;
        StateHasChanged();

        var result = await ConciergeService.SearchByKeywordAsync(searchKeyword);
        searchResults = (result.Success && result.Rule != null)
            ? new List<ConciergeRule> { result.Rule }
            : new List<ConciergeRule>();

        isSearching = false;
    }

    private async Task SelectCategory(string category)
    {
        searchKeyword = "";
        showManagerPanel = false;
        activeCategory = category;
        categoryRules = await ConciergeService.GetByCategoryAsync(category);
    }

    private void ClearSearch()
    {
        searchKeyword = "";
        searchResults.Clear();
        if (!string.IsNullOrEmpty(activeCategory))
        {
            _ = SelectCategory(activeCategory);
        }
    }

    private void ToggleManagerPanel()
    {
        showManagerPanel = !showManagerPanel;
        if (showManagerPanel)
        {
            searchKeyword = "";
            activeCategory = "";
        }
        else
        {
            _ = SelectCategory(categories[0]);
        }
    }

    private async Task CopyToClipboard(string text)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
        copiedRuleId = text.GetHashCode();
        StateHasChanged();
        await Task.Delay(2000);
        copiedRuleId = -1;
        StateHasChanged();
    }

    private async Task AddRule()
    {
        managerMessage = "";
        if (string.IsNullOrWhiteSpace(newRule.Keywords) || string.IsNullOrWhiteSpace(newRule.ResponseText))
        {
            managerMessage = "Keywords and response text are required.";
            managerSuccess = false;
            return;
        }

        newRule.IsActive = true;
        var (success, message) = await ConciergeService.AddRuleAsync(
            newRule.Keywords,
            newRule.Category ?? categories[0],
            newRule.ResponseText,
            newRule.ResponseTemplate ?? "");

        managerMessage = success ? "✅ Response added successfully." : message;
        managerSuccess = success;
        if (success) newRule = new() { Category = categories[0] };
    }

    private string GetCategoryClass(string cat) => cat switch
    {
        "Check-In"     => "cat-checkin",
        "Check-Out"    => "cat-checkout",
        "Cancellation" => "cat-cancel",
        "Breakfast"    => "cat-breakfast",
        "Wi-Fi"        => "cat-wifi",
        "Room Types"   => "cat-rooms",
        "Payments"     => "cat-payments",
        "Amenities"    => "cat-amenities",
        _              => "cat-general"
    };

    private string GetCategoryIcon(string cat) => cat switch
    {
        "Check-In"     => "🛎️",
        "Check-Out"    => "🚪",
        "Cancellation" => "❌",
        "Breakfast"    => "🍳",
        "Wi-Fi"        => "📶",
        "Room Types"   => "🏨",
        "Payments"     => "💳",
        "Amenities"    => "🛁",
        _              => "ℹ️"
    };
}

<style>
    .concierge-container { padding: 2rem; max-width: 1200px; margin: 0 auto; color: #e2e8f0; }
    
    .page-header { margin-bottom: 2rem; }
    .page-title { margin: 0; color: #fff; font-size: 1.8rem; }
    .page-sub { color: #94a3b8; margin: 0.2rem 0 0; font-size: 0.95rem; }

    .concierge-layout { display: grid; grid-template-columns: 280px 1fr; gap: 2rem; align-items: start; }

    /* Left Sidebar */
    .sidebar-col { display: flex; flex-direction: column; gap: 1.5rem; }
    
    .search-box { display: flex; align-items: center; background: #13181f; border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 0.5rem 1rem; gap: 0.5rem; transition: border-color 0.2s, box-shadow 0.2s; }
    .search-box:focus-within { border-color: var(--accent-purple); box-shadow: 0 0 0 2px rgba(187, 134, 252, 0.15); }
    .search-icon { font-size: 1.1rem; opacity: 0.6; }
    .search-input { flex: 1; border: none; outline: none; background: transparent; color: #fff; font-size: 0.95rem; padding: 6px 0; }
    .clear-btn { background: transparent; border: none; color: #94a3b8; cursor: pointer; }

    .section-title { font-size: 0.9rem; color: #94a3b8; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 1rem; font-weight: 700; }
    
    .category-list { display: flex; flex-direction: column; gap: 4px; }
    .cat-pill { display: flex; align-items: center; gap: 10px; background: transparent; border: 1px solid transparent; padding: 10px 14px; border-radius: 8px; color: #cbd5e1; cursor: pointer; font-size: 0.95rem; font-weight: 500; transition: all 0.2s; text-align: left; }
    .cat-pill:hover { background: rgba(255,255,255,0.05); }
    
    .cat-pill.active { background: #13181f; border-color: rgba(255,255,255,0.05); box-shadow: 0 4px 10px rgba(0,0,0,0.2); }
    
    /* Category Colors */
    .cat-checkin.active   { border-left: 3px solid #10b981; color: #fff; }
    .cat-checkout.active  { border-left: 3px solid #f97316; color: #fff; }
    .cat-cancel.active    { border-left: 3px solid #ef4444; color: #fff; }
    .cat-breakfast.active { border-left: 3px solid #f59e0b; color: #fff; }
    .cat-wifi.active      { border-left: 3px solid #8b5cf6; color: #fff; }
    .cat-rooms.active     { border-left: 3px solid #3b82f6; color: #fff; }
    .cat-payments.active  { border-left: 3px solid #14b8a6; color: #fff; }
    .cat-amenities.active { border-left: 3px solid #ec4899; color: #fff; }
    .cat-general.active   { border-left: 3px solid #64748b; color: #fff; }

    .btn-outline-brand { width: 100%; background: transparent; border: 1px solid rgba(187, 134, 252, 0.3); color: var(--accent-purple); padding: 10px; border-radius: 8px; font-weight: 600; cursor: pointer; transition: all 0.2s; margin-top: 1rem; }
    .btn-outline-brand:hover { background: rgba(187, 134, 252, 0.1); }

    /* Right Column: Main Area */
    .main-col { display: flex; flex-direction: column; }
    
    .results-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; padding-bottom: 1rem; border-bottom: 1px solid rgba(255,255,255,0.05); }
    .results-header span { font-size: 1.1rem; color: #e2e8f0; }
    .result-count { background: rgba(255,255,255,0.05); padding: 4px 10px; border-radius: 12px; font-size: 0.8rem !important; color: #94a3b8 !important; font-weight: 600; }

    .rules-list { display: flex; flex-direction: column; gap: 1.2rem; }
    
    .rule-card { background: #13181f; border-radius: 12px; padding: 1.5rem; border: 1px solid rgba(255,255,255,0.05); position: relative; transition: transform 0.2s; }
    .rule-card:hover { border-color: rgba(255,255,255,0.1); transform: translateY(-2px); box-shadow: 0 8px 20px rgba(0,0,0,0.3); }
    
    .rule-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
    .cat-badge { padding: 4px 10px; border-radius: 6px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; background: rgba(255,255,255,0.05); }
    .keywords-label { font-size: 0.8rem; color: #64748b; }
    
    .rule-text { color: #cbd5e1; line-height: 1.6; font-size: 0.95rem; white-space: pre-wrap; }
    
    .btn-copy { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: #cbd5e1; padding: 6px 12px; border-radius: 6px; font-size: 0.8rem; cursor: pointer; transition: all 0.2s; }
    .btn-copy:hover { background: rgba(255,255,255,0.1); color: #fff; }
    
    .toast-success { position: absolute; top: 1.5rem; right: 6rem; background: #10b981; color: white; padding: 6px 12px; border-radius: 6px; font-size: 0.8rem; font-weight: 600; animation: fadein 0.3s; }
    @@keyframes fadein { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }

    /* Manager Panel */
    .glass-panel { background: #13181f; border-radius: 16px; border: 1px solid rgba(255,255,255,0.05); padding: 2rem; box-shadow: 0 10px 30px rgba(0,0,0,0.5); }
    .panel-title { color: #fff; margin: 0 0 1.5rem; border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 1rem; }
    
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    .form-group { display: flex; flex-direction: column; gap: 6px; }
    .form-group.full-width { grid-column: 1 / -1; }
    .form-group label { font-size: 0.85rem; color: #94a3b8; font-weight: 600; }
    input, select, textarea { background: #1e2430; border: 1px solid #334155; color: #fff; padding: 10px 14px; border-radius: 8px; font-size: 0.95rem; transition: border-color 0.2s; }
    input:focus, select:focus, textarea:focus { outline: none; border-color: var(--accent-purple); box-shadow: 0 0 0 2px rgba(187, 134, 252, 0.2); }
    
    .form-actions { margin-top: 1.5rem; }
    .btn-primary { background: rgba(187, 134, 252, 0.15); color: var(--accent-purple); border: 1px solid rgba(187, 134, 252, 0.3); padding: 10px 20px; border-radius: 8px; font-weight: 600; cursor: pointer; transition: all 0.2s; }
    .btn-primary:hover { background: rgba(187, 134, 252, 0.25); box-shadow: 0 0 15px rgba(187, 134, 252, 0.2); }
    
    .alert { padding: 12px 16px; border-radius: 8px; margin-top: 1rem; font-size: 0.9rem; }
    .alert-success { background: rgba(16, 185, 129, 0.1); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.2); }
    .alert-danger { background: rgba(239, 68, 68, 0.1); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.2); }

    .loading-state, .empty-state { text-align: center; padding: 4rem 2rem; color: #64748b; background: #13181f; border-radius: 12px; border: 1px dashed rgba(255,255,255,0.1); }
    .empty-state.subtle { background: transparent; border: none; }
    .empty-icon { font-size: 3rem; display: block; margin-bottom: 1rem; opacity: 0.5; }

    @@media (max-width: 900px) {
        .concierge-layout { grid-template-columns: 1fr; }
        .category-list { flex-direction: row; flex-wrap: wrap; }
        .cat-pill { padding: 6px 12px; font-size: 0.85rem; }
    }
</style>

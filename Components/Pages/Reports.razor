@page "/reports"
@using LodgeStay.Services
@using LodgeStay.Models
@inject ReportService ReportService
@inject SessionService SessionService
@inject IJSRuntime JS
@inject NavigationManager Navigation

<div class="analytics-container">
    @if (!isAuthorized)
    {
        <div class="alert-glass warning">
            <span class="icon">🔒</span>
            <div class="text">
                <strong>Access Restricted</strong>
                <p>You must be logged in as a Manager or Owner to access the analytics generator.</p>
            </div>
        </div>
    }
    else
    {
        <div class="wizard-grid">
            
            <!-- Step 1: Select Type -->
            <div class="wizard-col">
                <div class="step-header">
                    <div class="step-num">1</div>
                    <h3 class="step-title">Select Data Set</h3>
                </div>
                
                <div class="type-list">
                    @foreach (var type in reportTypes)
                    {
                        <button class="type-card @(selectedType == type.Key ? "active" : "")"
                                @onclick="() => selectedType = type.Key">
                            <div class="t-icon">@type.Icon</div>
                            <div class="t-info">
                                <span class="t-name">@type.Name</span>
                                <span class="t-desc">@type.Description</span>
                            </div>
                            <div class="t-radio"></div>
                        </button>
                    }
                </div>
            </div>

            <!-- Step 2: Date Range -->
            <div class="wizard-col">
                <div class="step-header">
                    <div class="step-num">2</div>
                    <h3 class="step-title">Define Timeline</h3>
                </div>

                <div class="glass-panel date-panel">
                    <div class="date-inputs">
                        <div class="form-group">
                            <label>Start Date</label>
                            <input type="date" class="glass-input" @bind="startDate" max="@endDate.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="form-group">
                            <label>End Date</label>
                            <input type="date" class="glass-input" @bind="endDate" min="@startDate.ToString("yyyy-MM-dd")" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>
                    </div>

                    <div class="quick-ranges">
                        <label>Quick Select:</label>
                        <div class="range-pills">
                            <button class="pill-btn" @onclick='() => SetRange(7)'>7 Days</button>
                            <button class="pill-btn" @onclick='() => SetRange(30)'>30 Days</button>
                            <button class="pill-btn" @onclick='() => SetRange(90)'>90 Days</button>
                            <button class="pill-btn" @onclick="SetThisMonth">This Month</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Step 3: Generate & History -->
            <div class="wizard-col">
                <div class="step-header">
                    <div class="step-num">3</div>
                    <h3 class="step-title">Generate Report</h3>
                </div>

                <div class="glass-panel generate-panel">
                    <div class="gen-summary">
                        <div class="s-row">
                            <span>Target:</span>
                            <strong>@(reportTypes.FirstOrDefault(r => r.Key == selectedType)?.Name ?? "—")</strong>
                        </div>
                        <div class="s-row">
                            <span>Period:</span>
                            <strong>@startDate.ToString("MMM dd") – @endDate.ToString("MMM dd, yyyy")</strong>
                        </div>
                    </div>

                    <button class="btn-generate" @onclick="GenerateReport" disabled="@isGenerating">
                        @if (isGenerating)
                        {
                            <span class="spinner"></span>
                            <span>Crunching data...</span>
                        }
                        else
                        {
                            <span class="icon">⚡</span>
                            <span>Generate CSV Report</span>
                        }
                    </button>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="toast-error mt-1">@errorMessage</div>
                    }

                    @if (pdfReady)
                    {
                        <div class="result-box">
                            <div class="r-top">
                                <span class="r-icon">✅</span>
                                <div>
                                    <span class="r-title">Report Ready</span>
                                    <span class="r-size">~@estimatedSizeKb KB</span>
                                </div>
                            </div>
                            
                            <div class="r-actions">
                                <button class="btn-download" @onclick="DownloadPdf">⬇️ Download</button>
                                @if (isMaui)
                                {
                                    <button class="btn-share" @onclick="SharePdf">📤 Share</button>
                                }
                            </div>
                        </div>
                    }
                </div>

                <!-- History -->
                @if (recentReports.Count > 0)
                {
                    <div class="history-panel">
                        <h4 class="history-title">Recent Exports</h4>
                        <div class="history-list">
                            @foreach (var report in recentReports)
                            {
                                <div class="h-row">
                                    <span class="h-icon">@GetTypeIcon(report.Type)</span>
                                    <div class="h-info">
                                        <span class="h-name">@report.FileName</span>
                                        <span class="h-time">@report.GeneratedAt.ToString("HH:mm · dd MMM")</span>
                                    </div>
                                    <button class="btn-icon-only" @onclick="() => RedownloadReport(report)">⬇️</button>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

        </div>
    }
</div>

@code {
    private bool isAuthorized = false;
    private bool isGenerating = false;
    private bool pdfReady = false;
    private bool isMaui = false;

    private string selectedType = "Occupancy";
    private DateTime startDate = DateTime.Today.AddDays(-30);
    private DateTime endDate = DateTime.Today;

    private byte[]? pdfBytes;
    private string generatedFileName = "";
    private string errorMessage = "";
    private int estimatedSizeKb = 0;

    private List<ReportHistoryItem> recentReports = new();

    private readonly List<ReportTypeOption> reportTypes = new()
    {
        new() { Key = "Occupancy", Name = "Occupancy Report", Icon = "🏨", Description = "Room status and utilisation trends" },
        new() { Key = "Revenue",   Name = "Revenue Report",   Icon = "💰", Description = "Earnings and per-room breakdown" },
        new() { Key = "Loyalty",   Name = "Loyalty Report",   Icon = "⭐", Description = "Points distributed and redeemed" },
        new() { Key = "Eco",       Name = "Eco Impact Report",Icon = "🌿", Description = "EcoStay participation and savings" },
    };

    protected override Task OnInitializedAsync()
    {
        var user = SessionService.CurrentUser;
        isAuthorized = user != null && (user.Role == "Manager" || user.Role == "Owner");
        isMaui = false;
        return Task.CompletedTask;
    }

    private async Task GenerateReport()
    {
        if (string.IsNullOrEmpty(selectedType)) return;
        errorMessage = "";
        pdfReady = false;
        isGenerating = true;

        try
        {
            pdfBytes = await ReportService.GenerateReportAsync(selectedType, startDate, endDate);

            if (pdfBytes == null || pdfBytes.Length == 0)
            {
                errorMessage = "No data available for the selected period. Please choose a different date range.";
            }
            else
            {
                generatedFileName = $"LodgeStay_{selectedType}Report_{startDate:yyyyMMdd}_{endDate:yyyyMMdd}.csv";
                estimatedSizeKb = pdfBytes.Length / 1024;
                pdfReady = true;

                recentReports.Insert(0, new ReportHistoryItem
                {
                    Type = selectedType,
                    FileName = generatedFileName,
                    GeneratedAt = DateTime.Now,
                    Data = pdfBytes
                });
                if (recentReports.Count > 5) recentReports.RemoveAt(5);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Report generation failed. Please try again. ({ex.Message})";
        }

        isGenerating = false;
    }

    private async Task DownloadPdf()
    {
        if (pdfBytes == null) return;
        var base64 = Convert.ToBase64String(pdfBytes);
        await JS.InvokeVoidAsync("downloadFileFromBase64", generatedFileName, "text/csv", base64);
    }

    private async Task SharePdf()
    {
        if (pdfBytes == null) return;
        var tempPath = Path.Combine(FileSystem.CacheDirectory, generatedFileName);
        await File.WriteAllBytesAsync(tempPath, pdfBytes);
        await Share.RequestAsync(new ShareFileRequest
        {
            Title = generatedFileName,
            File = new ShareFile(tempPath, "application/pdf")
        });
    }

    private async Task RedownloadReport(ReportHistoryItem report)
    {
        pdfBytes = report.Data;
        generatedFileName = report.FileName;
        pdfReady = true;
        await DownloadPdf();
    }

    private void SetRange(int days)
    {
        endDate = DateTime.Today;
        startDate = DateTime.Today.AddDays(-days + 1);
    }

    private void SetThisMonth()
    {
        startDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        endDate = DateTime.Today;
    }

    private string GetTypeIcon(string type) => type switch
    {
        "Occupancy" => "🏨",
        "Revenue"   => "💰",
        "Loyalty"   => "⭐",
        "Eco"       => "🌿",
        _           => "📄"
    };

    private class ReportTypeOption
    {
        public string Key         { get; set; } = "";
        public string Name        { get; set; } = "";
        public string Icon        { get; set; } = "";
        public string Description { get; set; } = "";
    }

    private class ReportHistoryItem
    {
        public string   Type        { get; set; } = "";
        public string   FileName    { get; set; } = "";
        public DateTime GeneratedAt { get; set; }
        public byte[]   Data        { get; set; } = Array.Empty<byte>();
    }
}

<style>
    .analytics-container { padding: 2rem; max-width: 1300px; margin: 0 auto; color: #e2e8f0; font-family: 'Inter', sans-serif; }

    .page-header { margin-bottom: 3rem; text-align: center; }
    .page-title { font-size: 2.2rem; font-weight: 800; color: #fff; margin: 0 0 0.5rem 0; letter-spacing: -0.5px; }
    .page-sub { color: #94a3b8; font-size: 1.05rem; margin: 0; }

    .alert-glass { display: flex; align-items: flex-start; gap: 1rem; padding: 1.5rem; border-radius: 12px; background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.3); max-width: 600px; margin: 0 auto; }
    .alert-glass .icon { font-size: 2rem; }
    .alert-glass strong { display: block; color: #fcd34d; font-size: 1.1rem; margin-bottom: 0.3rem; }
    .alert-glass p { margin: 0; color: #fde68a; font-size: 0.95rem; }

    /* Wizard Grid */
    .wizard-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 2rem; align-items: start; }
    
    .wizard-col { display: flex; flex-direction: column; gap: 1.5rem; }

    .step-header { display: flex; align-items: center; gap: 0.8rem; border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 1rem; }
    .step-num { width: 28px; height: 28px; background: var(--accent-purple); color: #000; border-radius: 50%; display: flex; justify-content: center; align-items: center; font-weight: 800; font-size: 0.9rem; }
    .step-title { margin: 0; font-size: 1.2rem; font-weight: 600; color: #fff; }

    /* Glass Panels */
    .glass-panel { background: #13181f; border-radius: 16px; border: 1px solid rgba(255,255,255,0.05); padding: 1.8rem; box-shadow: 0 8px 30px rgba(0,0,0,0.3); }

    /* Type List */
    .type-list { display: flex; flex-direction: column; gap: 0.8rem; }
    .type-card { display: flex; align-items: center; gap: 1.2rem; background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); padding: 1.2rem; border-radius: 12px; cursor: pointer; text-align: left; transition: all 0.2s; }
    .type-card:hover { background: rgba(255,255,255,0.04); transform: translateX(5px); }
    .type-card.active { background: rgba(187, 134, 252, 0.1); border-color: var(--accent-purple); box-shadow: 0 4px 20px rgba(187, 134, 252, 0.15); }
    
    .t-icon { font-size: 1.8rem; background: rgba(255,255,255,0.05); width: 48px; height: 48px; border-radius: 12px; display: flex; justify-content: center; align-items: center; }
    .t-info { flex: 1; display: flex; flex-direction: column; gap: 0.2rem; }
    .t-name { font-weight: 700; color: #fff; font-size: 1.05rem; }
    .t-desc { font-size: 0.8rem; color: #94a3b8; }
    
    .t-radio { width: 20px; height: 20px; border-radius: 50%; border: 2px solid #64748b; transition: all 0.2s; }
    .type-card.active .t-radio { border-color: var(--accent-purple); border-width: 6px; }

    /* Date Panel */
    .date-panel { display: flex; flex-direction: column; gap: 2rem; }
    .date-inputs { display: flex; flex-direction: column; gap: 1rem; }
    .form-group { display: flex; flex-direction: column; gap: 0.5rem; }
    .form-group label { font-size: 0.85rem; color: #94a3b8; font-weight: 600; text-transform: uppercase; letter-spacing: 1px; }
    .glass-input { width: 100%; background: #1e2430; border: 1px solid rgba(255,255,255,0.1); color: #fff; padding: 0.9rem; border-radius: 10px; font-size: 1rem; font-family: inherit; transition: all 0.2s; }
    .glass-input:focus { outline: none; border-color: var(--accent-purple); box-shadow: 0 0 0 2px rgba(187, 134, 252, 0.2); }
    
    /* For WebKit (Chrome/Edge) to invert calendar icon in dark mode */
    ::-webkit-calendar-picker-indicator { filter: invert(1); cursor: pointer; opacity: 0.6; }
    ::-webkit-calendar-picker-indicator:hover { opacity: 1; }

    .quick-ranges { display: flex; flex-direction: column; gap: 0.8rem; }
    .quick-ranges label { font-size: 0.85rem; color: #94a3b8; }
    .range-pills { display: flex; flex-wrap: wrap; gap: 0.5rem; }
    .pill-btn { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: #cbd5e1; padding: 0.5rem 1rem; border-radius: 20px; font-size: 0.8rem; cursor: pointer; transition: all 0.2s; }
    .pill-btn:hover { background: rgba(187, 134, 252, 0.15); color: var(--accent-purple); border-color: rgba(187, 134, 252, 0.3); }

    /* Generate Panel */
    .gen-summary { background: rgba(255,255,255,0.02); border-radius: 10px; padding: 1rem; margin-bottom: 1.5rem; display: flex; flex-direction: column; gap: 0.8rem; border: 1px solid rgba(255,255,255,0.05); }
    .s-row { display: flex; justify-content: space-between; font-size: 0.9rem; }
    .s-row span { color: #94a3b8; }
    .s-row strong { color: #fff; }

    .btn-generate { width: 100%; background: linear-gradient(135deg, var(--accent-purple), #9d4edd); color: #fff; border: none; padding: 1.2rem; border-radius: 12px; font-weight: 700; font-size: 1.1rem; cursor: pointer; display: flex; justify-content: center; align-items: center; gap: 0.8rem; transition: all 0.2s; box-shadow: 0 4px 15px rgba(187, 134, 252, 0.3); }
    .btn-generate:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(187, 134, 252, 0.5); }
    .btn-generate:disabled { background: rgba(255,255,255,0.1); color: #64748b; box-shadow: none; cursor: not-allowed; }
    
    .spinner { width: 20px; height: 20px; border: 3px solid rgba(255,255,255,0.3); border-top-color: #fff; border-radius: 50%; animation: spin 0.8s linear infinite; }
    @@keyframes spin { to { transform: rotate(360deg); } }

    .toast-error { padding: 0.8rem; background: rgba(239, 68, 68, 0.1); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.2); border-radius: 8px; font-size: 0.9rem; text-align: center; }
    .mt-1 { margin-top: 1rem; }

    .result-box { margin-top: 1.5rem; padding: 1.2rem; background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.2); border-radius: 12px; animation: slideIn 0.3s ease-out; }
    @@keyframes slideIn { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }
    
    .r-top { display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem; }
    .r-icon { font-size: 2rem; }
    .r-title { display: block; font-weight: 700; color: #10b981; font-size: 1.1rem; }
    .r-size { color: #059669; font-size: 0.85rem; }
    
    .r-actions { display: flex; gap: 0.8rem; }
    .btn-download { flex: 1; background: #10b981; color: #000; border: none; padding: 0.8rem; border-radius: 8px; font-weight: 600; cursor: pointer; transition: all 0.2s; }
    .btn-download:hover { background: #059669; }
    .btn-share { flex: 1; background: transparent; border: 1px solid #10b981; color: #10b981; padding: 0.8rem; border-radius: 8px; font-weight: 600; cursor: pointer; transition: all 0.2s; }
    .btn-share:hover { background: rgba(16, 185, 129, 0.1); }

    /* History Panel */
    .history-panel { margin-top: 1rem; }
    .history-title { font-size: 0.95rem; color: #94a3b8; margin: 0 0 1rem 0; text-transform: uppercase; letter-spacing: 1px; border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 0.5rem; }
    .history-list { display: flex; flex-direction: column; gap: 0.5rem; }
    .h-row { display: flex; align-items: center; gap: 1rem; padding: 0.8rem; background: rgba(255,255,255,0.02); border-radius: 10px; transition: background 0.2s; }
    .h-row:hover { background: rgba(255,255,255,0.05); }
    .h-icon { font-size: 1.5rem; }
    .h-info { flex: 1; display: flex; flex-direction: column; }
    .h-name { font-size: 0.85rem; font-weight: 600; color: #cbd5e1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 180px; }
    .h-time { font-size: 0.75rem; color: #64748b; margin-top: 2px; }
    .btn-icon-only { background: transparent; border: 1px solid rgba(255,255,255,0.1); color: #fff; width: 32px; height: 32px; border-radius: 6px; cursor: pointer; display: flex; justify-content: center; align-items: center; transition: all 0.2s; }
    .btn-icon-only:hover { background: rgba(255,255,255,0.1); }

    @@media (max-width: 1024px) {
        .wizard-grid { grid-template-columns: 1fr; gap: 3rem; }
        .wizard-col { max-width: 600px; margin: 0 auto; width: 100%; }
    }
</style>

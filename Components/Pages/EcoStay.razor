@page "/ecostay"
@page "/ecostay/{GuestId:int}/{ReservationId:int}"
@using LodgeStay.Services
@using LodgeStay.Models
@using LodgeStay.Components.Layout
@inject EcoStayService EcoStayService
@inject GuestService GuestService
@inject SessionService SessionService
@inject NavigationManager Navigation

<div class="eco-container">
    <!-- Inner Tab Bar -->
    <div class="eco-tab-bar">
        <button class="eco-tab-btn @(activeTab == "guest" ? "active" : "")" @onclick='() => SetTab("guest")'>Guest Opt-In</button>
        <button class="eco-tab-btn @(activeTab == "stats" ? "active" : "")" @onclick='() => SetTab("stats")'>My Eco Stats</button>
        @if (isManager)
        {
            <button class="eco-tab-btn @(activeTab == "manager" ? "active" : "")" @onclick='() => SetTab("manager")'>Property View</button>
        }
    </div>

    <div class="glass-panel eco-content-panel">
        
        <!-- ── TAB 1: Guest Eco-Action Opt-In ── -->
        @if (activeTab == "guest")
        {
            <div class="eco-intro-banner">
                <span class="eco-pill">🌍 Sustainable Stay</span>
                <div class="eco-intro-text">
                    <strong>Earn Eco-Points</strong>
                    <span>Choose eco-friendly actions during your stay and earn points for each one.</span>
                </div>
            </div>

            <div class="form-grid lookup-grid">
                <div class="form-group">
                    <label>Guest ID</label>
                    <input type="number" class="form-control" @bind="lookupGuestId" placeholder="Enter ID" />
                </div>
                <div class="form-group">
                    <label>Reservation ID</label>
                    <input type="number" class="form-control" @bind="lookupReservationId" placeholder="Enter ID" />
                </div>
                <div class="form-group btn-group">
                    <button class="btn-primary" @onclick="LoadGuestEcoPanel">Load Profile</button>
                </div>
            </div>

            @if (guestLoaded)
            {
                <div class="guest-info-bar">
                    <div class="guest-meta">
                        <span class="avatar-sm">@currentGuest!.Name.Substring(0,1).ToUpper()</span>
                        <span class="guest-name">@currentGuest.Name</span>
                    </div>
                    <span class="points-badge">🌿 @currentGuest.EcoPoints pts</span>
                </div>

                <div class="actions-list">
                    @foreach (var action in ecoActions)
                    {
                        <div class="action-card @(action.IsRecorded ? "recorded" : "")">
                            <div class="action-icon">@action.Icon</div>
                            <div class="action-details">
                                <span class="action-name">@action.Name</span>
                                <span class="action-desc">@action.Description</span>
                            </div>
                            <div class="action-trailing">
                                <span class="action-reward">+@action.Points pts</span>
                                @if (action.IsRecorded)
                                {
                                    <span class="status-label">✅ Recorded</span>
                                }
                                else
                                {
                                    <button class="btn-eco" @onclick="() => RecordAction(action)" disabled="@action.IsLoading">
                                        @(action.IsLoading ? "..." : "Opt In")
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(actionMessage))
                {
                    <div class="alert @(actionSuccess ? "alert-success" : "alert-danger")">
                        @actionMessage
                    </div>
                }
            }
        }

        <!-- ── TAB 2: Guest Eco Stats ── -->
        @if (activeTab == "stats")
        {
            <h3 class="section-title">Your Eco Impact</h3>

            @if (ecoStats == null)
            {
                <div class="loading-state">Loading your eco stats...</div>
            }
            else
            {
                <div class="stats-grid">
                    <div class="stat-card green">
                        <div class="stat-icon">🌿</div>
                        <div class="stat-info">
                            <span class="stat-val">@ecoStats.TotalEcoPoints</span>
                            <span class="stat-lbl">Points Earned</span>
                        </div>
                    </div>
                    <div class="stat-card blue">
                        <div class="stat-icon">🚿</div>
                        <div class="stat-info">
                            <span class="stat-val">@ecoStats.WaterSavedLitres <small>L</small></span>
                            <span class="stat-lbl">Water Saved</span>
                        </div>
                    </div>
                    <div class="stat-card teal">
                        <div class="stat-icon">♻️</div>
                        <div class="stat-info">
                            <span class="stat-val">@ecoStats.ActionsCompleted</span>
                            <span class="stat-lbl">Actions Done</span>
                        </div>
                    </div>
                    <div class="stat-card brown">
                        <div class="stat-icon">🌱</div>
                        <div class="stat-info">
                            <span class="stat-val">@ecoStats.CO2SavedKg <small>kg</small></span>
                            <span class="stat-lbl">CO₂ Offset</span>
                        </div>
                    </div>
                </div>

                <div class="impact-note">
                    💡 Your participation is equivalent to saving <strong>@ecoStats.WaterSavedLitres litres</strong> of water and offsetting <strong>@ecoStats.CO2SavedKg kg</strong> of CO₂ this stay!
                </div>

                <div class="history-section">
                    <h4 class="sub-section-title">Action History</h4>
                    @if (ecoStats.Actions.Count == 0)
                    {
                        <div class="empty-state">No actions recorded yet.</div>
                    }
                    else
                    {
                        <div class="history-list">
                            @foreach (var a in ecoStats.Actions)
                            {
                                <div class="history-item">
                                    <span class="hist-action">@GetActionIcon(a.ActionType) @a.ActionType</span>
                                    <span class="hist-points">+@a.PointsAwarded pts</span>
                                    <span class="hist-date">@a.RecordedAt.ToString("dd MMM yyyy")</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        }

        <!-- ── TAB 3: Manager Property Aggregate ── -->
        @if (activeTab == "manager" && isManager)
        {
            <h3 class="section-title">🏨 Property Eco Summary</h3>

            @if (propertyAggregate == null)
            {
                <div class="loading-state">Loading property data...</div>
            }
            else
            {
                <div class="stats-grid">
                    <div class="stat-card teal">
                        <div class="stat-icon">👥</div>
                        <div class="stat-info">
                            <span class="stat-val">@propertyAggregate.TotalParticipants</span>
                            <span class="stat-lbl">Participants</span>
                        </div>
                    </div>
                    <div class="stat-card green">
                        <div class="stat-icon">🌿</div>
                        <div class="stat-info">
                            <span class="stat-val">@propertyAggregate.TotalEcoPoints</span>
                            <span class="stat-lbl">Total Points</span>
                        </div>
                    </div>
                    <div class="stat-card blue">
                        <div class="stat-icon">🚿</div>
                        <div class="stat-info">
                            <span class="stat-val">@propertyAggregate.TotalWaterSaved <small>L</small></span>
                            <span class="stat-lbl">Water Saved</span>
                        </div>
                    </div>
                    <div class="stat-card brown">
                        <div class="stat-icon">♻️</div>
                        <div class="stat-info">
                            <span class="stat-val">@propertyAggregate.TotalActionsRecorded</span>
                            <span class="stat-lbl">Actions Recorded</span>
                        </div>
                    </div>
                </div>

                <div class="history-section mt-2">
                    <h4 class="sub-section-title">Action Breakdown</h4>
                    <table class="dark-table">
                        <thead>
                            <tr>
                                <th>Action Type</th>
                                <th>Times Recorded</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in propertyAggregate.ActionBreakdown)
                            {
                                <tr>
                                    <td>@GetActionIcon(row.Key) @row.Key</td>
                                    <td><span class="badge-count">@row.Value</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter] public int GuestId { get; set; }
    [Parameter] public int ReservationId { get; set; }

    private string activeTab = "guest";
    private bool isManager = false;
    private bool guestLoaded = false;

    private int lookupGuestId;
    private int lookupReservationId;

    private GuestProfile? currentGuest;
    private GuestEcoStats? ecoStats;
    private PropertyEcoAggregate? propertyAggregate;

    private string actionMessage = "";
    private bool actionSuccess = false;

    private List<EcoActionOption> ecoActions = new()
    {
        new() { ActionType = "TowelReuse",         Icon = "🛁", Name = "Towel Reuse",         Description = "Reuse your towels instead of requesting fresh ones daily.", Points = 10 },
        new() { ActionType = "SkipHousekeeping",   Icon = "🧹", Name = "Skip Housekeeping",   Description = "Opt out of daily room cleaning to conserve water and energy.", Points = 20 },
        new() { ActionType = "DigitalReceipt",     Icon = "📧", Name = "Digital Receipt Only", Description = "Receive your invoice by email instead of a printed copy.", Points = 5  },
    };

    protected override async Task OnInitializedAsync()
    {
        var user = SessionService.CurrentUser;
        isManager = user != null && (user.Role == "Manager" || user.Role == "Owner");

        if (GuestId > 0 && ReservationId > 0)
        {
            lookupGuestId = GuestId;
            lookupReservationId = ReservationId;
            await LoadGuestEcoPanel();
        }

        if (isManager)
            propertyAggregate = await EcoStayService.GetPropertyEcoAggregateAsync();

        var currentUserId = user?.User_ID ?? 0;
        if (currentUserId > 0)
            ecoStats = await EcoStayService.GetGuestEcoStatsAsync(currentUserId);
    }

    private async Task LoadGuestEcoPanel()
    {
        if (lookupGuestId <= 0 || lookupReservationId <= 0) return;

        currentGuest = await GuestService.GetGuestByIdAsync(lookupGuestId);
        if (currentGuest == null) return;

        var recordedActions = await EcoStayService.GetRecordedActionsAsync(lookupGuestId, lookupReservationId);
        var recordedTypes = recordedActions.Select(a => a.ActionType).ToHashSet();

        foreach (var a in ecoActions)
            a.IsRecorded = recordedTypes.Contains(a.ActionType);

        guestLoaded = true;
        ecoStats = await EcoStayService.GetGuestEcoStatsAsync(lookupGuestId);
    }

    private async Task RecordAction(EcoActionOption action)
    {
        action.IsLoading = true;
        actionMessage = "";
        StateHasChanged();

        var result = await EcoStayService.RecordActionAsync(lookupGuestId, lookupReservationId, action.ActionType);

        if (result.Success)
        {
            action.IsRecorded = true;
            currentGuest!.EcoPoints += action.Points;
            ecoStats = await EcoStayService.GetGuestEcoStatsAsync(lookupGuestId);
            actionMessage = $"✅ {action.Name} recorded! +{action.Points} eco-points awarded.";
            actionSuccess = true;
        }
        else
        {
            actionMessage = result.Message ?? "Failed to record action.";
            actionSuccess = false;
        }

        action.IsLoading = false;
    }

    private void SetTab(string tab) => activeTab = tab;

    private string GetActionIcon(string actionType) => actionType switch
    {
        "TowelReuse"       => "🛁",
        "SkipHousekeeping" => "🧹",
        "DigitalReceipt"   => "📧",
        _                  => "🌿"
    };

    private class EcoActionOption
    {
        public string ActionType { get; set; } = "";
        public string Icon       { get; set; } = "";
        public string Name       { get; set; } = "";
        public string Description{ get; set; } = "";
        public int    Points     { get; set; }
        public bool   IsRecorded { get; set; }
        public bool   IsLoading  { get; set; }
    }
}

<style>
    .eco-container { padding: 2rem; max-width: 900px; margin: 0 auto; color: #e2e8f0; }
    
    .page-header { margin-bottom: 2rem; }
    .page-title { margin: 0; color: #fff; font-size: 1.8rem; }
    .page-sub { color: #94a3b8; margin: 0.2rem 0 0; font-size: 0.95rem; }

    /* Inner Tab Bar */
    .eco-tab-bar { display: flex; gap: 1rem; border-bottom: 1px solid rgba(255,255,255,0.05); margin-bottom: 1.5rem; }
    .eco-tab-btn { background: transparent; border: none; color: #64748b; padding: 12px 20px; font-size: 1rem; font-weight: 600; cursor: pointer; border-bottom: 3px solid transparent; transition: all 0.2s; margin-bottom: -1px; }
    .eco-tab-btn:hover { color: #cbd5e1; }
    .eco-tab-btn.active { color: #10b981; border-bottom-color: #10b981; }

    /* Content Panel */
    .eco-content-panel { background: #13181f; border-radius: 16px; border: 1px solid rgba(255,255,255,0.05); padding: 2rem; box-shadow: 0 10px 30px rgba(0,0,0,0.3); }

    /* Intro Banner */
    .eco-intro-banner { background: rgba(16, 185, 129, 0.05); border: 1px solid rgba(16, 185, 129, 0.2); border-radius: 12px; padding: 1.2rem; display: flex; align-items: center; gap: 1.5rem; margin-bottom: 2rem; }
    .eco-pill { background: #10b981; color: #fff; padding: 6px 14px; border-radius: 20px; font-weight: 700; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px; white-space: nowrap; }
    .eco-intro-text { display: flex; flex-direction: column; gap: 4px; }
    .eco-intro-text strong { color: #10b981; font-size: 1.05rem; }
    .eco-intro-text span { color: #94a3b8; font-size: 0.9rem; }

    /* Forms */
    .lookup-grid { display: grid; grid-template-columns: 1fr 1fr auto; gap: 1rem; align-items: end; margin-bottom: 2rem; }
    .form-group { display: flex; flex-direction: column; gap: 6px; }
    .form-group label { font-size: 0.85rem; color: #94a3b8; font-weight: 600; }
    .form-control { background: #1e2430; border: 1px solid #334155; color: #fff; padding: 10px 14px; border-radius: 8px; font-size: 0.95rem; transition: border-color 0.2s; }
    .form-control:focus { outline: none; border-color: #10b981; box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.2); }
    .btn-primary { background: rgba(16, 185, 129, 0.15); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.3); padding: 10px 20px; border-radius: 8px; font-weight: 600; cursor: pointer; transition: all 0.2s; height: 41px; }
    .btn-primary:hover { background: rgba(16, 185, 129, 0.25); box-shadow: 0 0 15px rgba(16, 185, 129, 0.2); }

    /* Guest Profile Strip */
    .guest-info-bar { background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); border-radius: 12px; padding: 1rem 1.5rem; display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
    .guest-meta { display: flex; align-items: center; gap: 1rem; }
    .avatar-sm { width: 36px; height: 36px; background: rgba(187, 134, 252, 0.15); color: var(--accent-purple); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.9rem; }
    .guest-name { font-weight: 600; color: #fff; font-size: 1.1rem; }
    .points-badge { background: #10b981; color: #fff; padding: 6px 12px; border-radius: 20px; font-size: 0.85rem; font-weight: 700; }

    /* Action Cards */
    .actions-list { display: flex; flex-direction: column; gap: 1rem; }
    .action-card { display: flex; align-items: center; gap: 1.5rem; background: #1e2430; border: 1px solid rgba(255,255,255,0.05); padding: 1.2rem; border-radius: 12px; transition: all 0.2s; }
    .action-card:hover { border-color: rgba(16, 185, 129, 0.3); }
    .action-card.recorded { background: rgba(16, 185, 129, 0.05); border-color: rgba(16, 185, 129, 0.2); }
    
    .action-icon { font-size: 2rem; background: rgba(255,255,255,0.05); width: 50px; height: 50px; display: flex; align-items: center; justify-content: center; border-radius: 10px; }
    .action-details { flex: 1; display: flex; flex-direction: column; gap: 4px; }
    .action-name { color: #fff; font-weight: 600; font-size: 1.05rem; }
    .action-desc { color: #94a3b8; font-size: 0.85rem; line-height: 1.4; }
    
    .action-trailing { display: flex; flex-direction: column; align-items: flex-end; gap: 8px; min-width: 100px; }
    .action-reward { color: #10b981; font-weight: 700; font-size: 0.9rem; }
    .btn-eco { background: #10b981; color: #fff; border: none; padding: 6px 16px; border-radius: 6px; font-weight: 600; cursor: pointer; transition: all 0.2s; width: 100%; }
    .btn-eco:hover:not(:disabled) { background: #059669; transform: translateY(-2px); box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3); }
    .btn-eco:disabled { opacity: 0.5; cursor: not-allowed; }
    .status-label { color: #10b981; font-weight: 600; font-size: 0.9rem; }

    /* Alerts */
    .alert { padding: 12px 16px; border-radius: 8px; margin-top: 1.5rem; font-size: 0.9rem; font-weight: 500; }
    .alert-success { background: rgba(16, 185, 129, 0.1); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.2); }
    .alert-danger { background: rgba(239, 68, 68, 0.1); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.2); }

    /* Stats Section */
    .section-title { color: #fff; font-size: 1.2rem; margin: 0 0 1.5rem; }
    .sub-section-title { color: #cbd5e1; font-size: 1rem; margin: 0 0 1rem; }
    
    .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1.2rem; margin-bottom: 2rem; }
    .stat-card { display: flex; align-items: center; gap: 1rem; background: #1e2430; border: 1px solid rgba(255,255,255,0.05); padding: 1.2rem; border-radius: 12px; transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
    .stat-card:hover { transform: translateY(-5px); border-color: rgba(255,255,255,0.1); }
    
    .stat-icon { font-size: 1.8rem; }
    .stat-info { display: flex; flex-direction: column; }
    .stat-val { font-size: 1.4rem; font-weight: 800; color: #fff; line-height: 1.2; }
    .stat-val small { font-size: 0.8rem; color: #94a3b8; font-weight: 600; }
    .stat-lbl { font-size: 0.75rem; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px; margin-top: 2px; }
    
    .stat-card.green { border-left: 3px solid #10b981; }
    .stat-card.blue { border-left: 3px solid #3b82f6; }
    .stat-card.teal { border-left: 3px solid #14b8a6; }
    .stat-card.brown { border-left: 3px solid #d97706; }

    .impact-note { background: rgba(16, 185, 129, 0.05); border-left: 4px solid #10b981; padding: 1rem 1.5rem; border-radius: 0 8px 8px 0; color: #cbd5e1; font-size: 0.95rem; margin-bottom: 2rem; }
    .impact-note strong { color: #10b981; }

    /* History & Table */
    .history-section { margin-top: 2rem; }
    .mt-2 { margin-top: 2rem; }
    .history-list { display: flex; flex-direction: column; border: 1px solid rgba(255,255,255,0.05); border-radius: 12px; overflow: hidden; }
    .history-item { display: flex; justify-content: space-between; align-items: center; padding: 1rem 1.5rem; background: #1e2430; border-bottom: 1px solid rgba(255,255,255,0.05); font-size: 0.9rem; }
    .history-item:last-child { border-bottom: none; }
    .hist-action { color: #fff; font-weight: 500; }
    .hist-points { color: #10b981; font-weight: 700; background: rgba(16, 185, 129, 0.1); padding: 2px 8px; border-radius: 6px; }
    .hist-date { color: #64748b; font-family: monospace; }

    .dark-table { width: 100%; border-collapse: collapse; text-align: left; }
    .dark-table th { background: #1e2430; color: #94a3b8; padding: 12px 16px; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.5px; border-bottom: 1px solid rgba(255,255,255,0.05); border-radius: 8px 8px 0 0; }
    .dark-table td { padding: 12px 16px; color: #cbd5e1; border-bottom: 1px solid rgba(255,255,255,0.05); background: #13181f; }
    .badge-count { background: rgba(255,255,255,0.05); padding: 4px 10px; border-radius: 12px; font-family: monospace; }

    .loading-state, .empty-state { text-align: center; padding: 3rem; color: #64748b; }

    @@media (max-width: 768px) {
        .lookup-grid { grid-template-columns: 1fr; }
        .btn-group { grid-column: 1 / -1; }
        .eco-intro-banner { flex-direction: column; align-items: flex-start; gap: 1rem; }
    }
</style>

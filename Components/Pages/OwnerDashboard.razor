@page "/owner-dashboard"
@using LodgeStay.Services
@using LodgeStay.Models
@inject NavigationManager Navigation
@inject ReportService ReportService
@inject EcoStayService EcoStayService
@inject GuestService GuestService

<div class="dashboard-container">
    <!-- ── LIVE STATS ── -->
    <div class="top-stats-grid">
        <div class="stat-card accent-purple">
            <div class="stat-content">
                <span class="stat-title">TOTAL ROOMS</span>
                <span class="stat-value">24</span>
                <span class="stat-subtext">6 available now</span>
            </div>
            <div class="stat-icon">🏡</div>
        </div>
        <div class="stat-card accent-green">
            <div class="stat-content">
                <span class="stat-title">ACTIVE BOOKINGS</span>
                <span class="stat-value">@activeBookings</span>
                <span class="stat-subtext">3 checking in today</span>
            </div>
            <div class="stat-icon">📋</div>
        </div>
        <div class="stat-card accent-gold">
            <div class="stat-content">
                <span class="stat-title">REVENUE TODAY</span>
                <span class="stat-value">@((revenueToday / 1000).ToString("0"))k</span>
                <span class="stat-subtext">Rs. @revenueToday.ToString("N0") earned</span>
            </div>
            <div class="stat-icon">💰</div>
        </div>
        <div class="stat-card accent-blue">
            <div class="stat-content">
                <span class="stat-title">LOYALTY MEMBERS</span>
                <span class="stat-value">137</span>
                <span class="stat-subtext">12 Gold tier</span>
            </div>
            <div class="stat-icon">⭐</div>
        </div>
    </div>

    <!-- ── OPERATIONS ── -->
    <div class="section-title">
        <span class="title-text">OPERATIONS</span>
        <div class="title-line"></div>
    </div>
    
    <div class="operations-grid">
        <div class="op-card" @onclick='() => Navigation.NavigateTo("/room-finder")'>
            <div class="card-accent-bar"></div>
            <div class="op-icon bg-purple">🔍</div>
            <h3>Room Finder</h3>
            <p>Search and book available rooms</p>
            <span class="op-action">→ Open</span>
        </div>
        <div class="op-card" @onclick='() => Navigation.NavigateTo("/reservations")'>
            <div class="card-accent-bar"></div>
            <div class="op-icon bg-green">📋</div>
            <h3>Reservations</h3>
            <p>View and manage all bookings</p>
            <span class="op-action">→ Open</span>
        </div>
        <div class="op-card" @onclick='() => Navigation.NavigateTo("/guest-profiles")'>
            <div class="card-accent-bar"></div>
            <div class="op-icon bg-blue">👤</div>
            <h3>Guest Profiles</h3>
            <p>Manage guest information</p>
            <span class="op-action">→ Open</span>
        </div>
        <div class="op-card" @onclick='() => Navigation.NavigateTo("/group-booking")'>
            <div class="card-accent-bar"></div>
            <div class="op-icon bg-pink">👥</div>
            <h3>Group Booking</h3>
            <p>Create family and group bookings</p>
            <span class="op-action">→ Open</span>
        </div>
    </div>

    <!-- ── MANAGEMENT ── -->
    <div class="section-title">
        <span class="title-text">MANAGEMENT</span>
        <div class="title-line"></div>
    </div>

    <div class="management-grid">
        <div class="mgmt-card wide" @onclick='() => Navigation.NavigateTo("/loyalty-points")'>
            <div class="mgmt-content">
                <div class="op-icon bg-gold">⭐</div>
                <div>
                    <h3>Loyalty Points</h3>
                    <p>Award, redeem, and manage guest loyalty tiers — Bronze, Silver, Gold</p>
                </div>
            </div>
            <span class="mgmt-action">→</span>
        </div>
        <div class="mgmt-card wide" @onclick='() => Navigation.NavigateTo("/reservations")'>
            <div class="mgmt-content">
                <div class="op-icon bg-blue">📅</div>
                <div>
                    <h3>Export Calendar</h3>
                    <p>Export booking schedules and availability as calendar files</p>
                </div>
            </div>
            <span class="mgmt-action">→</span>
        </div>
        <div class="mgmt-card small" @onclick='() => Navigation.NavigateTo("/ecostay")'>
            <div class="op-icon bg-green">🌿</div>
            <h3>Eco Reports</h3>
            <p>Track eco-certified room metrics</p>
            <span class="op-action">→ Open</span>
        </div>
        <div class="mgmt-card small" @onclick='() => Navigation.NavigateTo("/localdeals")'>
            <div class="op-icon bg-orange">🏷️</div>
            <h3>Deals</h3>
            <p>Manage promotions and discounts</p>
            <span class="op-action">→ Open</span>
        </div>
    </div>

    <!-- ── QUICK ACTIONS ── -->
    <div class="section-title">
        <span class="title-text">QUICK ACTIONS</span>
        <div class="title-line"></div>
    </div>

    <div class="quick-actions-strip">
        <div class="qa-item" @onclick='() => Navigation.NavigateTo("/room-finder")'>
            <div class="qa-icon">➕</div>
            <div class="qa-text">
                <span class="qa-title">New Booking</span>
                <span class="qa-sub">Create reservation</span>
            </div>
        </div>
        <div class="qa-item" @onclick='() => Navigation.NavigateTo("/notifications/settings")'>
            <div class="qa-icon">🔔</div>
            <div class="qa-text">
                <span class="qa-title">Alerts</span>
                <span class="qa-sub">View notifications</span>
            </div>
        </div>
        <div class="qa-item" @onclick='() => Navigation.NavigateTo("/reports")'>
            <div class="qa-icon">📊</div>
            <div class="qa-text">
                <span class="qa-title">Reports</span>
                <span class="qa-sub">Revenue analytics</span>
            </div>
        </div>
        <div class="qa-item" @onclick='() => Navigation.NavigateTo("/concierge")'>
            <div class="qa-icon">💬</div>
            <div class="qa-text">
                <span class="qa-title">Concierge</span>
                <span class="qa-sub">Guest requests</span>
            </div>
        </div>
    </div>

</div>

@code {
    private int activeBookings = 0;
    private double revenueToday = 0;

    protected override async Task OnInitializedAsync()
    {
        var today = DateTime.Today;
        var monthStart = new DateTime(today.Year, today.Month, 1);
        
        var revenueReport = await ReportService.GetRevenueReportAsync(monthStart, today);
        if (revenueReport != null)
        {
            activeBookings = revenueReport.TotalBookings;
            // Mocking today's revenue based on a fraction of total for demo
            revenueToday = revenueReport.TotalRevenue > 0 ? (revenueReport.TotalRevenue * 0.15) : 42000;
        }
    }
}

<style>
    .dashboard-container { 
        padding: 1.5rem 2rem; 
        max-width: 1300px; 
        margin: 0 auto; 
        color: #e2e8f0;
    }
    
    .status-indicator {
        display: flex;
        align-items: center;
        gap: 8px;
        background: rgba(16, 185, 129, 0.1);
        color: #10b981;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
        border: 1px solid rgba(16, 185, 129, 0.3);
    }
    .status-dot {
        width: 8px; height: 8px;
        background: #10b981;
        border-radius: 50%;
        box-shadow: 0 0 8px #10b981;
    }

    /* Section Titles */
    .section-title {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin: 2.5rem 0 1.5rem;
    }
    .title-text {
        font-size: 0.8rem;
        font-weight: 700;
        color: #64748b;
        letter-spacing: 1.5px;
    }
    .title-line {
        flex: 1;
        height: 1px;
        background: rgba(255,255,255,0.05);
    }

    /* Top Stats Grid */
    .top-stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.5rem;
    }
    
    .stat-card {
        background: #13181f;
        border-radius: 12px;
        padding: 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        border: 1px solid rgba(255,255,255,0.05);
        border-top: 3px solid transparent;
        transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.3s ease;
    }
    
    .stat-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.5);
    }
    
    .stat-card.accent-purple { border-top-color: #a78bfa; }
    .stat-card.accent-green { border-top-color: #10b981; }
    .stat-card.accent-gold { border-top-color: #fbbf24; }
    .stat-card.accent-blue { border-top-color: #3b82f6; }
    
    .stat-card:hover.accent-purple { box-shadow: 0 10px 25px rgba(167, 139, 250, 0.1); }
    .stat-card:hover.accent-green { box-shadow: 0 10px 25px rgba(16, 185, 129, 0.1); }
    .stat-card:hover.accent-gold { box-shadow: 0 10px 25px rgba(251, 191, 36, 0.1); }
    .stat-card:hover.accent-blue { box-shadow: 0 10px 25px rgba(59, 130, 246, 0.1); }

    .stat-content {
        display: flex;
        flex-direction: column;
    }
    
    .stat-title { font-size: 0.75rem; font-weight: 600; color: #64748b; letter-spacing: 0.5px; margin-bottom: 0.5rem; }
    .stat-value { font-size: 2rem; font-weight: 800; color: #fff; line-height: 1; margin-bottom: 0.5rem; }
    .stat-subtext { font-size: 0.8rem; color: #94a3b8; }
    .stat-icon { font-size: 1.5rem; opacity: 0.8; }

    /* Operations Grid */
    .operations-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.5rem;
    }

    .op-card {
        background: #13181f;
        border-radius: 12px;
        padding: 1.5rem;
        border: 1px solid rgba(255,255,255,0.05);
        cursor: pointer;
        position: relative;
        overflow: hidden;
        transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.3s ease, border-color 0.3s ease;
        display: flex;
        flex-direction: column;
    }

    .card-accent-bar {
        position: absolute;
        top: 0; left: 0; right: 0;
        height: 4px;
        background: var(--accent-purple);
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .op-card:hover {
        transform: scale(1.03) translateY(-5px);
        box-shadow: 0 15px 30px rgba(0,0,0,0.5), 0 0 15px rgba(187, 134, 252, 0.1);
        border-color: rgba(187, 134, 252, 0.3);
    }
    .op-card:hover .card-accent-bar { opacity: 1; }

    .op-icon {
        width: 48px; height: 48px;
        border-radius: 12px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.5rem;
        margin-bottom: 1.2rem;
    }
    .bg-purple { background: rgba(167, 139, 250, 0.15); color: #a78bfa; }
    .bg-green { background: rgba(16, 185, 129, 0.15); color: #10b981; }
    .bg-blue { background: rgba(59, 130, 246, 0.15); color: #3b82f6; }
    .bg-pink { background: rgba(236, 72, 153, 0.15); color: #ec4899; }
    .bg-gold { background: rgba(251, 191, 36, 0.15); color: #fbbf24; }
    .bg-orange { background: rgba(249, 115, 22, 0.15); color: #f97316; }

    .op-card h3 { color: #fff; margin: 0 0 0.5rem; font-size: 1.1rem; }
    .op-card p { color: #64748b; font-size: 0.85rem; line-height: 1.4; margin: 0 0 1.5rem; flex: 1; }
    
    .op-action {
        font-size: 0.85rem;
        color: #475569;
        font-weight: 600;
        transition: color 0.3s ease;
    }
    .op-card:hover .op-action { color: var(--accent-purple); }

    /* Management Grid */
    .management-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1.5rem;
    }

    .mgmt-card {
        background: #13181f;
        border-radius: 12px;
        border: 1px solid rgba(255,255,255,0.05);
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .mgmt-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.4);
        border-color: rgba(255,255,255,0.1);
    }

    .mgmt-card.wide {
        grid-column: span 2;
        padding: 1.5rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .mgmt-content {
        display: flex;
        align-items: center;
        gap: 1.2rem;
    }

    .mgmt-content .op-icon { margin-bottom: 0; }
    
    .mgmt-card.wide h3 { color: #fff; margin: 0 0 0.3rem; font-size: 1.1rem; }
    .mgmt-card.wide p { color: #64748b; font-size: 0.85rem; margin: 0; }
    
    .mgmt-action { color: #475569; font-size: 1.2rem; font-weight: bold; transition: color 0.2s; }
    .mgmt-card.wide:hover .mgmt-action { color: #fff; transform: translateX(3px); }

    .mgmt-card.small {
        grid-column: span 1;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
    }
    .mgmt-card.small h3 { color: #fff; margin: 0 0 0.5rem; font-size: 1.05rem; }
    .mgmt-card.small p { color: #64748b; font-size: 0.85rem; margin: 0 0 1rem; flex: 1; }
    .mgmt-card.small:hover .op-action { color: #fff; }

    /* Quick Actions Strip */
    .quick-actions-strip {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
    }

    .qa-item {
        background: #13181f;
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: 12px;
        padding: 1rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        cursor: pointer;
        transition: background 0.2s;
    }

    .qa-item:hover {
        background: rgba(255,255,255,0.03);
    }

    .qa-icon {
        font-size: 1.3rem;
    }

    .qa-text {
        display: flex;
        flex-direction: column;
    }

    .qa-title {
        color: #fff;
        font-weight: 600;
        font-size: 0.9rem;
    }

    .qa-sub {
        color: #64748b;
        font-size: 0.8rem;
    }
    
    /* Responsive Adjustments */
    @@media (max-width: 1024px) {
        .top-stats-grid, .operations-grid, .management-grid, .quick-actions-strip {
            grid-template-columns: repeat(2, 1fr);
        }
    }
    @@media (max-width: 600px) {
        .top-stats-grid, .operations-grid, .management-grid, .quick-actions-strip {
            grid-template-columns: 1fr;
        }
        .mgmt-card.wide { grid-column: span 1; }
        .dashboard-header { flex-direction: column; align-items: flex-start; gap: 1rem; }
    }
</style>

@page "/guest-profile-create"
@using LodgeStay.Models
@using LodgeStay.Services
@inject NavigationManager Navigation
@inject GuestService GuestService

<div class="create-root">
    <div class="page-top">
        <button class="btn-back" @onclick="GoBack">
            <span class="icon">←</span> Back to Profiles
        </button>
        <h2 class="page-title">Onboard New Guest</h2>
    </div>

    <div class="form-layout">
        <div class="glass-panel form-main">
            <!-- Section 1: Identity -->
            <div class="form-section">
                <div class="section-header">
                    <span class="step-no">01</span>
                    <h3>Identity & Contact</h3>
                </div>
                <div class="input-grid">
                    <div class="input-group">
                        <label>Full Legal Name</label>
                        <div class="input-wrapper">
                            <span class="i-icon">👤</span>
                            <input type="text" @bind="name" placeholder="John Doe" />
                        </div>
                    </div>
                    <div class="input-group">
                        <label>Email Address</label>
                        <div class="input-wrapper">
                            <span class="i-icon">📧</span>
                            <input type="email" @bind="email" placeholder="john@example.com" />
                        </div>
                    </div>
                    <div class="input-group full-width">
                        <label>Phone Number</label>
                        <div class="input-wrapper">
                            <span class="i-icon">📞</span>
                            <input type="tel" @bind="phone" placeholder="+92 300 0000000" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Section 2: Preferences -->
            <div class="form-section">
                <div class="section-header">
                    <span class="step-no">02</span>
                    <h3>Stay Preferences</h3>
                </div>
                <div class="input-grid">
                    <div class="input-group">
                        <label>Room Category</label>
                        <select @bind="preferredRoomType">
                            <option value="">Any Category</option>
                            <option value="Single">Single</option>
                            <option value="Double">Double</option>
                            <option value="Suite">Suite</option>
                            <option value="Family">Family</option>
                        </select>
                    </div>
                    <div class="input-group">
                        <label>Bed Configuration</label>
                        <select @bind="preferredBedType">
                            <option value="">Any Bed</option>
                            <option value="King">King Size</option>
                            <option value="Queen">Queen Size</option>
                            <option value="Twin">Twin Beds</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Section 3: Special Notes -->
            <div class="form-section">
                <div class="section-header">
                    <span class="step-no">03</span>
                    <h3>Notes & Dietary</h3>
                </div>
                <div class="input-grid">
                    <div class="input-group">
                        <label>Dietary Restrictions</label>
                        <textarea @bind="dietaryNotes" placeholder="e.g. Vegetarian, Halal, Nut Allergies..."></textarea>
                    </div>
                    <div class="input-group">
                        <label>Special Requests</label>
                        <textarea @bind="amenityNotes" placeholder="e.g. Extra towels, High floor, Quiet room..."></textarea>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="msg error">
                    <span class="icon">⚠️</span> @errorMessage
                </div>
            }
            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="msg success">
                    <span class="icon">✅</span> @successMessage
                </div>
            }

            <div class="form-footer">
                <button class="btn-cancel" @onclick="GoBack">Discard</button>
                <button class="btn-save" @onclick="SaveGuest" disabled="@isSaving">
                    @if (isSaving) { <div class="mini-spinner"></div> }
                    else { <span>Create Profile</span> }
                </button>
            </div>
        </div>

        <!-- Sidebar Info -->
        <div class="form-sidebar">
            <div class="glass-panel info-card">
                <h4>Guest Loyalty</h4>
                <p>New profiles automatically start at <strong>Bronze Tier</strong> with 0 points.</p>
            </div>
            <div class="glass-panel info-card">
                <h4>Data Privacy</h4>
                <p>All guest information is encrypted and stored locally in compliance with lodge policies.</p>
            </div>
        </div>
    </div>
</div>

@code {
    private string name = "";
    private string email = "";
    private string phone = "";
    private string preferredRoomType = "";
    private string preferredBedType = "";
    private string preferredFloor = "";
    private string dietaryNotes = "";
    private string amenityNotes = "";
    private string errorMessage = "";
    private string successMessage = "";
    private bool isSaving = false;

    private void GoBack() => Navigation.NavigateTo("/guest-profiles");

    private async Task SaveGuest()
    {
        if (string.IsNullOrWhiteSpace(name) || string.IsNullOrWhiteSpace(email))
        {
            errorMessage = "Name and Email are required fields.";
            return;
        }

        isSaving = true;
        errorMessage = "";

        var guest = new GuestProfile
        {
            Name = name,
            Email = email,
            PhoneNo = phone,
            PreferredRoomType = preferredRoomType,
            PreferredBedType = preferredBedType,
            PreferredFloor = preferredFloor,
            DietaryNotes = dietaryNotes,
            AmenityNotes = amenityNotes,
            Status = "Active",
            Tier = "Bronze",
            LoyaltyPoints = 0
        };

        var success = await GuestService.CreateGuestAsync(guest);
        isSaving = false;

        if (success)
        {
            successMessage = "Profile created successfully! Redirecting...";
            await Task.Delay(1500);
            Navigation.NavigateTo("/guest-profiles");
        }
        else
        {
            errorMessage = "A guest with this email address already exists.";
        }
    }
}

<style>
    .create-root { padding: 3rem; max-width: 1100px; margin: 0 auto; color: #fff; }
    
    .page-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 3rem; }
    .btn-back { background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: #94a3b8; padding: 0.8rem 1.5rem; border-radius: 12px; cursor: pointer; transition: all 0.2s; font-weight: 600; }
    .btn-back:hover { background: rgba(255,255,255,0.1); color: #fff; transform: translateX(-5px); }
    .page-title { font-size: 2rem; font-weight: 800; margin: 0; }

    .form-layout { display: grid; grid-template-columns: 1fr 300px; gap: 2rem; align-items: start; }
    
    .form-main { padding: 3rem !important; }
    
    .form-section { margin-bottom: 3.5rem; }
    .section-header { display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem; }
    .step-no { background: var(--accent-purple); color: #000; width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.9rem; }
    .form-section h3 { font-size: 1.3rem; margin: 0; color: #fff; font-weight: 700; }

    .input-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    .full-width { grid-column: 1 / -1; }
    
    .input-group { display: flex; flex-direction: column; gap: 0.6rem; }
    .input-group label { font-size: 0.8rem; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: 1px; }
    
    .input-wrapper { position: relative; display: flex; align-items: center; }
    .i-icon { position: absolute; left: 1rem; color: #64748b; font-size: 1.1rem; }
    
    input, select, textarea { 
        width: 100%; 
        padding: 1rem 1rem 1rem 3rem; 
        background: rgba(255,255,255,0.03); 
        border: 1px solid rgba(255,255,255,0.1); 
        border-radius: 12px; 
        color: #fff; 
        font-size: 1rem; 
        transition: all 0.2s; 
    }
    select { padding-left: 1rem; appearance: none; }
    textarea { padding-left: 1rem; height: 100px; resize: none; }
    
    input:focus, select:focus, textarea:focus { outline: none; border-color: var(--accent-purple); background: rgba(187, 134, 252, 0.05); }

    .msg { padding: 1.2rem; border-radius: 12px; margin-bottom: 2rem; display: flex; align-items: center; gap: 1rem; font-weight: 600; }
    .error { background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.2); color: #f87171; }
    .success { background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.2); color: #10b981; }

    .form-footer { display: flex; justify-content: flex-end; gap: 1rem; margin-top: 1rem; padding-top: 2rem; border-top: 1px solid rgba(255,255,255,0.05); }
    .btn-cancel { padding: 1rem 2rem; background: transparent; border: 1px solid rgba(255,255,255,0.1); color: #64748b; border-radius: 12px; font-weight: 600; cursor: pointer; transition: all 0.2s; }
    .btn-cancel:hover { background: rgba(255,255,255,0.05); color: #fff; }
    
    .btn-save { min-width: 180px; padding: 1rem 2.5rem; background: var(--accent-purple); color: #000; border: none; border-radius: 12px; font-weight: 800; cursor: pointer; transition: all 0.3s; display: flex; align-items: center; justify-content: center; }
    .btn-save:hover:not(:disabled) { transform: scale(1.05); box-shadow: 0 0 30px rgba(187, 134, 252, 0.4); }
    .btn-save:disabled { opacity: 0.5; cursor: not-allowed; }

    .form-sidebar { display: flex; flex-direction: column; gap: 1.5rem; }
    .info-card { padding: 1.5rem !important; text-align: left; }
    .info-card h4 { font-size: 1rem; color: var(--accent-purple); margin: 0 0 0.8rem 0; }
    .info-card p { font-size: 0.85rem; color: #94a3b8; line-height: 1.5; margin: 0; }
    .info-card strong { color: #fff; }

    .mini-spinner { width: 20px; height: 20px; border: 3px solid rgba(0,0,0,0.1); border-top-color: #000; border-radius: 50%; animation: spin 0.8s linear infinite; }
    @@keyframes spin { to { transform: rotate(360deg); } }

    @@media (max-width: 900px) {
        .form-layout { grid-template-columns: 1fr; }
        .input-grid { grid-template-columns: 1fr; }
        .create-root { padding: 1.5rem; }
    }
</style>

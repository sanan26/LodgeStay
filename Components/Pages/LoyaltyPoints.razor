@page "/loyalty-points"
@using LodgeStay.Models
@using LodgeStay.Services
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject GuestService GuestService
@inject LoyaltyService LoyaltyService
@inject ReservationService ReservationService

<div class="lp-root">
    <div class="search-container">
        <span class="search-icon">🔍</span>
        <select class="guest-select" value="@selectedGuestId" @onchange="OnGuestSelectedChange">
            <option value="0">Search and select a guest...</option>
            @foreach (var g in allGuests)
            {
                <option value="@g.Id">@g.Name · @g.Email</option>
            }
        </select>
    </div>

    @if (selectedGuest == null)
    {
        <div class="empty-state">
            <div class="empty-icon">⭐</div>
            <p>Select a guest above to view their loyalty status, award points, or redeem rewards.</p>
        </div>
    }
    else
    {
        <div class="hub-layout">
            <!-- Left Column: Status & Info -->
            <div class="hub-left">
                <!-- Dynamic Tier Card -->
                <div class="glass-card tier-card @GetTierClass(selectedGuest.Tier)">
                    <div class="tier-glow"></div>
                    <div class="tier-content">
                        <div class="tier-header">
                            <span class="tier-emoji">@GetTierEmoji(selectedGuest.Tier)</span>
                            <div class="tier-titles">
                                <span class="tier-name">@selectedGuest.Tier Member</span>
                                <span class="guest-name">@selectedGuest.Name</span>
                            </div>
                        </div>
                        <div class="points-display">
                            <span class="points-val">@selectedGuest.LoyaltyPoints.ToString("N0")</span>
                            <span class="points-lbl">Available Points</span>
                        </div>
                        <div class="progress-section">
                            <div class="progress-bar">
                                <div class="progress-fill" style="width: @GetProgressPercent(selectedGuest.LoyaltyPoints)%"></div>
                            </div>
                            <span class="progress-text">@GetNextTierText(selectedGuest.LoyaltyPoints)</span>
                        </div>
                    </div>
                </div>

                <!-- Guest Info Mini-Card -->
                <div class="glass-card info-card">
                    <div class="info-row"><span class="icon">✉️</span> @selectedGuest.Email</div>
                    <div class="info-row"><span class="icon">📱</span> @selectedGuest.PhoneNo</div>
                </div>
            </div>

            <!-- Right Column: Actions & History -->
            <div class="hub-right">
                <div class="action-grid">
                    <!-- Award Points Panel -->
                    <div class="glass-card action-panel">
                        <h3 class="panel-title">Award Points</h3>
                        <p class="panel-desc">10 points awarded per night stayed.</p>
                        
                        <div class="stepper-wrap">
                            <button class="btn-stepper" @onclick="() => { if (nightsToAward > 1) nightsToAward--; }">−</button>
                            <div class="stepper-val">
                                <strong>@nightsToAward</strong>
                                <span>nights</span>
                            </div>
                            <button class="btn-stepper" @onclick="() => { if (nightsToAward < 30) nightsToAward++; }">+</button>
                        </div>
                        
                        <div class="preview-box award-preview">
                            <span>Will award:</span>
                            <strong>+@(nightsToAward * 10) pts</strong>
                        </div>
                        
                        <button class="btn-action btn-award" @onclick="AwardPoints">Award Points</button>
                    </div>

                    <!-- Redeem Points Panel -->
                    <div class="glass-card action-panel">
                        <h3 class="panel-title">Redeem Rewards</h3>
                        <p class="panel-desc">100 points = Rs. 100 off booking.</p>

                        <div class="slider-wrap">
                            <input type="range" class="custom-slider"
                                   min="0" max="@((selectedGuest.LoyaltyPoints / 100) * 100)" step="100"
                                   @bind="redeemPoints" @bind:event="oninput" />
                            <div class="slider-labels">
                                <span>0</span>
                                <span>@((selectedGuest.LoyaltyPoints / 100) * 100) max</span>
                            </div>
                        </div>

                        <div class="preview-box redeem-preview">
                            <span>Discount:</span>
                            <strong>Rs. @redeemPoints</strong>
                        </div>

                        <button class="btn-action btn-redeem" @onclick="RedeemPoints" disabled="@(redeemPoints < 100)">
                            @(redeemPoints < 100 ? "Select 100+ points" : $"Apply Rs. {redeemPoints} Discount")
                        </button>
                    </div>
                </div>

                <!-- History Timeline -->
                <div class="glass-card history-panel">
                    <h3 class="panel-title">Points History</h3>
                    @if (pointsHistory.Count == 0)
                    {
                        <p class="empty-text">No points history available for this guest.</p>
                    }
                    else
                    {
                        <div class="timeline">
                            @foreach (var entry in pointsHistory)
                            {
                                <div class="timeline-item">
                                    <div class="timeline-dot @(entry.IsEarn ? "dot-earn" : "dot-redeem")"></div>
                                    <div class="timeline-content">
                                        <span class="history-desc">@entry.Description</span>
                                        <span class="history-pts @(entry.IsEarn ? "pts-earn" : "pts-redeem")">
                                            @(entry.IsEarn ? "+" : "-")@entry.Points
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(feedbackMessage))
    {
        <div class="toast @(isError ? "toast-error" : "toast-success")">
            @feedbackMessage
        </div>
    }
</div>

@code {
    private List<GuestProfile> allGuests = new();
    private GuestProfile? selectedGuest;
    private int selectedGuestId = 0;
    private int nightsToAward = 1;
    private int redeemPoints = 0;
    private string feedbackMessage = "";
    private bool isError = false;

    private List<PointsEntry> pointsHistory = new();

    protected override async Task OnInitializedAsync()
    {
        allGuests = await GuestService.GetAllGuestsAsync();
    }

    private async Task OnGuestSelectedChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            selectedGuestId = id;
            selectedGuest = id > 0 ? await GuestService.GetGuestByIdAsync(id) : null;
            redeemPoints = 0;
            feedbackMessage = "";

            // Load history from database
            if (selectedGuest != null)
            {
                var dbHistory = await LoyaltyService.GetHistoryAsync(selectedGuest.Id);
                pointsHistory = dbHistory.Select(h => new PointsEntry
                    {
                        Description = h.Description,
                        Points = h.Points,
                        IsEarn = h.IsEarn
                    }).ToList();
            }
            else
            {
                pointsHistory = new();
            }
        }
    }

    private async Task AwardPoints()
    {
        if (selectedGuest == null) return;
        await LoyaltyService.EarnPointsAsync(selectedGuest.Id, nightsToAward);
        selectedGuest = await GuestService.GetGuestByIdAsync(selectedGuest.Id);
        var dbHistory = await LoyaltyService.GetHistoryAsync(selectedGuest!.Id);
        pointsHistory = dbHistory.Select(h => new PointsEntry
            {
                Description = h.Description,
                Points = h.Points,
                IsEarn = h.IsEarn
            }).ToList();
        feedbackMessage = $"✅ {nightsToAward * 10} points awarded to {selectedGuest?.Name}!";
        isError = false;
        nightsToAward = 1;
        StateHasChanged();

        await Task.Delay(3000);
        feedbackMessage = "";
        StateHasChanged();
    }

    private async Task RedeemPoints()
    {
        if (selectedGuest == null || redeemPoints < 100) return;
        var (success, discount) = await LoyaltyService.RedeemPointsAsync(selectedGuest.Id, redeemPoints);
        if (success)
        {
            var all = await ReservationService.GetReservationsAsync();
            var booking = all.Where(r => r.GuestEmail == selectedGuest.Email && r.Status == "Confirmed")
                             .OrderByDescending(r => r.Created_at).FirstOrDefault();
            if (booking != null)
            {
                booking.TotalPrice = Math.Max(booking.TotalPrice - discount, 0);
                await ReservationService.UpdateReservationAsync(booking);
                feedbackMessage = $"✅ Rs. {discount} discount applied to {booking.BookingReference}! New total: Rs. {booking.TotalPrice}";
            }
            else
            {
                feedbackMessage = $"✅ {redeemPoints} points redeemed! Rs. {discount} credit saved.";
            }
            var dbHistory = await LoyaltyService.GetHistoryAsync(selectedGuest!.Id);
            pointsHistory = dbHistory.Select(h => new PointsEntry
                {
                    Description = h.Description,
                    Points = h.Points,
                    IsEarn = h.IsEarn
                }).ToList();
            selectedGuest = await GuestService.GetGuestByIdAsync(selectedGuest.Id);
            isError = false;
            redeemPoints = 0;
        }
        else
        {
            feedbackMessage = "❌ Insufficient points. Minimum 100 required.";
            isError = true;
        }
        StateHasChanged();

        await Task.Delay(3000);
        feedbackMessage = "";
        StateHasChanged();
    }

    private async Task GoBack() => await JSRuntime.InvokeVoidAsync("history.back");
    private string GetTierEmoji(string tier) => tier switch { "Gold" => "🥇", "Silver" => "🥈", _ => "🥉" };
    private string GetTierClass(string tier) => tier switch { "Gold" => "tier-gold", "Silver" => "tier-silver", _ => "tier-bronze" };
    private int GetProgressPercent(int points) { if (points >= 5000) return 100; if (points >= 1000) return (points - 1000) * 100 / 4000; return points * 100 / 1000; }
    private string GetNextTierText(int points) { if (points >= 5000) return "🎉 Maximum tier achieved!"; if (points >= 1000) return $"{5000 - points} pts to Gold"; return $"{1000 - points} pts to Silver"; }

    public class PointsEntry { public string Description { get; set; } = ""; public int Points { get; set; } public bool IsEarn { get; set; } }
}

<style>
    .lp-root { padding: 2rem; max-width: 1200px; margin: 0 auto; color: #e2e8f0; font-family: 'Inter', sans-serif; }

    /* Hub Header */
    .hub-header { text-align: center; margin-bottom: 3rem; }
    .hub-title { font-size: 2.2rem; font-weight: 700; color: #fff; margin-bottom: 1.5rem; display: flex; align-items: center; justify-content: center; gap: 0.8rem; }
    .accent-icon { color: var(--accent-purple); text-shadow: 0 0 15px rgba(187, 134, 252, 0.4); }

    .search-container { position: relative; max-width: 600px; margin: 0 auto; }
    .search-icon { position: absolute; left: 1.2rem; top: 50%; transform: translateY(-50%); font-size: 1.2rem; color: #94a3b8; }
    .guest-select { width: 100%; padding: 1rem 1rem 1rem 3rem; background: #13181f; border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; color: #fff; font-size: 1rem; appearance: none; cursor: pointer; transition: all 0.3s ease; box-shadow: 0 8px 32px rgba(0,0,0,0.2); }
    .guest-select:focus { outline: none; border-color: var(--accent-purple); box-shadow: 0 0 0 3px rgba(187, 134, 252, 0.15); }
    .guest-select option { background: #13181f; color: #fff; }

    .empty-state { text-align: center; padding: 5rem 2rem; background: #13181f; border-radius: 16px; border: 1px dashed rgba(255,255,255,0.1); margin-top: 2rem; }
    .empty-icon { font-size: 3.5rem; opacity: 0.3; margin-bottom: 1rem; }
    .empty-state p { color: #94a3b8; font-size: 1.1rem; }

    /* Hub Layout */
    .hub-layout { display: grid; grid-template-columns: 350px 1fr; gap: 2rem; align-items: start; }
    .hub-left { display: flex; flex-direction: column; gap: 1.5rem; }
    .hub-right { display: flex; flex-direction: column; gap: 1.5rem; }

    /* Glass Cards */
    .glass-card { background: #13181f; border-radius: 16px; border: 1px solid rgba(255,255,255,0.05); padding: 1.5rem; box-shadow: 0 8px 32px rgba(0,0,0,0.3); position: relative; overflow: hidden; }

    /* Tier Card */
    .tier-card { padding: 2rem; text-align: center; }
    .tier-glow { position: absolute; inset: 0; background: radial-gradient(circle at top, var(--glow-color) 0%, transparent 70%); opacity: 0.15; z-index: 0; }
    .tier-content { position: relative; z-index: 1; }

    .tier-gold { --glow-color: #fbbf24; border-top: 2px solid #fbbf24; }
    .tier-silver { --glow-color: #cbd5e1; border-top: 2px solid #cbd5e1; }
    .tier-bronze { --glow-color: #d97706; border-top: 2px solid #d97706; }

    .tier-header { display: flex; flex-direction: column; align-items: center; gap: 0.5rem; margin-bottom: 2rem; }
    .tier-emoji { font-size: 3rem; text-shadow: 0 0 20px var(--glow-color); }
    .tier-titles { display: flex; flex-direction: column; }
    .tier-name { font-size: 1.2rem; font-weight: 700; color: #fff; letter-spacing: 1px; text-transform: uppercase; }
    .guest-name { font-size: 0.95rem; color: #94a3b8; }

    .points-display { margin-bottom: 2rem; }
    .points-val { display: block; font-size: 3.5rem; font-weight: 800; line-height: 1; color: #fff; text-shadow: 0 0 20px rgba(255,255,255,0.2); }
    .points-lbl { font-size: 0.8rem; color: #94a3b8; text-transform: uppercase; letter-spacing: 2px; }

    .progress-bar { height: 6px; background: rgba(255,255,255,0.1); border-radius: 10px; overflow: hidden; margin-bottom: 0.5rem; }
    .progress-fill { height: 100%; background: var(--glow-color); box-shadow: 0 0 10px var(--glow-color); transition: width 1s cubic-bezier(0.4, 0, 0.2, 1); }
    .progress-text { font-size: 0.8rem; color: #cbd5e1; }

    /* Info Card */
    .info-card { display: flex; flex-direction: column; gap: 0.8rem; }
    .info-row { display: flex; align-items: center; gap: 0.8rem; color: #cbd5e1; font-size: 0.95rem; }
    .info-row .icon { font-size: 1.1rem; opacity: 0.7; }

    /* Action Grid */
    .action-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    .action-panel { display: flex; flex-direction: column; justify-content: space-between; }
    .panel-title { font-size: 1.2rem; font-weight: 600; color: #fff; margin: 0 0 0.5rem 0; }
    .panel-desc { font-size: 0.85rem; color: #94a3b8; margin: 0 0 1.5rem 0; }

    /* Controls */
    .stepper-wrap { display: flex; justify-content: space-between; align-items: center; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05); border-radius: 12px; padding: 0.5rem; margin-bottom: 1rem; }
    .btn-stepper { width: 40px; height: 40px; border-radius: 8px; background: rgba(255,255,255,0.05); border: none; color: #fff; font-size: 1.2rem; cursor: pointer; transition: all 0.2s; }
    .btn-stepper:hover { background: rgba(255,255,255,0.1); }
    .stepper-val { display: flex; flex-direction: column; align-items: center; }
    .stepper-val strong { font-size: 1.4rem; color: #fff; line-height: 1; }
    .stepper-val span { font-size: 0.7rem; color: #94a3b8; text-transform: uppercase; }

    .slider-wrap { margin-bottom: 1rem; }
    .custom-slider { width: 100%; accent-color: var(--accent-purple); cursor: pointer; }
    .slider-labels { display: flex; justify-content: space-between; font-size: 0.75rem; color: #94a3b8; margin-top: 0.5rem; }

    .preview-box { display: flex; justify-content: space-between; align-items: center; padding: 1rem; border-radius: 10px; margin-bottom: 1.5rem; font-size: 0.95rem; }
    .award-preview { background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.2); color: #10b981; }
    .redeem-preview { background: rgba(187, 134, 252, 0.1); border: 1px solid rgba(187, 134, 252, 0.2); color: var(--accent-purple); }

    .btn-action { width: 100%; padding: 1rem; border-radius: 10px; border: none; font-size: 1rem; font-weight: 600; cursor: pointer; transition: all 0.2s; }
    .btn-award { background: #10b981; color: #000; }
    .btn-award:hover { background: #059669; box-shadow: 0 0 15px rgba(16, 185, 129, 0.3); }
    .btn-redeem { background: var(--accent-purple); color: #000; }
    .btn-redeem:hover:not(:disabled) { background: #9d4edd; box-shadow: 0 0 15px rgba(187, 134, 252, 0.3); }
    .btn-redeem:disabled { background: rgba(255,255,255,0.1); color: #64748b; cursor: not-allowed; }

    /* Timeline */
    .history-panel { flex: 1; }
    .timeline { display: flex; flex-direction: column; gap: 1rem; margin-top: 1rem; max-height: 250px; overflow-y: auto; padding-right: 0.5rem; }
    .timeline::-webkit-scrollbar { width: 6px; }
    .timeline::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 10px; }
    
    .timeline-item { display: flex; align-items: center; gap: 1rem; padding: 0.8rem; background: rgba(255,255,255,0.02); border-radius: 10px; border: 1px solid rgba(255,255,255,0.03); transition: transform 0.2s; }
    .timeline-item:hover { transform: translateX(5px); background: rgba(255,255,255,0.05); }
    
    .timeline-dot { width: 10px; height: 10px; border-radius: 50%; box-shadow: 0 0 8px currentColor; }
    .dot-earn { color: #10b981; background: #10b981; }
    .dot-redeem { color: var(--accent-purple); background: var(--accent-purple); }
    
    .timeline-content { flex: 1; display: flex; justify-content: space-between; align-items: center; }
    .history-desc { font-size: 0.9rem; color: #cbd5e1; }
    .history-pts { font-weight: 700; font-size: 0.95rem; }
    .pts-earn { color: #10b981; }
    .pts-redeem { color: var(--accent-purple); }
    
    .empty-text { color: #64748b; font-size: 0.9rem; margin-top: 1rem; }

    /* Toasts */
    .toast { position: fixed; bottom: 2rem; left: 50%; transform: translateX(-50%); padding: 1rem 2rem; border-radius: 50px; font-weight: 600; font-size: 0.95rem; box-shadow: 0 10px 30px rgba(0,0,0,0.5); z-index: 100; animation: slideUp 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
    .toast-success { background: #10b981; color: #000; border: 1px solid #059669; }
    .toast-error { background: #ef4444; color: #fff; border: 1px solid #dc2626; }

    @@keyframes slideUp { from { opacity: 0; transform: translate(-50%, 20px); } to { opacity: 1; transform: translate(-50%, 0); } }

    @@media (max-width: 900px) {
        .hub-layout { grid-template-columns: 1fr; }
        .action-grid { grid-template-columns: 1fr; }
    }
</style>

@page "/loyalty-points"
@using LodgeStay.Models
@using LodgeStay.Services
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject GuestService GuestService
@inject LoyaltyService LoyaltyService
@inject ReservationService ReservationService

<div class="lp-root">
    <div class="lp-header">
        <div class="lp-header-left">
            <button class="btn-back" @onclick="GoBack">← Back</button>
            <DashboardButton />
        </div>
        <div class="lp-title">
            <span class="star-icon">✦</span>
            <h1>Loyalty Points</h1>
            <span class="star-icon">✦</span>
        </div>
        <div class="lp-header-right"></div>
    </div>

    <div class="guest-picker">
        <label class="picker-label">Select Guest</label>
        <div class="select-wrapper">
            <select value="@selectedGuestId" @onchange="OnGuestSelectedChange">
                <option value="0">— Choose a guest —</option>
                @foreach (var g in allGuests)
                {
                    <option value="@g.Id">@g.Name · @g.Email</option>
                }
            </select>
            <span class="select-arrow">▾</span>
        </div>
    </div>

    @if (selectedGuest == null)
    {
        <div class="empty-state">
            <div class="empty-icon">⭐</div>
            <p>Select a guest to view their loyalty status</p>
        </div>
    }
    else
    {
        <div class="lp-body">
            <div class="lp-left">
                <div class="tier-card tier-@selectedGuest.LoyaltyTier.ToLower()">
                    <div class="tier-card-bg"></div>
                    <div class="tier-card-content">
                        <div class="tier-top">
                            <span class="tier-emblem">@GetTierEmoji(selectedGuest.LoyaltyTier)</span>
                            <div class="tier-info">
                                <span class="tier-name">@selectedGuest.LoyaltyTier</span>
                                <span class="tier-sub">Member Tier</span>
                            </div>
                        </div>
                        <div class="tier-points-display">
                            <span class="tier-points-num">@selectedGuest.LoyaltyPoints.ToString("N0")</span>
                            <span class="tier-points-label">POINTS</span>
                        </div>
                        <div class="tier-progress-wrap">
                            <div class="tier-progress-bar">
                                <div class="tier-progress-fill" style="width: @GetProgressPercent(selectedGuest.LoyaltyPoints)%"></div>
                            </div>
                            <span class="tier-next">@GetNextTierText(selectedGuest.LoyaltyPoints)</span>
                        </div>
                    </div>
                </div>

                <div class="guest-info-card">
                    <div class="guest-avatar">@selectedGuest.Name[0]</div>
                    <div class="guest-details">
                        <h3>@selectedGuest.Name</h3>
                        <p>@selectedGuest.Email</p>
                        <p>@selectedGuest.PhoneNo</p>
                    </div>
                </div>

                <div class="action-card award-card">
                    <div class="action-card-header">
                        <span class="action-icon">➕</span>
                        <h4>Award Points</h4>
                    </div>
                    <p class="action-hint">10 points per night stayed</p>
                    <div class="nights-input-row">
                        <button class="stepper-btn" @onclick="() => { if (nightsToAward > 1) nightsToAward--; }">−</button>
                        <div class="nights-display">
                            <span class="nights-num">@nightsToAward</span>
                            <span class="nights-label">nights</span>
                        </div>
                        <button class="stepper-btn" @onclick="() => { if (nightsToAward < 30) nightsToAward++; }">+</button>
                    </div>
                    <div class="award-preview">+<strong>@(nightsToAward * 10)</strong> points</div>
                    <button class="btn-award" @onclick="AwardPoints">Award Points</button>
                </div>
            </div>

            <div class="lp-right">
                <div class="action-card redeem-card">
                    <div class="action-card-header">
                        <span class="action-icon">🎁</span>
                        <h4>Redeem Points</h4>
                    </div>
                    <p class="action-hint">100 points = Rs. 100 off booking</p>
                    <div class="balance-chip">
                        <span>Balance</span>
                        <strong>@selectedGuest.LoyaltyPoints pts</strong>
                    </div>
                    <div class="slider-section">
                        <input class="lp-slider" type="range"
                               min="0"
                               max="@((selectedGuest.LoyaltyPoints / 100) * 100)"
                               step="100"
                               @bind="redeemPoints"
                               @bind:event="oninput" />
                        <div class="slider-ends">
                            <span>0</span>
                            <span>@((selectedGuest.LoyaltyPoints / 100) * 100) max</span>
                        </div>
                    </div>
                    <div class="redeem-calc">
                        <div class="calc-row">
                            <span>Redeeming</span>
                            <strong>@redeemPoints pts</strong>
                        </div>
                        <div class="calc-divider"></div>
                        <div class="calc-row discount-row">
                            <span>Discount</span>
                            <strong>Rs. @redeemPoints</strong>
                        </div>
                    </div>
                    <button class="btn-redeem" @onclick="RedeemPoints" disabled="@(redeemPoints < 100)">
                        @(redeemPoints < 100 ? "Select 100+ points" : $"Apply Rs. {redeemPoints} Discount")
                    </button>
                </div>

                <div class="history-card">
                    <div class="action-card-header">
                        <span class="action-icon">📜</span>
                        <h4>Points History</h4>
                    </div>
                    @if (pointsHistory.Count == 0)
                    {
                        <p class="no-history">No history yet</p>
                    }
                    else
                    {
                        <div class="history-list">
                            @foreach (var entry in pointsHistory)
                            {
                                <div class="history-row">
                                    <div class="history-dot @(entry.IsEarn ? "dot-earn" : "dot-redeem")"></div>
                                    <span class="history-desc">@entry.Description</span>
                                    <span class="history-pts @(entry.IsEarn ? "pts-earn" : "pts-redeem")">
                                        @(entry.IsEarn ? "+" : "-")@entry.Points
                                    </span>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(feedbackMessage))
        {
            <div class="feedback-toast @(isError ? "toast-error" : "toast-success")">
                @feedbackMessage
            </div>
        }
    }
</div>

@code {
    private List<GuestProfile> allGuests = new();
    private GuestProfile? selectedGuest;
    private int selectedGuestId = 0;
    private int nightsToAward = 1;
    private int redeemPoints = 0;
    private string feedbackMessage = "";
    private bool isError = false;

    private List<PointsEntry> pointsHistory = new();

    protected override async Task OnInitializedAsync()
    {
        allGuests = await GuestService.GetAllGuestsAsync();
    }

    private async Task OnGuestSelectedChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            selectedGuestId = id;
            selectedGuest = id > 0 ? await GuestService.GetGuestByIdAsync(id) : null;
            redeemPoints = 0;
            feedbackMessage = "";

            // Load history from database
            if (selectedGuest != null)
            {
                var dbHistory = await LoyaltyService.GetHistoryAsync(selectedGuest.Id);
                pointsHistory = dbHistory.Select(h => new PointsEntry
                    {
                        Description = h.Description,
                        Points = h.Points,
                        IsEarn = h.IsEarn
                    }).ToList();
            }
            else
            {
                pointsHistory = new();
            }
        }
    }

    private async Task AwardPoints()
    {
        if (selectedGuest == null) return;
        await LoyaltyService.EarnPointsAsync(selectedGuest.Id, nightsToAward);
        selectedGuest = await GuestService.GetGuestByIdAsync(selectedGuest.Id);
        var dbHistory = await LoyaltyService.GetHistoryAsync(selectedGuest!.Id);
        pointsHistory = dbHistory.Select(h => new PointsEntry
            {
                Description = h.Description,
                Points = h.Points,
                IsEarn = h.IsEarn
            }).ToList();
        feedbackMessage = $"✅ {nightsToAward * 10} points awarded to {selectedGuest?.Name}!";
        isError = false;
        nightsToAward = 1;
        StateHasChanged();

        await Task.Delay(3000);
        feedbackMessage = "";
        StateHasChanged();
    }

    private async Task RedeemPoints()
    {
        if (selectedGuest == null || redeemPoints < 100) return;
        var (success, discount) = await LoyaltyService.RedeemPointsAsync(selectedGuest.Id, redeemPoints);
        if (success)
        {
            var all = await ReservationService.GetReservationsAsync();
            var booking = all.Where(r => r.GuestEmail == selectedGuest.Email && r.Status == "Confirmed")
                             .OrderByDescending(r => r.Created_at).FirstOrDefault();
            if (booking != null)
            {
                booking.TotalPrice = Math.Max(booking.TotalPrice - discount, 0);
                await ReservationService.UpdateReservationAsync(booking);
                feedbackMessage = $"✅ Rs. {discount} discount applied to {booking.BookingReference}! New total: Rs. {booking.TotalPrice}";
            }
            else
            {
                feedbackMessage = $"✅ {redeemPoints} points redeemed! Rs. {discount} credit saved.";
            }
            var dbHistory = await LoyaltyService.GetHistoryAsync(selectedGuest!.Id);
            pointsHistory = dbHistory.Select(h => new PointsEntry
                {
                    Description = h.Description,
                    Points = h.Points,
                    IsEarn = h.IsEarn
                }).ToList();
            selectedGuest = await GuestService.GetGuestByIdAsync(selectedGuest.Id);
            isError = false;
            redeemPoints = 0;
        }
        else
        {
            feedbackMessage = "❌ Insufficient points. Minimum 100 required.";
            isError = true;
        }
        StateHasChanged();

        await Task.Delay(3000);
        feedbackMessage = "";
        StateHasChanged();
    }

    private async Task GoBack() => await JSRuntime.InvokeVoidAsync("history.back");
    private string GetTierEmoji(string tier) => tier switch { "Gold" => "🥇", "Silver" => "🥈", _ => "🥉" };
    private string GetTierClass(string tier) => tier switch { "Gold" => "tier-gold", "Silver" => "tier-silver", _ => "tier-bronze" };
    private int GetProgressPercent(int points) { if (points >= 5000) return 100; if (points >= 1000) return (points - 1000) * 100 / 4000; return points * 100 / 1000; }
    private string GetNextTierText(int points) { if (points >= 5000) return "🎉 Maximum tier achieved!"; if (points >= 1000) return $"{5000 - points} pts to Gold"; return $"{1000 - points} pts to Silver"; }

    public class PointsEntry { public string Description { get; set; } = ""; public int Points { get; set; } public bool IsEarn { get; set; } }
}

<style>
    .lp-root {
        min-height: 100vh;
        background: #f4f6f0;
        padding: 2rem;
        font-family: 'Segoe UI', sans-serif;
        color: #1a2416;
    }

    .lp-header {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        margin-bottom: 2.5rem;
    }

    .lp-header-left {
        display: flex;
        gap: 0.75rem;
    }

    .lp-title {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        justify-content: center;
    }

        .lp-title h1 {
            font-size: 1.8rem;
            font-weight: 700;
            margin: 0;
            color: #1a2416;
        }

    .star-icon {
        color: #c8a84b;
        font-size: 1.2rem;
    }

    .btn-back {
        padding: 8px 18px;
        background: white;
        border: 1.5px solid #d0d8c8;
        border-radius: 10px;
        cursor: pointer;
        font-size: 0.9rem;
        color: #4a5a44;
        transition: all 0.2s;
    }

        .btn-back:hover {
            background: #edf2e8;
            border-color: #2e7d32;
        }

    .guest-picker {
        margin-bottom: 2rem;
    }

    .picker-label {
        display: block;
        font-size: 0.78rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        color: #7a8a74;
        margin-bottom: 8px;
    }

    .select-wrapper {
        position: relative;
        max-width: 480px;
    }

        .select-wrapper select {
            width: 100%;
            padding: 14px 44px 14px 16px;
            background: white;
            border: 1.5px solid #d0d8c8;
            border-radius: 12px;
            font-size: 1rem;
            color: #1a2416;
            appearance: none;
            cursor: pointer;
            transition: border-color 0.2s;
        }

            .select-wrapper select:focus {
                outline: none;
                border-color: #2e7d32;
            }

    .select-arrow {
        position: absolute;
        right: 16px;
        top: 50%;
        transform: translateY(-50%);
        color: #7a8a74;
        pointer-events: none;
    }

    .empty-state {
        text-align: center;
        padding: 5rem 2rem;
        color: #9aaa94;
    }

    .empty-icon {
        font-size: 4rem;
        margin-bottom: 1rem;
        opacity: 0.4;
    }

    .lp-body {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.5rem;
    }

    .lp-left, .lp-right {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .tier-card {
        position: relative;
        border-radius: 20px;
        padding: 1.75rem;
        overflow: hidden;
        color: white;
    }

    .tier-gold {
        background: linear-gradient(135deg, #b8860b, #daa520, #ffd700);
    }

    .tier-silver {
        background: linear-gradient(135deg, #5a6a6a, #8a9a9a, #b0c0c0);
    }

    .tier-bronze {
        background: linear-gradient(135deg, #7a4a1a, #a0642a, #cd7f32);
    }

    .tier-card-bg {
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 80% 20%, rgba(255,255,255,0.15) 0%, transparent 60%);
    }

    .tier-card-content {
        position: relative;
        z-index: 1;
    }

    .tier-top {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .tier-emblem {
        font-size: 2.5rem;
    }

    .tier-name {
        display: block;
        font-size: 1.3rem;
        font-weight: 700;
    }

    .tier-sub {
        font-size: 0.78rem;
        opacity: 0.8;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .tier-points-display {
        margin-bottom: 1.25rem;
    }

    .tier-points-num {
        font-size: 3rem;
        font-weight: 800;
        line-height: 1;
    }

    .tier-points-label {
        display: block;
        font-size: 0.72rem;
        opacity: 0.8;
        letter-spacing: 2px;
        margin-top: 2px;
    }

    .tier-progress-bar {
        background: rgba(255,255,255,0.25);
        border-radius: 99px;
        height: 6px;
        overflow: hidden;
        margin-bottom: 6px;
    }

    .tier-progress-fill {
        height: 100%;
        background: white;
        border-radius: 99px;
        transition: width 0.5s ease;
    }

    .tier-next {
        font-size: 0.8rem;
        opacity: 0.85;
    }

    .guest-info-card {
        background: white;
        border-radius: 16px;
        padding: 1.25rem;
        display: flex;
        align-items: center;
        gap: 1rem;
        border: 1.5px solid #e8ede4;
    }

    .guest-avatar {
        width: 48px;
        height: 48px;
        background: #2e7d32;
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        font-weight: 700;
        flex-shrink: 0;
    }

    .guest-details h3 {
        margin: 0 0 2px;
        font-size: 1rem;
        font-weight: 600;
    }

    .guest-details p {
        margin: 1px 0;
        font-size: 0.82rem;
        color: #7a8a74;
    }

    .action-card {
        background: white;
        border-radius: 16px;
        padding: 1.5rem;
        border: 1.5px solid #e8ede4;
    }

    .action-card-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
    }

    .action-icon {
        font-size: 1.2rem;
    }

    .action-card-header h4 {
        margin: 0;
        font-size: 1rem;
        font-weight: 600;
    }

    .action-hint {
        font-size: 0.82rem;
        color: #9aaa94;
        margin-bottom: 1.25rem;
    }

    .nights-input-row {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1.5rem;
        margin: 1rem 0;
    }

    .stepper-btn {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        border: 1.5px solid #d0d8c8;
        background: white;
        font-size: 1.3rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #2e7d32;
        transition: all 0.2s;
    }

        .stepper-btn:hover {
            background: #edf2e8;
            border-color: #2e7d32;
        }

    .nights-display {
        text-align: center;
    }

    .nights-num {
        display: block;
        font-size: 2.5rem;
        font-weight: 800;
        color: #1a2416;
        line-height: 1;
    }

    .nights-label {
        font-size: 0.72rem;
        color: #9aaa94;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .award-preview {
        text-align: center;
        background: #f0f7f0;
        border-radius: 10px;
        padding: 10px;
        font-size: 1rem;
        color: #2e7d32;
        margin-bottom: 1rem;
    }

    .btn-award {
        width: 100%;
        padding: 12px;
        background: #2e7d32;
        color: white;
        border: none;
        border-radius: 12px;
        font-size: 0.95rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
    }

        .btn-award:hover {
            background: #1b5e20;
        }

    .redeem-card {
        background: #fffdf5;
        border-color: #e8dfc0;
    }

    .balance-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: #fdf5dc;
        border: 1px solid #e8dfc0;
        border-radius: 99px;
        padding: 6px 14px;
        font-size: 0.85rem;
        color: #8a6a14;
        margin-bottom: 1.25rem;
    }

    .slider-section {
        margin-bottom: 1rem;
    }

    .lp-slider {
        width: 100%;
        accent-color: #c8a84b;
        cursor: pointer;
    }

    .slider-ends {
        display: flex;
        justify-content: space-between;
        font-size: 0.78rem;
        color: #9aaa94;
        margin-top: 4px;
    }

    .redeem-calc {
        background: white;
        border-radius: 10px;
        padding: 12px 14px;
        margin-bottom: 1rem;
        border: 1px solid #e8dfc0;
    }

    .calc-row {
        display: flex;
        justify-content: space-between;
        font-size: 0.9rem;
        padding: 3px 0;
    }

    .calc-divider {
        height: 1px;
        background: #e8dfc0;
        margin: 6px 0;
    }

    .discount-row strong {
        color: #c8a84b;
        font-size: 1.05rem;
    }

    .btn-redeem {
        width: 100%;
        padding: 12px;
        background: #c8a84b;
        color: white;
        border: none;
        border-radius: 12px;
        font-size: 0.9rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
    }

        .btn-redeem:hover:not(:disabled) {
            background: #a8882b;
        }

        .btn-redeem:disabled {
            background: #d8d0c0;
            color: #a0988a;
            cursor: not-allowed;
        }

    .history-card {
        background: white;
        border-radius: 16px;
        padding: 1.5rem;
        border: 1.5px solid #e8ede4;
    }

    .history-list {
        display: flex;
        flex-direction: column;
        gap: 2px;
        max-height: 220px;
        overflow-y: auto;
    }

    .history-row {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 10px 8px;
        border-radius: 8px;
        transition: background 0.15s;
    }

        .history-row:hover {
            background: #f8faf6;
        }

    .history-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .dot-earn {
        background: #2e7d32;
    }

    .dot-redeem {
        background: #c8a84b;
    }

    .history-desc {
        flex: 1;
        font-size: 0.88rem;
        color: #4a5a44;
    }

    .history-pts {
        font-size: 0.88rem;
        font-weight: 700;
    }

    .pts-earn {
        color: #2e7d32;
    }

    .pts-redeem {
        color: #c8a84b;
    }

    .no-history {
        text-align: center;
        color: #9aaa94;
        font-size: 0.9rem;
        padding: 1rem;
    }

    .feedback-toast {
        margin-top: 1.5rem;
        padding: 14px 20px;
        border-radius: 12px;
        font-size: 0.95rem;
        font-weight: 500;
    }

    .toast-success {
        background: #edf7ed;
        color: #1a5e1a;
        border: 1px solid #c3e6c3;
    }

    .toast-error {
        background: #fdf0f0;
        color: #8a1a1a;
        border: 1px solid #f0c3c3;
    }

    @@media (max-width: 768px) {
        .lp-body {
            grid-template-columns: 1fr;
        }

        .lp-header {
            grid-template-columns: 1fr;
            gap: 1rem;
        }

        .lp-header-left {
            justify-content: center;
        }

        .lp-header-right {
            display: none;
        }

        .lp-title {
            order: -1;
        }
    }
</style>

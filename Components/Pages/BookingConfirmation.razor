@page "/booking-confirmation/{BookingReference}"
@using LodgeStay.Models
@using LodgeStay.Services
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject ReservationService ReservationService

<div class="confirmation-container">
    <div class="glass-panel receipt-card">
        
        <div class="success-header">
            <div class="glow-icon">✨</div>
            <h2 class="success-title">Booking Confirmed!</h2>
            <p class="booking-id">Reference: <span class="ref-code">@BookingReference</span></p>
        </div>

        @if (isLoading)
        {
            <div class="loading-state">
                <div class="spinner"></div>
                <p>Generating your receipt...</p>
            </div>
        }
        else if (reservation != null)
        {
            <div class="receipt-body">
                <!-- Stay Details Section -->
                <div class="glass-panel inner-section">
                    <h4 class="section-title">Guest & Stay Details</h4>
                    <div class="detail-grid">
                        <div class="detail-item">
                            <span class="detail-label">Guest Name</span>
                            <span class="detail-value">@reservation.GuestName</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Room</span>
                            <span class="detail-value">Room @reservation.Room_ID</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Check-in</span>
                            <span class="detail-value">@reservation.CheckIn.ToString("dd MMM yyyy")</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Check-out</span>
                            <span class="detail-value">@reservation.CheckOut.ToString("dd MMM yyyy")</span>
                        </div>
                        <div class="detail-item full-width">
                            <span class="detail-label">Status</span>
                            <span class="detail-value status-badge">@reservation.Status</span>
                        </div>
                    </div>
                </div>

                <!-- Payment Section -->
                <div class="glass-panel inner-section payment-section">
                    <h4 class="section-title">Payment Breakdown</h4>
                    <div class="detail-row">
                        <span class="detail-label">Room Charges</span>
                        <span class="detail-value">Rs. @reservation.TotalPrice.ToString("N0")</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Taxes & Fees</span>
                        <span class="detail-value">Included</span>
                    </div>
                    <div class="divider"></div>
                    <div class="detail-row total-row">
                        <span class="detail-label">Total Paid</span>
                        <span class="total-price">Rs. @reservation.TotalPrice.ToString("N0")</span>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="error-state">
                <span class="error-icon">⚠️</span>
                <p>Booking not found.</p>
                <span class="error-sub">Please check your reference number and try again.</span>
            </div>
        }

        <div class="actions">
            <button class="glass-button btn-action" @onclick="GoHome">
                <span class="icon">🏠</span> Home
            </button>
            <button class="glass-button btn-action primary-action" @onclick="GoToReservations">
                <span class="icon">📋</span> View Bookings
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public string BookingReference { get; set; } = "";

    private Reservation? reservation = null;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadBookingDetails();
    }

    private async Task LoadBookingDetails()
    {
        isLoading = true;

        var guestName = GetQueryString("guest");
        var room = GetQueryString("room");
        var checkin = GetQueryString("checkin");
        var checkout = GetQueryString("checkout");
        var total = GetQueryString("total");

        if (!string.IsNullOrEmpty(guestName) && !string.IsNullOrEmpty(room))
        {
            reservation = new Reservation
                {
                    BookingReference = BookingReference,
                    GuestName = Uri.UnescapeDataString(guestName),
                    Room_ID = int.TryParse(room, out int roomId) ? roomId : 0,
                    CheckIn = DateTime.TryParse(checkin, out DateTime ci) ? ci : DateTime.Now,
                    CheckOut = DateTime.TryParse(checkout, out DateTime co) ? co : DateTime.Now.AddDays(1),
                    TotalPrice = double.TryParse(total, out double price) ? price : 0,
                    Status = "Confirmed"
                };
        }
        else
        {
            reservation = await ReservationService.GetReservationByReferenceAsync(BookingReference);
        }

        isLoading = false;
    }

    private string GetQueryString(string key)
    {
        var uri = new Uri(Navigation.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        return query[key] ?? "";
    }

    private async Task GoHome()
    {
        await JSRuntime.InvokeVoidAsync("history.back");
    }

    private void GoToReservations()
    {
        Navigation.NavigateTo("/reservations");
    }
}

<style>
    .confirmation-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        padding: 2rem;
        background: radial-gradient(circle at center, rgba(187, 134, 252, 0.1) 0%, transparent 70%);
    }

    .receipt-card {
        padding: 3rem;
        width: 100%;
        max-width: 600px;
        text-align: center;
        border-top: 5px solid var(--accent-purple) !important;
        position: relative;
        overflow: hidden;
    }

    /* Ambient glow behind card */
    .receipt-card::before {
        content: '';
        position: absolute;
        top: -50px;
        left: 50%;
        transform: translateX(-50%);
        width: 150px;
        height: 150px;
        background: var(--accent-purple);
        filter: blur(80px);
        opacity: 0.3;
        z-index: 0;
        pointer-events: none;
    }

    .success-header {
        position: relative;
        z-index: 1;
        margin-bottom: 2rem;
    }

    .glow-icon {
        font-size: 3.5rem;
        margin-bottom: 1rem;
        filter: drop-shadow(0 0 15px rgba(187, 134, 252, 0.8));
    }

    .success-title {
        font-size: 2.2rem;
        font-weight: 800;
        margin-bottom: 0.5rem;
        background: linear-gradient(to right, #fff, var(--accent-purple));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .booking-id {
        color: #94a3b8;
        font-size: 1rem;
    }

    .ref-code {
        color: #fff;
        font-family: monospace;
        background: rgba(255,255,255,0.1);
        padding: 4px 10px;
        border-radius: 6px;
        letter-spacing: 1px;
    }

    .receipt-body {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        text-align: left;
    }

    .inner-section {
        background: rgba(0,0,0,0.2) !important;
        padding: 1.5rem !important;
        border: 1px solid rgba(255,255,255,0.05) !important;
    }

    .section-title {
        font-size: 1.1rem;
        color: var(--accent-purple) !important;
        margin-bottom: 1.2rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid rgba(255,255,255,0.1);
    }

    .detail-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.2rem;
    }

    .detail-item {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
    }

    .full-width { grid-column: 1 / -1; }

    .detail-label {
        font-size: 0.85rem;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .detail-value {
        font-size: 1.05rem;
        color: #f1f5f9;
        font-weight: 600;
    }

    .status-badge {
        display: inline-block;
        background: rgba(3, 218, 198, 0.15);
        color: #03dac6;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.9rem;
        border: 1px solid rgba(3, 218, 198, 0.3);
        width: fit-content;
    }

    .payment-section {
        background: rgba(187, 134, 252, 0.05) !important;
        border-color: rgba(187, 134, 252, 0.2) !important;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.8rem;
    }
    
    .detail-row:last-child { margin-bottom: 0; }

    .divider {
        height: 1px;
        background: rgba(255,255,255,0.1);
        margin: 1rem 0;
        border-style: dashed;
    }

    .total-row .detail-label {
        font-size: 1.1rem;
        color: #e2e8f0;
    }

    .total-price {
        font-size: 1.6rem;
        font-weight: 800;
        color: #fff;
    }

    .actions {
        display: flex;
        gap: 1rem;
        margin-top: 2.5rem;
        position: relative;
        z-index: 1;
    }

    .btn-action {
        flex: 1;
        padding: 14px;
        font-size: 1rem;
        font-weight: 600;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
    }

    .primary-action {
        background: rgba(187, 134, 252, 0.2) !important;
    }

    /* Loading / Error States */
    .loading-state, .error-state {
        padding: 3rem 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
    }
    .spinner {
        width: 40px; height: 40px;
        border: 3px solid rgba(255,255,255,0.1);
        border-top-color: var(--accent-purple);
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }
    @@keyframes spin { to { transform: rotate(360deg); } }
    
    .error-icon { font-size: 3rem; }
    .error-state p { font-size: 1.2rem; color: #f87171; font-weight: 600; margin: 0; }
    .error-sub { color: #94a3b8; font-size: 0.9rem; }
</style>
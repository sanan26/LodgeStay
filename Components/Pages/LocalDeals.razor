@page "/localdeals"
@using LodgeStay.Services
@using LodgeStay.Models
@inject DealService DealService
@inject ReservationService ReservationService
@inject SessionService SessionService
@inject LodgeStay.Data.DatabaseContext DbContext

<div class="market-container">
    <div class="tab-switcher">
        <button class="tab-btn @(activeTab == "browse" ? "active" : "")" @onclick='() => activeTab = "browse"'>Browse Offers</button>
        <button class="tab-btn @(activeTab == "attach" ? "active" : "")" @onclick='() => activeTab = "attach"'>Attach to Booking</button>
        @if (isManager)
        {
            <button class="tab-btn @(activeTab == "manage" ? "active" : "")" @onclick='() => activeTab = "manage"'>Manage Partners</button>
        }
    </div>

    <div class="tab-content-area">
        <!-- ── TAB 1: Browse Deals ── -->
        @if (activeTab == "browse")
        {
            @if (isLoading)
            {
                <div class="loading-state"><div class="spinner"></div></div>
            }
            else if (activeDeals.Count == 0)
            {
                <div class="empty-glass">
                    <span class="icon">🏪</span>
                    <p>No active deals available in the marketplace.</p>
                </div>
            }
            else
            {
                <div class="deals-masonry">
                    @foreach (var deal in activeDeals)
                    {
                        <div class="deal-card">
                            <div class="deal-card-inner">
                                <div class="deal-top">
                                    <h3 class="deal-partner">@deal.PartnerName</h3>
                                    @if (deal.Price > 0)
                                    {
                                        <span class="deal-price">PKR @deal.Price.ToString("N0")</span>
                                    }
                                    else
                                    {
                                        <span class="deal-price free">Complimentary</span>
                                    }
                                </div>
                                <p class="deal-desc">@deal.Description</p>
                                
                                <div class="deal-actions">
                                    <button class="btn-attach-quick" @onclick='() => { activeTab = "attach"; preselectedDealId = deal.Id; }'>
                                        <span>+ Add to Cart</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }

        <!-- ── TAB 2: Attach Deals ── -->
        @if (activeTab == "attach")
        {
            <div class="attach-layout">
                <!-- Search & Select Column -->
                <div class="attach-col glass-panel">
                    <h3 class="col-title">Lookup Booking</h3>
                    <div class="search-box">
                        <input type="number" class="glass-input" @bind="attachReservationId" placeholder="Enter Reservation ID..." />
                        <button class="btn-search" @onclick="LoadReservationForAttach">🔍 Load</button>
                    </div>

                    @if (attachReservation != null)
                    {
                        <div class="booking-card">
                            <div class="b-left">
                                <span class="b-name">@attachReservation.GuestName</span>
                                <span class="b-ref">ID: @attachReservation.BookingReference</span>
                            </div>
                            <div class="b-right">
                                <span class="b-dates">@attachReservation.CheckIn.ToString("dd MMM") → @attachReservation.CheckOut.ToString("dd MMM")</span>
                            </div>
                        </div>

                        <h4 class="sub-title">Select Offers (max 3)</h4>
                        <div class="offer-list">
                            @foreach (var deal in activeDeals)
                            {
                                var isAttached = attachedDealIds.Contains(deal.Id);
                                <div class="offer-row @(isAttached ? "selected" : "")" 
                                     @onclick="() => ToggleDeal(deal.Id, !isAttached)">
                                    <div class="checkbox @(isAttached ? "checked" : "")"></div>
                                    <div class="offer-info">
                                        <span class="o-name">@deal.PartnerName</span>
                                    </div>
                                    <span class="o-price @(deal.Price == 0 ? "free" : "")">
                                        @(deal.Price > 0 ? $"PKR {deal.Price:N0}" : "Free")
                                    </span>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Cart / Confirmation Column -->
                <div class="attach-col">
                    @if (attachReservation != null)
                    {
                        <div class="cart-panel glass-panel">
                            <h3 class="col-title">Booking Cart</h3>
                            
                            @if (attachedDealIds.Count == 0)
                            {
                                <div class="empty-cart">
                                    <span>🛒</span>
                                    <p>No offers selected yet</p>
                                </div>
                            }
                            else
                            {
                                <div class="cart-items">
                                    @foreach (var id in attachedDealIds)
                                    {
                                        var d = activeDeals.FirstOrDefault(x => x.Id == id);
                                        if (d != null)
                                        {
                                            <div class="cart-item">
                                                <span>@d.PartnerName</span>
                                                <strong>@(d.Price > 0 ? $"Rs. {d.Price:N0}" : "Free")</strong>
                                            </div>
                                        }
                                    }
                                </div>
                                <div class="cart-total">
                                    <span>Total Added Value</span>
                                    <strong>PKR @activeDeals.Where(d => attachedDealIds.Contains(d.Id)).Sum(d => d.Price).ToString("N0")</strong>
                                </div>
                                
                                <button class="btn-confirm" @onclick="ConfirmAttach">
                                    Confirm Attachment
                                </button>
                            }

                            @if (showConfirmation)
                            {
                                <div class="@(attachSuccess ? "toast-success" : "toast-error") mt-1">
                                    @attachMessage
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="empty-glass subtle">
                            <p>Load a booking to begin attaching offers.</p>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- ── TAB 3: Manage ── -->
        @if (activeTab == "manage" && isManager)
        {
            <div class="manage-layout">
                <!-- Add Form -->
                <div class="glass-panel add-panel">
                    <h3 class="col-title">Register New Partner</h3>
                    <div class="form-grid">
                        <div class="form-group">
                            <label>Partner / Vendor Name</label>
                            <input type="text" class="glass-input" @bind="newDeal.PartnerName" placeholder="e.g. Desert Safari" />
                        </div>
                        <div class="form-group">
                            <label>Price (PKR) - 0 for Free</label>
                            <input type="number" class="glass-input" @bind="newDealPrice" />
                        </div>
                        <div class="form-group full">
                            <label>Description</label>
                            <textarea class="glass-input textarea" @bind="newDeal.Description" rows="3"></textarea>
                        </div>
                    </div>
                    <button class="btn-action" @onclick="AddDeal">+ Add to Marketplace</button>
                    @if (!string.IsNullOrEmpty(managerMessage))
                    {
                        <div class="toast @(managerSuccess ? "toast-success" : "toast-error") mt-1">@managerMessage</div>
                    }
                </div>

                <!-- Data Table -->
                <div class="glass-panel table-panel">
                    <h3 class="col-title">Partner Directory</h3>
                    <div class="table-wrap">
                        <table class="dark-table">
                            <thead>
                                <tr>
                                    <th>Partner</th>
                                    <th>Price</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var deal in allDeals)
                                {
                                    <tr class="@(deal.IsActive ? "" : "dimmed")">
                                        <td>
                                            <div class="t-main">@deal.PartnerName</div>
                                            <div class="t-sub">@deal.Description</div>
                                        </td>
                                        <td class="t-price @(deal.Price == 0 ? "free" : "")">
                                            @(deal.Price > 0 ? $"PKR {deal.Price:N0}" : "Free")
                                        </td>
                                        <td>
                                            <span class="status-badge @(deal.IsActive ? "s-active" : "s-inactive")">
                                                @(deal.IsActive ? "Active" : "Inactive")
                                            </span>
                                        </td>
                                        <td>
                                            <button class="btn-toggle-status" @onclick="() => ToggleDealStatus(deal)">
                                                @(deal.IsActive ? "Deactivate" : "Activate")
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private string activeTab = "browse";
    private bool isManager = false;
    private bool isLoading = true;

    private List<LocalDeal> activeDeals = new();
    private List<LocalDeal> allDeals = new();

    private int attachReservationId;
    private int preselectedDealId = -1;
    private Reservation? attachReservation;
    private HashSet<int> attachedDealIds = new();
    private List<LocalDeal> confirmedDeals = new();
    private bool showConfirmation = false;
    private string attachMessage = "";
    private bool attachSuccess = false;

    private LocalDeal newDeal = new();
    private double newDealPrice;
    private string managerMessage = "";
    private bool managerSuccess = false;

    protected override async Task OnInitializedAsync()
    {
        var user = SessionService.CurrentUser;
        isManager = user != null && (user.Role == "Manager" || user.Role == "Owner");

        activeDeals = await DealService.GetActiveDealsAsync();
        if (isManager)
            allDeals = await DealService.GetAllDealsAsync();

        isLoading = false;
    }

    private async Task LoadReservationForAttach()
    {
        if (attachReservationId <= 0) return;
        attachReservation = await DbContext.GetReservationByIdAsync(attachReservationId);
        attachedDealIds.Clear();
        showConfirmation = false;
        attachMessage = "";

        if (preselectedDealId > 0)
            attachedDealIds.Add(preselectedDealId);
    }

    private void ToggleDeal(int dealId, bool isChecked)
    {
        if (isChecked && attachedDealIds.Count < 3)
            attachedDealIds.Add(dealId);
        else
            attachedDealIds.Remove(dealId);
    }

    private async Task ConfirmAttach()
    {
        attachMessage = "";
        if (attachReservation == null || attachedDealIds.Count == 0) return;

        await DealService.AttachDealsToReservationAsync(attachReservation.Reservation_ID, attachedDealIds.ToList());
        confirmedDeals = activeDeals.Where(d => attachedDealIds.Contains(d.Id)).ToList();
        showConfirmation = true;
        attachMessage = $"✅ {attachedDealIds.Count} deal(s) attached to booking {attachReservation.BookingReference}.";
        attachSuccess = true;
    }

    private async Task AddDeal()
    {
        managerMessage = "";
        if (string.IsNullOrWhiteSpace(newDeal.PartnerName) || string.IsNullOrWhiteSpace(newDeal.Description))
        {
            managerMessage = "Partner name and description are required.";
            managerSuccess = false;
            return;
        }

        await DealService.AddDealAsync(newDeal.PartnerName, newDeal.Description, newDealPrice);
        managerMessage = "✅ Deal added successfully.";
        managerSuccess = true;

        allDeals = await DealService.GetAllDealsAsync();
        activeDeals = await DealService.GetActiveDealsAsync();
        newDeal = new();
        newDealPrice = 0;
    }

    private async Task ToggleDealStatus(LocalDeal deal)
    {
        deal.IsActive = !deal.IsActive;
        await DealService.UpdateDealAsync(deal.Id, deal.PartnerName, deal.Description, deal.Price);
        activeDeals = await DealService.GetActiveDealsAsync();
    }
}

<style>
    .market-container { padding: 2rem; max-width: 1200px; margin: 0 auto; color: #e2e8f0; font-family: 'Inter', sans-serif; }

    /* Header & Tabs */
    .market-header { margin-bottom: 2rem; }
    .header-content { margin-bottom: 1.5rem; text-align: center; }
    .market-title { font-size: 2.2rem; font-weight: 700; color: #fff; margin: 0 0 0.5rem 0; letter-spacing: -0.5px; }
    .market-sub { color: #94a3b8; font-size: 1rem; margin: 0; }

    .tab-switcher { display: flex; justify-content: center; gap: 0.5rem; background: rgba(255,255,255,0.03); padding: 0.5rem; border-radius: 50px; border: 1px solid rgba(255,255,255,0.05); max-width: fit-content; margin: 0 auto; }
    .tab-btn { background: transparent; border: none; padding: 0.6rem 1.5rem; border-radius: 30px; color: #94a3b8; font-weight: 600; cursor: pointer; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
    .tab-btn:hover { color: #fff; }
    .tab-btn.active { background: var(--accent-purple); color: #000; box-shadow: 0 4px 15px rgba(187, 134, 252, 0.3); }

    /* Glass Panels */
    .glass-panel { background: #13181f; border-radius: 16px; border: 1px solid rgba(255,255,255,0.05); padding: 1.8rem; box-shadow: 0 8px 30px rgba(0,0,0,0.3); }
    .glass-input { width: 100%; background: #1e2430; border: 1px solid rgba(255,255,255,0.1); color: #fff; padding: 0.8rem 1rem; border-radius: 10px; font-size: 0.95rem; transition: border-color 0.2s; }
    .glass-input:focus { outline: none; border-color: var(--accent-purple); box-shadow: 0 0 0 2px rgba(187, 134, 252, 0.15); }
    
    .col-title { font-size: 1.2rem; font-weight: 600; color: #fff; margin: 0 0 1.5rem 0; border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 0.8rem; }

    /* ── Browse Deals Masonry ── */
    .deals-masonry { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem; }
    
    .deal-card { position: relative; background: #13181f; border-radius: 16px; border: 1px solid rgba(255,255,255,0.05); overflow: hidden; transition: transform 0.3s, box-shadow 0.3s; }
    .deal-card:hover { transform: translateY(-5px); box-shadow: 0 12px 30px rgba(0,0,0,0.4); border-color: rgba(187, 134, 252, 0.3); }
    .deal-card::before { content: ""; position: absolute; top: 0; left: 0; right: 0; height: 4px; background: linear-gradient(90deg, var(--accent-purple), #03dac6); }
    
    .deal-card-inner { padding: 1.5rem; display: flex; flex-direction: column; height: 100%; }
    .deal-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem; gap: 1rem; }
    .deal-partner { margin: 0; font-size: 1.1rem; font-weight: 700; color: #fff; line-height: 1.3; }
    
    .deal-price { font-weight: 700; color: var(--accent-purple); font-size: 1.1rem; white-space: nowrap; }
    .deal-price.free { color: #03dac6; }
    
    .deal-desc { color: #94a3b8; font-size: 0.9rem; line-height: 1.6; margin: 0 0 1.5rem 0; flex: 1; }
    
    .btn-attach-quick { width: 100%; background: rgba(187, 134, 252, 0.1); color: var(--accent-purple); border: 1px solid rgba(187, 134, 252, 0.2); padding: 0.8rem; border-radius: 10px; font-weight: 600; cursor: pointer; transition: all 0.2s; }
    .btn-attach-quick:hover { background: rgba(187, 134, 252, 0.2); transform: scale(1.02); }

    /* ── Attach Layout ── */
    .attach-layout { display: grid; grid-template-columns: 1.2fr 1fr; gap: 2rem; align-items: start; }
    
    .search-box { display: flex; gap: 0.5rem; margin-bottom: 1.5rem; }
    .btn-search { background: rgba(255,255,255,0.05); color: #fff; border: 1px solid rgba(255,255,255,0.1); border-radius: 10px; padding: 0 1.2rem; cursor: pointer; font-weight: 600; transition: background 0.2s; }
    .btn-search:hover { background: rgba(255,255,255,0.1); }

    .booking-card { display: flex; justify-content: space-between; align-items: center; background: rgba(187, 134, 252, 0.1); border: 1px solid rgba(187, 134, 252, 0.2); padding: 1rem 1.2rem; border-radius: 12px; margin-bottom: 1.5rem; }
    .b-name { display: block; font-weight: 700; color: #fff; font-size: 1.05rem; }
    .b-ref { font-size: 0.8rem; color: #cbd5e1; font-family: monospace; }
    .b-dates { background: var(--accent-purple); color: #000; padding: 4px 10px; border-radius: 6px; font-size: 0.8rem; font-weight: 700; }

    .sub-title { font-size: 0.95rem; color: #94a3b8; margin: 0 0 1rem 0; text-transform: uppercase; letter-spacing: 1px; }

    .offer-list { display: flex; flex-direction: column; gap: 0.5rem; }
    .offer-row { display: flex; align-items: center; gap: 1rem; padding: 1rem; background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); border-radius: 10px; cursor: pointer; transition: all 0.2s; }
    .offer-row:hover { background: rgba(255,255,255,0.04); }
    .offer-row.selected { background: rgba(187, 134, 252, 0.1); border-color: var(--accent-purple); }
    
    .checkbox { width: 20px; height: 20px; border: 2px solid #64748b; border-radius: 6px; transition: all 0.2s; display: flex; justify-content: center; align-items: center; }
    .checkbox.checked { background: var(--accent-purple); border-color: var(--accent-purple); }
    .checkbox.checked::after { content: "✓"; color: #000; font-size: 0.8rem; font-weight: bold; }
    
    .offer-info { flex: 1; }
    .o-name { font-weight: 600; color: #fff; }
    .o-price { font-weight: 700; color: var(--accent-purple); }
    .o-price.free { color: #03dac6; }

    /* Cart Panel */
    .cart-panel { position: sticky; top: 2rem; }
    .empty-cart { text-align: center; padding: 3rem 0; color: #64748b; }
    .empty-cart span { font-size: 3rem; opacity: 0.5; display: block; margin-bottom: 1rem; }
    
    .cart-items { display: flex; flex-direction: column; gap: 0.8rem; margin-bottom: 1.5rem; }
    .cart-item { display: flex; justify-content: space-between; padding-bottom: 0.8rem; border-bottom: 1px solid rgba(255,255,255,0.05); color: #cbd5e1; }
    
    .cart-total { display: flex; justify-content: space-between; align-items: center; padding: 1rem; background: rgba(255,255,255,0.03); border-radius: 10px; margin-bottom: 1.5rem; }
    .cart-total span { color: #94a3b8; font-size: 0.9rem; text-transform: uppercase; letter-spacing: 1px; }
    .cart-total strong { font-size: 1.4rem; color: #fff; }
    
    .btn-confirm { width: 100%; background: var(--accent-purple); color: #000; border: none; padding: 1rem; border-radius: 10px; font-weight: 700; font-size: 1rem; cursor: pointer; transition: all 0.2s; }
    .btn-confirm:hover { background: #9d4edd; box-shadow: 0 0 20px rgba(187, 134, 252, 0.4); }

    /* ── Manage Layout ── */
    .manage-layout { display: flex; flex-direction: column; gap: 2rem; }
    
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem; }
    .form-group { display: flex; flex-direction: column; gap: 0.5rem; }
    .form-group label { font-size: 0.85rem; color: #94a3b8; font-weight: 600; }
    .form-group.full { grid-column: 1 / -1; }
    .textarea { resize: vertical; min-height: 80px; }
    
    .btn-action { background: rgba(3, 218, 198, 0.1); color: #03dac6; border: 1px solid rgba(3, 218, 198, 0.3); padding: 0.8rem 1.5rem; border-radius: 10px; font-weight: 600; cursor: pointer; transition: all 0.2s; }
    .btn-action:hover { background: rgba(3, 218, 198, 0.2); }

    .table-wrap { overflow-x: auto; }
    .dark-table { width: 100%; border-collapse: collapse; text-align: left; }
    .dark-table th { padding: 1rem; color: #94a3b8; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1px; border-bottom: 1px solid rgba(255,255,255,0.05); }
    .dark-table td { padding: 1rem; border-bottom: 1px solid rgba(255,255,255,0.05); }
    
    .dimmed { opacity: 0.5; }
    .t-main { font-weight: 600; color: #fff; }
    .t-sub { font-size: 0.8rem; color: #94a3b8; margin-top: 2px; }
    .t-price { font-weight: 600; color: #cbd5e1; }
    .t-price.free { color: #03dac6; }
    
    .status-badge { padding: 4px 10px; border-radius: 6px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; }
    .s-active { background: rgba(3, 218, 198, 0.15); color: #03dac6; }
    .s-inactive { background: rgba(239, 68, 68, 0.15); color: #ef4444; }
    
    .btn-toggle-status { background: transparent; border: 1px solid rgba(255,255,255,0.2); color: #cbd5e1; padding: 4px 12px; border-radius: 6px; font-size: 0.8rem; cursor: pointer; transition: all 0.2s; }
    .btn-toggle-status:hover { background: rgba(255,255,255,0.1); color: #fff; }

    /* Utility */
    .empty-glass { text-align: center; padding: 4rem 2rem; background: rgba(255,255,255,0.02); border-radius: 16px; border: 1px dashed rgba(255,255,255,0.1); }
    .empty-glass.subtle { background: transparent; border: none; opacity: 0.7; }
    .empty-glass .icon { font-size: 3rem; opacity: 0.4; display: block; margin-bottom: 1rem; }
    
    .toast { padding: 0.8rem 1.2rem; border-radius: 8px; font-size: 0.9rem; font-weight: 600; }
    .toast-success { background: rgba(16, 185, 129, 0.1); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.2); }
    .toast-error { background: rgba(239, 68, 68, 0.1); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.2); }
    .mt-1 { margin-top: 1rem; }

    @@media (max-width: 900px) {
        .attach-layout { grid-template-columns: 1fr; }
        .form-grid { grid-template-columns: 1fr; }
    }
</style>

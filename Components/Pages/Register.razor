@page "/register"
@using LodgeStay.Models
@using LodgeStay.Services
@inject AuthService AuthService
@inject NavigationManager Navigation

<div class="auth-root">
    <div class="auth-card glass-panel">
        <div class="auth-visual alt-theme">
            <div class="visual-content">
                <div class="brand-logotype">🏨 LodgeStay<span>.</span></div>
                <h1>Join the Network</h1>
                <p>Register your administrative profile to start managing your lodge operations today.</p>
                
                <div class="visual-feature-list">
                    <div class="v-feat">✓ Real-time Analytics</div>
                    <div class="v-feat">✓ Secure Guest Database</div>
                    <div class="v-feat">✓ Eco-Framework Ready</div>
                </div>
            </div>
            <div class="visual-blob"></div>
        </div>
        
        <div class="auth-form-side">
            <div class="form-header">
                <h2>Create Account</h2>
                <p>Administrative Registration</p>
            </div>

            <div class="form-body">
                <div class="form-grid">
                    <div class="input-group">
                        <label>Full Name</label>
                        <div class="input-wrapper">
                            <span class="prefix">👤</span>
                            <input type="text" @bind="name" placeholder="John Doe" />
                        </div>
                    </div>

                    <div class="input-group">
                        <label>Phone Number</label>
                        <div class="input-wrapper">
                            <span class="prefix">📞</span>
                            <input type="text" @bind="phone" placeholder="+1..." />
                        </div>
                    </div>
                </div>

                <div class="input-group">
                    <label>Email Address</label>
                    <div class="input-wrapper">
                        <span class="prefix">📧</span>
                        <input type="email" @bind="email" placeholder="name@company.com" />
                    </div>
                </div>

                <div class="input-group">
                    <label>Security Password</label>
                    <div class="input-wrapper">
                        <span class="prefix">🔒</span>
                        <input type="password" @bind="password" placeholder="Min 8 characters" />
                    </div>
                </div>

                <!-- IMPROVED ROLE SELECTION -->
                <div class="input-group">
                    <label>Select Your Role</label>
                    <div class="role-cards">
                        <div class="role-card @(role == "Staff" ? "active" : "")" @onclick='() => role = "Staff"'>
                            <div class="role-icon">👷</div>
                            <div class="role-info">
                                <span class="role-name">Staff</span>
                                <span class="role-desc">Operations</span>
                            </div>
                        </div>
                        <div class="role-card @(role == "Manager" ? "active" : "")" @onclick='() => role = "Manager"'>
                            <div class="role-icon">👔</div>
                            <div class="role-info">
                                <span class="role-name">Manager</span>
                                <span class="role-desc">Admin</span>
                            </div>
                        </div>
                        <div class="role-card @(role == "Owner" ? "active" : "")" @onclick='() => role = "Owner"'>
                            <div class="role-icon">👑</div>
                            <div class="role-info">
                                <span class="role-name">Owner</span>
                                <span class="role-desc">Full Control</span>
                            </div>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="auth-msg error">
                        <span class="icon">⚠️</span> @errorMessage
                    </div>
                }
                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="auth-msg success">
                        <span class="icon">✅</span> @successMessage
                    </div>
                }

                <button class="btn-auth secondary" @onclick="HandleRegister">
                    <span>Complete Registration</span>
                </button>

                <div class="auth-footer">
                    <p>Already have an account? <a href="/login">Sign In</a></p>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string name     = "";
    private string email    = "";
    private string phone    = "";
    private string password = "";
    private string role     = "Staff";
    private string errorMessage  = "";
    private string successMessage = "";

    private async Task HandleRegister()
    {
        errorMessage = "";
        successMessage = "";

        if (string.IsNullOrWhiteSpace(name) || string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "All fields are required.";
            return;
        }
        if (password.Length < 8)
        {
            errorMessage = "Password security requires at least 8 characters.";
            return;
        }

        var user = new User
        {
            Name       = name,
            Email      = email,
            PhoneNo    = phone,
            PasswordHash = password,
            Role       = role,
            IsVerified = true
        };

        bool success = await AuthService.SignupAsync(user);

        if (!success)
        {
            errorMessage = "This email is already registered in our system.";
            return;
        }

        successMessage = "Profile secured! Redirecting to secure login...";
        await Task.Delay(1500);
        Navigation.NavigateTo("/login");
    }
}

<style>
    .auth-root { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 2rem; }
    .auth-card { 
        width: 100%; max-width: 900px; display: grid; grid-template-columns: 1fr 1.2fr; overflow: hidden; padding: 0 !important; 
        border: 1px solid rgba(255,255,255,0.1) !important;
    }

    /* Visual Side */
    .auth-visual { 
        background: linear-gradient(135deg, var(--accent-purple), #6b21a8); 
        padding: 3rem; position: relative; overflow: hidden; 
        display: flex; flex-direction: column; justify-content: center;
    }
    .auth-visual.alt-theme { background: linear-gradient(135deg, #03dac6, #018786); }
    
    .visual-content { position: relative; z-index: 2; }
    .brand-logotype { font-size: 1.5rem; font-weight: 900; color: #000; margin-bottom: 2rem; }
    .brand-logotype span { color: #fff; }
    .auth-visual h1 { color: #000 !important; font-size: 3rem; font-weight: 900; line-height: 1; margin-bottom: 1rem; }
    .auth-visual p { color: rgba(0,0,0,0.7); font-size: 1.1rem; line-height: 1.5; margin-bottom: 2rem; }
    
    .visual-feature-list { display: flex; flex-direction: column; gap: 0.8rem; }
    .v-feat { color: rgba(0,0,0,0.8); font-weight: 700; font-size: 0.9rem; }

    .visual-blob { 
        position: absolute; top: -10%; right: -10%; width: 300px; height: 300px; 
        background: rgba(255,255,255,0.1); border-radius: 50%; filter: blur(50px); 
    }

    /* Form Side */
    .auth-form-side { padding: 3rem 4rem; background: #13181f; }
    .form-header { margin-bottom: 2rem; }
    .form-header h2 { font-size: 2rem; font-weight: 800; color: #fff !important; margin: 0; }
    .form-header p { color: #64748b; font-size: 0.9rem; margin: 0.5rem 0 0 0; }

    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }

    .input-group { margin-bottom: 1.2rem; }
    .input-group label { display: block; font-size: 0.7rem; font-weight: 800; color: #475569 !important; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 0.5rem; }
    .input-wrapper { position: relative; display: flex; align-items: center; }
    .prefix { position: absolute; left: 1rem; color: #475569; font-weight: bold; }
    
    .input-wrapper input { 
        width: 100%; padding: 0.8rem 1rem 0.8rem 2.8rem; background: rgba(255,255,255,0.03); 
        border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; color: #fff; font-size: 0.95rem; transition: all 0.2s; 
    }
    .input-wrapper input:focus { outline: none; border-color: #03dac6; background: rgba(3, 218, 198, 0.05); }

    /* Role Cards */
    .role-cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.8rem; }
    .role-card { 
        background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; 
        padding: 1rem; cursor: pointer; transition: all 0.3s ease; text-align: center;
    }
    .role-card:hover { background: rgba(255,255,255,0.05); border-color: rgba(255,255,255,0.2); }
    .role-card.active { background: rgba(3, 218, 198, 0.1); border-color: #03dac6; box-shadow: 0 0 15px rgba(3, 218, 198, 0.2); }
    
    .role-icon { font-size: 1.5rem; margin-bottom: 0.5rem; }
    .role-info { display: flex; flex-direction: column; }
    .role-name { font-size: 0.85rem; font-weight: 800; color: #fff; }
    .role-desc { font-size: 0.7rem; color: #64748b; }
    .role-card.active .role-name { color: #03dac6; }

    .auth-msg { padding: 1rem; border-radius: 12px; margin-bottom: 1.5rem; font-size: 0.85rem; font-weight: 600; display: flex; gap: 0.8rem; }
    .error { background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.2); color: #ef4444; }
    .success { background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.2); color: #10b981; }

    .btn-auth { 
        width: 100%; padding: 1.1rem; background: #03dac6; color: #000; 
        border: none; border-radius: 12px; font-weight: 800; font-size: 1rem; cursor: pointer; transition: all 0.3s; 
    }
    .btn-auth:hover { transform: scale(1.02); box-shadow: 0 0 30px rgba(3, 218, 198, 0.4); }

    .auth-footer { margin-top: 1.5rem; text-align: center; }
    .auth-footer p { color: #64748b; font-size: 0.9rem; }
    .auth-footer a { color: #03dac6; font-weight: 700; text-decoration: none; }
    .auth-footer a:hover { text-decoration: underline; }

    @@media (max-width: 900px) {
        .auth-card { grid-template-columns: 1fr; }
        .auth-visual { display: none; }
        .auth-form-side { padding: 2rem; }
        .form-grid { grid-template-columns: 1fr; }
    }
</style>

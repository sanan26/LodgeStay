@page "/group-booking"
@using LodgeStay.Models
@using LodgeStay.Services
@using LodgeStay.Components.Layout
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject GroupBookingService GroupBookingService
@inject ReservationService ReservationService

<div class="group-booking-container">
    <div class="booking-layout">
        <!-- LEFT COLUMN: Form & Rooms -->
        <div class="left-col">
            <div class="glass-panel form-section">
                <h3 class="section-title">1. Group Information</h3>
                <div class="form-grid">
                    <div class="form-group">
                        <label>Group Name / Organizer *</label>
                        <input type="text" @bind="groupName" placeholder="e.g., Khan Family Reunion" />
                    </div>
                    <div class="form-group">
                        <label>Organizer Email *</label>
                        <input type="email" @bind="organizerEmail" placeholder="organizer@example.com" />
                    </div>
                    <div class="form-group">
                        <label>Check-in Date</label>
                        <input type="date" @bind="checkIn" @bind:format="yyyy-MM-dd" />
                    </div>
                    <div class="form-group">
                        <label>Check-out Date</label>
                        <input type="date" @bind="checkOut" @bind:format="yyyy-MM-dd" />
                    </div>
                </div>
            </div>

            <div class="glass-panel form-section">
                <div class="rooms-header">
                    <h3 class="section-title">2. Select Rooms</h3>
                    <span class="selected-count">@selectedRoomIds.Count selected</span>
                </div>
                
                @if (selectedRoomIds.Count >= 2)
                {
                    <div class="discount-banner active">
                        <div class="banner-icon">🎉</div>
                        <div class="banner-text">
                            <strong>Group discount applied!</strong>
                            <span>You unlocked @discountPercent% off your total stay.</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="discount-banner pending">
                        <div class="banner-icon">💡</div>
                        <div class="banner-text">
                            <strong>Want a discount?</strong>
                            <span>Select @(2 - selectedRoomIds.Count) more room(s) to unlock group rates.</span>
                        </div>
                    </div>
                }

                <div class="rooms-grid">
                    @foreach (var room in availableRooms)
                    {
                        var isSelected = selectedRoomIds.Contains(room.Room_ID);
                        <div class="room-card @(isSelected ? "selected" : "")"
                             @onclick="() => ToggleRoom(room.Room_ID)">
                            <div class="room-card-content">
                                <div class="room-header">
                                    <span class="room-no">Room @room.RoomNo</span>
                                    <span class="room-type">@room.Room_Type</span>
                                </div>
                                <div class="room-details">
                                    <span>👥 Max @room.Capacity</span>
                                    <span class="room-price">Rs. @room.Price<small>/nt</small></span>
                                </div>
                            </div>
                            <div class="check-circle">
                                @if (isSelected)
                                {
                                    <span>✓</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN: Summary -->
        <div class="right-col">
            <div class="summary-panel glass-panel">
                <h3 class="section-title">Booking Summary</h3>
                
                <div class="summary-details">
                    <div class="summary-row">
                        <span class="label">Total Nights:</span>
                        <span class="value">@totalNights</span>
                    </div>
                    <div class="summary-row">
                        <span class="label">Rooms Selected:</span>
                        <span class="value">@selectedRoomIds.Count</span>
                    </div>
                    
                    <div class="divider"></div>
                    
                    <div class="summary-row">
                        <span class="label">Subtotal:</span>
                        <span class="value">Rs. @subtotal.ToString("N0")</span>
                    </div>
                    <div class="summary-row discount-row">
                        <span class="label">Group Discount (@discountPercent%):</span>
                        <span class="value">- Rs. @discountAmount.ToString("N0")</span>
                    </div>
                    
                    <div class="divider"></div>
                    
                    <div class="summary-row total-row">
                        <span class="label">Total Payable:</span>
                        <span class="value">Rs. @totalPayable.ToString("N0")</span>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="error-box">⚠️ @errorMessage</div>
                }

                <button class="btn-confirm" @onclick="CreateGroupBooking"
                        disabled="@(selectedRoomIds.Count < 1 || isSaving)">
                    @(isSaving ? "Creating..." : "Confirm Booking →")
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private string groupName = "";
    private string organizerEmail = "";
    private DateTime checkIn = DateTime.Now;
    private DateTime checkOut = DateTime.Now.AddDays(1);
    private List<int> selectedRoomIds = new();
    private string errorMessage = "";
    private bool isSaving = false;

    private List<Room> availableRooms = new()
    {
        new Room { Room_ID = 1, RoomNo = "101", Room_Type = "Single", Capacity = 1, Price = 3000, Status = "Available" },
        new Room { Room_ID = 2, RoomNo = "102", Room_Type = "Double", Capacity = 2, Price = 5000, Status = "Available" },
        new Room { Room_ID = 4, RoomNo = "104", Room_Type = "Family", Capacity = 4, Price = 12000, Status = "Available" },
        new Room { Room_ID = 6, RoomNo = "106", Room_Type = "Single", Capacity = 1, Price = 3500, Status = "Available" },
        new Room { Room_ID = 7, RoomNo = "107", Room_Type = "Double", Capacity = 2, Price = 5500, Status = "Available" },
        new Room { Room_ID = 8, RoomNo = "108", Room_Type = "Suite", Capacity = 3, Price = 9000, Status = "Available" },
    };

    private int totalNights => Math.Max((checkOut - checkIn).Days, 0);

    private double subtotal => selectedRoomIds
        .Select(id => availableRooms.FirstOrDefault(r => r.Room_ID == id))
        .Where(r => r != null)
        .Sum(r => r!.Price * totalNights);

    private int discountPercent => selectedRoomIds.Count >= 5 ? 20 :
                                   selectedRoomIds.Count >= 3 ? 15 :
                                   selectedRoomIds.Count >= 2 ? 10 : 0;

    private double discountAmount => subtotal * discountPercent / 100;
    private double totalPayable => subtotal - discountAmount;

    private void ToggleRoom(int roomId)
    {
        if (selectedRoomIds.Contains(roomId))
            selectedRoomIds.Remove(roomId);
        else
            selectedRoomIds.Add(roomId);
    }

    private async Task CreateGroupBooking()
    {
        if (string.IsNullOrWhiteSpace(groupName) || string.IsNullOrWhiteSpace(organizerEmail))
        {
            errorMessage = "Please fill in group name and organizer email.";
            return;
        }
        if (selectedRoomIds.Count < 1)
        {
            errorMessage = "Please select at least 1 room.";
            return;
        }
        if (checkOut <= checkIn)
        {
            errorMessage = "Check-out must be after check-in.";
            return;
        }

        foreach (var roomId in selectedRoomIds)
        {
            var available = await ReservationService.IsRoomAvailableAsync(
                roomId, checkIn, checkOut);
            if (!available)
            {
                var room = availableRooms.FirstOrDefault(r => r.Room_ID == roomId);
                errorMessage = $"Room {room?.RoomNo} is already booked for these dates. Please deselect it.";
                isSaving = false;
                return;
            }
        }
        isSaving = true;
        errorMessage = "";

        try
        {
            var booking = await GroupBookingService.CreateGroupBookingAsync(
                groupName, organizerEmail, selectedRoomIds, checkIn, checkOut, availableRooms);

            Navigation.NavigateTo($"/group-booking-folio/{booking.MasterReference}" +
                $"?groupName={Uri.EscapeDataString(groupName)}" +
                $"&rooms={selectedRoomIds.Count}" +
                $"&discount={discountPercent}" +
                $"&total={(int)totalPayable}");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }
}

<style>
    .group-booking-container { padding: 2rem; max-width: 1200px; margin: 0 auto; color: #e2e8f0; }
    
    .page-header { margin-bottom: 2rem; }
    .header-left h2 { margin: 0; color: #fff; font-size: 1.8rem; }
    .page-sub { color: #94a3b8; margin: 0.2rem 0 0; font-size: 0.95rem; }

    .booking-layout { display: grid; grid-template-columns: 1fr 350px; gap: 2rem; align-items: start; }
    
    .glass-panel { background: #13181f; border-radius: 16px; border: 1px solid rgba(255,255,255,0.05); padding: 1.8rem; box-shadow: 0 10px 30px rgba(0,0,0,0.5); }
    .form-section { margin-bottom: 2rem; }
    
    .section-title { color: #fff; font-size: 1.1rem; margin: 0 0 1.5rem; letter-spacing: 0.5px; border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 0.8rem; }
    
    /* Form Grid */
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; }
    .form-group { display: flex; flex-direction: column; gap: 6px; }
    .form-group label { font-size: 0.85rem; color: #94a3b8; font-weight: 600; letter-spacing: 0.5px; }
    input { background: #1e2430; border: 1px solid #334155; color: #fff; padding: 10px 14px; border-radius: 8px; font-size: 0.95rem; transition: border-color 0.2s; width: 100%; box-sizing: border-box; }
    input:focus { outline: none; border-color: var(--accent-purple); box-shadow: 0 0 0 2px rgba(187, 134, 252, 0.2); }
    input[type="date"]::-webkit-calendar-picker-indicator { filter: invert(1); opacity: 0.6; cursor: pointer; }

    /* Rooms Header & Banners */
    .rooms-header { display: flex; justify-content: space-between; align-items: baseline; }
    .selected-count { background: rgba(187, 134, 252, 0.15); color: var(--accent-purple); padding: 4px 10px; border-radius: 12px; font-size: 0.8rem; font-weight: 600; }

    .discount-banner { display: flex; align-items: center; gap: 1rem; padding: 1rem; border-radius: 12px; margin-bottom: 1.5rem; }
    .banner-icon { font-size: 1.8rem; }
    .banner-text { display: flex; flex-direction: column; gap: 2px; }
    .banner-text strong { font-size: 0.95rem; }
    .banner-text span { font-size: 0.85rem; opacity: 0.9; }
    
    .discount-banner.active { background: rgba(167, 139, 250, 0.15); border: 1px solid rgba(167, 139, 250, 0.3); color: #c4b5fd; }
    .discount-banner.active strong { color: #a78bfa; }
    
    .discount-banner.pending { background: rgba(148, 163, 184, 0.1); border: 1px solid rgba(148, 163, 184, 0.2); color: #94a3b8; }
    .discount-banner.pending strong { color: #cbd5e1; }

    /* Rooms Grid */
    .rooms-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1rem; }
    
    .room-card { display: flex; align-items: center; justify-content: space-between; padding: 1.2rem; border-radius: 12px; border: 1px solid rgba(255,255,255,0.1); background: rgba(255,255,255,0.02); cursor: pointer; transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1); }
    .room-card:hover { background: rgba(255,255,255,0.05); transform: translateY(-2px); }
    
    .room-card.selected { border-color: var(--accent-purple); background: rgba(187, 134, 252, 0.08); box-shadow: 0 4px 15px rgba(187, 134, 252, 0.15); }
    
    .room-card-content { display: flex; flex-direction: column; gap: 8px; flex: 1; }
    .room-header { display: flex; flex-direction: column; }
    .room-no { font-weight: 700; color: #fff; font-size: 1.1rem; }
    .room-type { color: #94a3b8; font-size: 0.85rem; }
    
    .room-details { display: flex; justify-content: space-between; align-items: baseline; margin-top: 4px; font-size: 0.85rem; color: #cbd5e1; }
    .room-price { font-weight: 600; color: #fff; }
    .room-price small { color: #64748b; font-weight: normal; }

    .check-circle { width: 24px; height: 24px; border-radius: 50%; border: 2px solid rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center; margin-left: 1rem; transition: all 0.2s; }
    .room-card.selected .check-circle { border-color: var(--accent-purple); background: var(--accent-purple); color: #fff; font-size: 0.85rem; font-weight: bold; }

    /* Summary Panel */
    .summary-panel { position: sticky; top: 2rem; }
    .summary-details { display: flex; flex-direction: column; gap: 1rem; margin-bottom: 2rem; }
    
    .summary-row { display: flex; justify-content: space-between; align-items: baseline; font-size: 0.95rem; }
    .summary-row .label { color: #94a3b8; }
    .summary-row .value { color: #fff; font-weight: 600; }
    
    .divider { height: 1px; background: rgba(255,255,255,0.05); margin: 0.5rem 0; }
    
    .discount-row .label, .discount-row .value { color: #a78bfa; font-weight: 600; }
    
    .total-row { padding-top: 0.5rem; }
    .total-row .label { color: #fff; font-weight: 700; font-size: 1.1rem; }
    .total-row .value { color: var(--accent-purple); font-weight: 800; font-size: 1.4rem; }

    .error-box { background: rgba(239, 68, 68, 0.1); color: #ef4444; padding: 12px; border-radius: 8px; margin-bottom: 1.5rem; font-size: 0.9rem; border: 1px solid rgba(239, 68, 68, 0.2); }

    .btn-confirm { width: 100%; padding: 16px; background: rgba(187, 134, 252, 0.15); color: var(--accent-purple); border: 1px solid rgba(187, 134, 252, 0.3); border-radius: 12px; font-size: 1.05rem; font-weight: 700; cursor: pointer; transition: all 0.2s; text-transform: uppercase; letter-spacing: 1px; }
    .btn-confirm:hover:not(:disabled) { background: rgba(187, 134, 252, 0.25); box-shadow: 0 0 20px rgba(187, 134, 252, 0.2); transform: translateY(-2px); }
    .btn-confirm:disabled { background: rgba(255,255,255,0.05); color: #64748b; border-color: transparent; cursor: not-allowed; }

    @@media (max-width: 900px) {
        .booking-layout { grid-template-columns: 1fr; }
        .summary-panel { position: static; }
    }
    @@media (max-width: 600px) {
        .form-grid { grid-template-columns: 1fr; }
    }
</style>

@page "/group-booking-folio/{MasterReference}"
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<div class="folio-root">
    <div class="glass-panel folio-card">
        <div class="folio-header">
            <div class="success-glow">✨</div>
            <h2 class="folio-title">Group Booking Confirmed</h2>
            <div class="master-ref">
                <span>Master Reference</span>
                <strong>@MasterReference</strong>
            </div>
        </div>

        <div class="folio-body">
            <div class="inner-glass details-section">
                <div class="detail-row">
                    <span class="lbl">Group Name</span>
                    <span class="val">@GroupName</span>
                </div>
                <div class="detail-row">
                    <span class="lbl">Room Inventory</span>
                    <span class="val">@RoomCount Suites/Rooms</span>
                </div>
                <div class="divider"></div>
                <div class="detail-row discount">
                    <span class="lbl">Applied Discount</span>
                    <span class="val highlight">@DiscountPercent% Preferred Rate</span>
                </div>
                <div class="detail-row total">
                    <span class="lbl">Grand Total</span>
                    <span class="val price">Rs. @TotalAmount.ToString("N0")</span>
                </div>
            </div>

            <div class="inner-glass share-panel">
                <p class="share-info">Send digital receipt to group coordinator:</p>
                <button class="btn-share" @onclick="ShareConfirmation">
                    <span class="icon">💬</span> Share via WhatsApp
                </button>
            </div>
        </div>

        <div class="folio-footer">
            <button class="btn-nav" @onclick="GoHome">🏠 Dashboard</button>
            <button class="btn-nav btn-primary" @onclick="GoToReservations">📋 All Reservations</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public string MasterReference { get; set; } = "";
    [SupplyParameterFromQuery] public string? groupName { get; set; }
    [SupplyParameterFromQuery] public int rooms { get; set; }
    [SupplyParameterFromQuery] public int discount { get; set; }
    [SupplyParameterFromQuery] public int total { get; set; }

    private string GroupName => groupName ?? "Group";
    private int RoomCount => rooms;
    private int DiscountPercent => discount;
    private int TotalAmount => total;

    private void GoHome() => Navigation.NavigateTo("/staff-dashboard");
    private void GoToReservations() => Navigation.NavigateTo("/reservations");

    private async Task ShareConfirmation()
    {
        var message = $"🏨 LodgeStay Group Booking Confirmed!\n\n" +
                      $"Reference: {MasterReference}\n" +
                      $"Group: {GroupName}\n" +
                      $"Rooms: {RoomCount}\n" +
                      $"Discount: {DiscountPercent}%\n" +
                      $"Total: Rs. {TotalAmount}\n\n" +
                      $"Thank you for choosing LodgeStay!";
        await JSRuntime.InvokeVoidAsync("alert", "Message Copied:\n\n" + message);
    }
}

<style>
    .folio-root { 
        min-height: 100vh; 
        display: flex; 
        justify-content: center; 
        align-items: center; 
        padding: 2rem;
        background: radial-gradient(circle at top right, rgba(187, 134, 252, 0.1), transparent 40%),
                    radial-gradient(circle at bottom left, rgba(3, 218, 198, 0.1), transparent 40%);
    }

    .folio-card { 
        width: 100%; 
        max-width: 550px; 
        padding: 3rem; 
        border-radius: 24px; 
        text-align: center;
        border: 1px solid rgba(255,255,255,0.1) !important;
        box-shadow: 0 20px 50px rgba(0,0,0,0.5) !important;
    }

    .success-glow { 
        font-size: 4rem; 
        margin-bottom: 1rem; 
        filter: drop-shadow(0 0 15px var(--accent-purple));
    }

    .folio-title { 
        font-size: 2rem; 
        font-weight: 800; 
        color: #fff; 
        margin-bottom: 1.5rem; 
        background: linear-gradient(to right, #fff, var(--accent-purple));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .master-ref { 
        display: flex; 
        flex-direction: column; 
        gap: 4px; 
        margin-bottom: 2.5rem; 
    }
    .master-ref span { font-size: 0.8rem; color: #94a3b8; text-transform: uppercase; letter-spacing: 2px; }
    .master-ref strong { font-size: 1.4rem; color: #fff; font-family: 'JetBrains Mono', monospace; background: rgba(255,255,255,0.05); padding: 6px 16px; border-radius: 8px; }

    .folio-body { display: flex; flex-direction: column; gap: 1.5rem; text-align: left; }
    
    .inner-glass { 
        background: rgba(0,0,0,0.2); 
        border: 1px solid rgba(255,255,255,0.05); 
        border-radius: 16px; 
        padding: 1.5rem; 
    }

    .detail-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; }
    .lbl { color: #94a3b8; font-size: 0.9rem; }
    .val { color: #fff; font-weight: 600; }
    
    .divider { height: 1px; background: rgba(255,255,255,0.1); margin: 1rem 0; border-style: dashed; }
    
    .highlight { color: #03dac6; }
    .price { font-size: 1.5rem; font-weight: 800; color: #fff; }

    .share-info { font-size: 0.85rem; color: #94a3b8; margin-bottom: 1rem; }
    .btn-share { 
        width: 100%; 
        padding: 1rem; 
        background: #25d366; 
        color: #000; 
        border: none; 
        border-radius: 12px; 
        font-weight: 700; 
        font-size: 1rem; 
        cursor: pointer; 
        transition: all 0.2s; 
        display: flex; 
        justify-content: center; 
        align-items: center; 
        gap: 8px;
    }
    .btn-share:hover { background: #128c7e; transform: scale(1.02); }

    .folio-footer { display: flex; gap: 1rem; margin-top: 2rem; }
    .btn-nav { 
        flex: 1; 
        padding: 1rem; 
        border-radius: 12px; 
        background: rgba(255,255,255,0.05); 
        border: 1px solid rgba(255,255,255,0.1); 
        color: #fff; 
        font-weight: 600; 
        cursor: pointer; 
        transition: all 0.2s; 
    }
    .btn-primary { 
        background: var(--accent-purple); 
        color: #000; 
        border: none; 
    }
    .btn-nav:hover { transform: translateY(-2px); background: rgba(255,255,255,0.1); }
    .btn-primary:hover { background: #9d4edd; box-shadow: 0 0 20px rgba(187, 134, 252, 0.4); }
</style>

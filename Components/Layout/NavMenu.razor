@using LodgeStay.Services
@inject NavigationManager Navigation
@inject SessionService SessionService

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">🏨 LodgeStay</a>
    </div>
</div>

<div class="nav-scrollable">
    <nav class="nav flex-column">

        @if (SessionService.IsloggedIn)
        {
            <!-- Operations — all logged-in users -->
            <div class="nav-section-label">Operations</div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="room-finder">🔍 Room Finder</NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="reservations">📋 Reservations</NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="guest-profiles">👥 Guest Profiles</NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="group-booking">👨‍👩‍👧‍👦 Group Booking</NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="ecostay">🌿 EcoStay</NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="concierge">💬 Concierge</NavLink>
            </div>
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="notifications/settings">🔔 Notifications</NavLink>
            </div>

            <!-- Management — Manager + Owner only -->
            @if (SessionService.IsManager || SessionService.IsOwner)
            {
                <div class="nav-section-label">Management</div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="loyalty-points">⭐ Loyalty Points</NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="dashboard">📊 Dashboard</NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="reports">📈 Reports</NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="localdeals">🏷️ Local Deals</NavLink>
                </div>
            }

            <!-- Owner only -->
            @if (SessionService.IsOwner)
            {
                <div class="nav-section-label">Owner</div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="owner-dashboard">👑 Owner Dashboard</NavLink>
                </div>
            }

            <div class="nav-item px-3 mt-2">
                <button class="nav-link logout-btn" @onclick="Logout">🚪 Logout</button>
            </div>
        }
        else
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="login">🔐 Login</NavLink>
            </div>
        }

    </nav>
</div>

@implements IDisposable

@code {
    protected override void OnInitialized()
    {
        SessionService.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        SessionService.OnChange -= StateHasChanged;
    }

    private void Logout()
    {
        SessionService.Logout();
        Navigation.NavigateTo("/login");
    }
}

<style>
    .nav-section-label {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: rgba(255,255,255,0.4);
        padding: 1rem 1.5rem 0.25rem;
        margin-top: 0.25rem;
    }

    .logout-btn {
        background: none;
        border: none;
        color: #d7d7d7;
        cursor: pointer;
        width: 100%;
        text-align: left;
        padding: 0 1rem;
        font-size: 0.9rem;
        height: 3rem;
        display: flex;
        align-items: center;
        border-radius: 4px;
    }

    .logout-btn:hover {
        background-color: rgba(255,255,255,0.1);
        color: white;
    }
</style>

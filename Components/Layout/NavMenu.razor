@using LodgeStay.Services
@inject NavigationManager Navigation
@inject SessionService SessionService
@inject IJSRuntime JSRuntime

<div class="nav-links-container">
    <NavLink class="pill-link" href="@GetDashboardPath()" Match="NavLinkMatch.All">
        <span class="text">DASH</span>
    </NavLink>
    <NavLink class="pill-link" href="room-finder">
        <span class="text">ROOMS</span>
    </NavLink>
    <NavLink class="pill-link" href="reservations">
        <span class="text">BOOKS</span>
    </NavLink>
    <NavLink class="pill-link" href="guest-profiles">
        <span class="text">GUESTS</span>
    </NavLink>
    <NavLink class="pill-link" href="group-booking">
        <span class="text">GROUPS</span>
    </NavLink>
    <NavLink class="pill-link" href="ecostay">
        <span class="text">ECO</span>
    </NavLink>
    <NavLink class="pill-link" href="concierge">
        <span class="text">CHAT</span>
    </NavLink>
    
    @if (SessionService.IsManager || SessionService.IsOwner)
    {
        <div class="nav-divider"></div>
        <NavLink class="pill-link" href="loyalty-points">
            <span class="text">STAR</span>
        </NavLink>
        <NavLink class="pill-link" href="reports">
            <span class="text">REPS</span>
        </NavLink>
        <NavLink class="pill-link" href="localdeals">
            <span class="text">DEALS</span>
        </NavLink>
    }

    <div class="nav-divider"></div>
    <button class="pill-link logout-trigger" @onclick="Logout">
        <span class="text">EXIT</span>
    </button>
</div>

@code {
    private string GetDashboardPath()
    {
        var role = SessionService.CurrentUser?.Role;
        return role switch
        {
            "Owner" => "owner-dashboard",
            "Manager" => "manager-dashboard",
            "Staff" => "staff-dashboard",
            _ => "dashboard"
        };
    }

    private void Logout()
    {
        SessionService.Logout();
        Navigation.NavigateTo("/login");
    }
}

<style>
    .nav-links-container { display: flex; align-items: center; gap: 0.4rem; background: rgba(0,0,0,0.2); padding: 5px; border-radius: 16px; border: 1px solid rgba(255,255,255,0.05); }
    
    .pill-link {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 14px;
        border-radius: 12px;
        text-decoration: none;
        color: #94a3b8;
        font-size: 0.8rem;
        font-weight: 600;
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        border: 1px solid transparent;
        background: transparent;
        cursor: pointer;
        white-space: nowrap;
    }

    .pill-link .icon { font-size: 1rem; }
    .pill-link .text { opacity: 0.7; }

    .pill-link:hover {
        background: rgba(255,255,255,0.05);
        color: #fff;
    }

    .pill-link.active {
        background: rgba(187, 134, 252, 0.1);
        color: var(--accent-purple);
        border: 1px solid rgba(187, 134, 252, 0.2);
        box-shadow: 0 4px 12px rgba(187, 134, 252, 0.1);
    }
    
    .pill-link.active .text { opacity: 1; }

    .nav-divider { width: 1px; height: 20px; background: rgba(255,255,255,0.1); margin: 0 4px; }
    
    .logout-trigger { color: #f87171; }
    .logout-trigger:hover { background: rgba(239, 68, 68, 0.1); color: #ef4444; }

    @@media (max-width: 1200px) {
        .pill-link .text { display: none; }
        .pill-link { padding: 8px; }
    }
</style>
